---
# Vault-encrypted secrets for production
# Encrypt with: ansible-vault encrypt group_vars/production/secrets.yml
#
# Secret names referenced by services.yml env.secret entries
# are looked up here at template time.

# Every value below was generated by the same routine as `bin/bay secret`.
# Keep them, or replace them with your own — but never leave one empty:
# `bin/bay validate` fails on an empty secret that a service references.

secrets:
  # Registry credentials (referenced by docker_registries in registry.yml)
  # Add keys here for each registry you configure:
  # GHCR_TOKEN: ""
  # DOCKER_HUB_TOKEN: ""
  # ZOT_ADMIN_PASSWORD: ""  # if using self-hosted Zot registry
{% if "postgres" in selected_services %}

  # PostgreSQL (referenced by services.yml → postgres accessory)
  POSTGRES_PASSWORD: "{{ generated_secrets.POSTGRES_PASSWORD }}"
{% endif %}
{% if "mariadb" in selected_services %}

  # MariaDB (referenced by services.yml → mariadb accessory)
  MARIADB_ROOT_PASSWORD: "{{ generated_secrets.MARIADB_ROOT_PASSWORD }}"
  MARIADB_PASSWORD: "{{ generated_secrets.MARIADB_PASSWORD }}"
{% endif %}
{% if "vaultwarden" in selected_services %}

  # Vaultwarden
  VAULTWARDEN_ADMIN_TOKEN: "{{ generated_secrets.VAULTWARDEN_ADMIN_TOKEN }}"
{% endif %}
{% if "n8n" in selected_services %}

  # n8n
  N8N_DB_POSTGRESDB_PASSWORD: "{{ generated_secrets.N8N_DB_POSTGRESDB_PASSWORD }}"
{% endif %}
{% if "plausible" in selected_services %}

  # Plausible
  PLAUSIBLE_SECRET_KEY_BASE: "{{ generated_secrets.PLAUSIBLE_SECRET_KEY_BASE }}"
  PLAUSIBLE_DB_PASSWORD: "{{ generated_secrets.PLAUSIBLE_DB_PASSWORD }}"
{% endif %}
{% if "umami" in selected_services %}

  # Umami
  UMAMI_APP_SECRET: "{{ generated_secrets.UMAMI_APP_SECRET }}"
  UMAMI_DB_PASSWORD: "{{ generated_secrets.UMAMI_DB_PASSWORD }}"
{% endif %}

  # Telegram alerts (optional). Add the bot token here, then point a
  # recipient at it: bin/bay alerts add --adapter telegram. See docs/alerting.md.
  # TELEGRAM_BOT_TOKEN: ""
{% if multi_region and access_gateway == 'headscale' %}

  # Headscale API key (required for remote regions to register with the control server)
  # 1. Deploy the control region first
  # 2. Generate a key: bin/bay gateway apikey
  # 3. Paste it here and re-encrypt: bin/bay vault encrypt production
  headscale_api_key: ""
{% endif %}

  # Backup credentials (see docs/backups.md)
  # backup_s3_endpoint: "s3.eu-central-1.amazonaws.com"
  # backup_s3_bucket: "my-backup-bucket"
  # backup_s3_access_key_id: "AKIA..."
  # backup_s3_secret_access_key: ""
  # backup_restic_password: ""  # generate with: bin/bay secret
