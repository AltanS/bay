---
{% if selected_services %}
# Central service definitions — the key file that drives everything.
# Schema reference: docs/services.md

{% if multi_region %}
# Multi-region tip: replace hardcoded domains with {{ '{{ domain_base }}' }}
# e.g., domain: "gatus.{{ '{{ domain_base }}' }}"
# Set domain_base per-region in group_vars/<region>/main.yml

{% endif %}
{% set has_services = "gatus" in selected_services or "vaultwarden" in selected_services or "n8n" in selected_services or "plausible" in selected_services or "umami" in selected_services %}
{% if has_services %}
services:
{% if "gatus" in selected_services %}
  gatus:
    access: public
    image: twinproduction/gatus:latest
{% if multi_region %}
    domains:
      - "status.{% raw %}{{ domain_base }}{% endraw %}"
{% else %}
    domains:
      - status.{{ domain_base }}
{% endif %}
    ports:
      internal: 8080
    healthcheck:
      path: /health
      interval: 30s
    env:
      clear:
        GATUS_CONFIG: /config/config.yaml
    config_files:
      - gatus/config.yaml
    volumes:
      - "{{ '{{ stack_dir }}' }}/config/gatus/config.yaml:/config/config.yaml:ro"

{% endif %}
{% if "vaultwarden" in selected_services %}
  vaultwarden:
{% if access_gateway != "none" %}
    access: vpn
{% else %}
    access: public
{% endif %}
    image: vaultwarden/server:latest
{% if multi_region %}
    domains:
      - "vault.{% raw %}{{ domain_base }}{% endraw %}"
{% else %}
    domains:
      - vault.{{ domain_base }}
{% endif %}
    ports:
      internal: 80
    volumes:
      - vw_data:/data
    env:
      clear:
        DOMAIN: "https://vault.{{ domain_base }}"
        SIGNUPS_ALLOWED: "false"
      secret:
        - ADMIN_TOKEN  # vault: VAULTWARDEN_ADMIN_TOKEN

{% endif %}
{% if "n8n" in selected_services %}
  n8n:
{% if access_gateway != "none" %}
    access: vpn
{% else %}
    access: public
{% endif %}
    image: n8nio/n8n:latest
{% if multi_region %}
    domains:
      - "n8n.{% raw %}{{ domain_base }}{% endraw %}"
{% else %}
    domains:
      - n8n.{{ domain_base }}
{% endif %}
    ports:
      internal: 5678
    depends_on:
      - postgres
    volumes:
      - n8n_data:/home/node/.n8n
    env:
      clear:
        N8N_HOST: "n8n.{{ domain_base }}"
        N8N_PROTOCOL: https
        DB_TYPE: postgresdb
        DB_POSTGRESDB_HOST: postgres
        DB_POSTGRESDB_DATABASE: n8n
        DB_POSTGRESDB_USER: n8n
      secret:
        - DB_POSTGRESDB_PASSWORD  # vault: N8N_DB_POSTGRESDB_PASSWORD

{% endif %}
{% if "plausible" in selected_services %}
  plausible:
    access: public
    image: ghcr.io/plausible/community-edition:latest
{% if multi_region %}
    domains:
      - "plausible.{% raw %}{{ domain_base }}{% endraw %}"
{% else %}
    domains:
      - plausible.{{ domain_base }}
{% endif %}
    ports:
      internal: 8000
    depends_on:
      - postgres
    env:
      clear:
        BASE_URL: "https://plausible.{{ domain_base }}"
        DATABASE_URL: "postgres://plausible:{% raw %}{{ secrets.PLAUSIBLE_DB_PASSWORD }}{% endraw %}@postgres:5432/plausible"
      secret:
        - SECRET_KEY_BASE  # vault: PLAUSIBLE_SECRET_KEY_BASE
        - DB_PASSWORD       # vault: PLAUSIBLE_DB_PASSWORD

{% endif %}
{% if "umami" in selected_services %}
  umami:
    access: public
    image: ghcr.io/umami-software/umami:postgresql-latest
{% if multi_region %}
    domains:
      - "umami.{% raw %}{{ domain_base }}{% endraw %}"
{% else %}
    domains:
      - umami.{{ domain_base }}
{% endif %}
    ports:
      internal: 3000
    depends_on:
      - postgres
    env:
      clear:
        DATABASE_URL: "postgres://umami:{% raw %}{{ secrets.UMAMI_DB_PASSWORD }}{% endraw %}@postgres:5432/umami"
      secret:
        - APP_SECRET   # vault: UMAMI_APP_SECRET
        - DB_PASSWORD  # vault: UMAMI_DB_PASSWORD

{% endif %}
{% else %}
services: {}
{% endif %}

{% if "postgres" in selected_services or "redis" in selected_services or "mariadb" in selected_services %}
accessories:
{% if "postgres" in selected_services %}
  postgres:
    image: postgres:17
    port: "127.0.0.1:5432:5432"
    volumes:
      - pg_data:/var/lib/postgresql/data
    env:
      clear:
        POSTGRES_DB: app
        POSTGRES_USER: app
      secret:
        POSTGRES_PASSWORD: POSTGRES_PASSWORD
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "app"]
      interval: 5s
      retries: 5
    backup:
      method: pg_dump
      schedule: "0 3 * * *"
      retain: 7
{% endif %}

{% if "redis" in selected_services %}
  redis:
    image: redis:7-alpine
    port: "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
{% endif %}

{% if "mariadb" in selected_services %}
  mariadb:
    image: mariadb:11
    port: "127.0.0.1:3306:3306"
    volumes:
      - mariadb_data:/var/lib/mysql
    env:
      clear:
        MARIADB_DATABASE: app
        MARIADB_USER: app
      secret:
        MARIADB_ROOT_PASSWORD: MARIADB_ROOT_PASSWORD
        MARIADB_PASSWORD: MARIADB_PASSWORD
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      retries: 5
    backup:
      method: mysqldump
      schedule: "0 3 * * *"
      retain: 7
{% endif %}
{% else %}
accessories: {}
{% endif %}
{% else %}
# Service definitions
# See docs/services.md for the full schema reference
#
# services:
#   myapp:
#     image: myapp:latest
#     access: public                    # or "vpn"
#     domains: [myapp.example.com]
#     ports:
#       internal: 3000
#
# accessories:
#   postgres:
#     image: postgres:17
#     backup: true

services: {}

accessories: {}
{% endif %}
