{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AltanS/bay/schemas/bay_fleet.schema.json",
  "title": "bay.fleet.toml",
  "description": "The fleet file. The operator edits it by hand; `bay compile` reads it together with every pinned bay.toml. Unknown keys fail everywhere. x-messages maps a failing keyword to a plain message (read by bay_cli/fleet.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "default_box", "default_domain", "boxes"],
  "properties": {
    "name": { "$ref": "#/$defs/name" },
    "format": {
      "description": "The fleet layout. 2 = one folder per project (projects/<name>/bay.lock). No key = 1. A CLI refuses a format newer than it knows.",
      "type": "integer",
      "minimum": 1,
      "x-messages": { "type": "must be a whole number such as 2", "minimum": "must be 1 or more" }
    },
    "default_box": { "$ref": "#/$defs/name" },
    "default_domain": { "$ref": "#/$defs/domain" },
    "primary_env": { "$ref": "#/$defs/env_name" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build_strategy": { "type": "string", "enum": ["local", "remote", "registry"] },
        "build_memory": { "$ref": "#/$defs/size" },
        "registry": {
          "type": "string",
          "pattern": "^[^\\s/]+(/[^\\s/]+)*$",
          "x-messages": { "pattern": "must be an image prefix without spaces, such as registry.example.com/team" }
        },
        "logs": {
          "type": "string",
          "pattern": "^(off|[1-9][0-9]*[hdw])$",
          "x-messages": { "pattern": "must be off or a duration such as 7d (units h, d, w)" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rate": { "$ref": "#/$defs/rate" },
            "burst": { "type": "integer", "minimum": 1 },
            "concurrent": { "type": "integer", "minimum": 1 }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[hdw]$",
              "x-messages": { "pattern": "must be a duration such as 30d (units h, d, w)" }
            },
            "hour": { "type": "integer", "minimum": 0, "maximum": 23 }
          }
        }
      }
    },
    "boxes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/box" },
      "x-messages": { "minProperties": "needs at least one [boxes.<name>] table" }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "tailnet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$",
            "x-messages": { "pattern": "must be an IP address or a CIDR range such as 100.64.0.0/10" }
          }
        },
        "ingress_box": {
          "$ref": "#/$defs/name",
          "description": "The box whose Traefik serves the tailnet routes. Routes need it."
        },
        "cert_domain": {
          "type": "string",
          "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$",
          "description": "The certificate every route sits under, such as *.ts.example.com. Routes need it.",
          "x-messages": { "pattern": "must be a domain or a wildcard such as *.ts.example.com" }
        },
        "routes": {
          "type": "object",
          "description": "Tailnet routes: a name with a trusted certificate for a machine on the tailnet that Bay does not run. Compiled into tailnet_proxies in services.yml.",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/route" }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "secret"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "secret": { "$ref": "#/$defs/var_name" }
      }
    },
    "repo_tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$",
        "x-messages": { "pattern": "must be the start of a repo URL, without spaces" }
      },
      "additionalProperties": { "$ref": "#/$defs/var_name" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "x-messages": { "pattern": "must use only lowercase letters, digits and hyphens, and start with a letter or digit" }
    },
    "env_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "x-messages": { "pattern": "environment names use only lowercase letters and digits, and start with a letter" }
    },
    "var_name": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "x-messages": { "pattern": "secret names use only uppercase letters, digits and underscores" }
    },
    "domain": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$",
      "x-messages": { "pattern": "must be a lowercase domain such as example.com" }
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*[kmg]$",
      "x-messages": { "pattern": "must be a size such as 512m or 2g (units k, m, g)" }
    },
    "rate": {
      "type": "string",
      "pattern": "^[1-9][0-9]*/[sm]$",
      "x-messages": { "pattern": "must be a rate such as 100/s or 600/m" }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": { "$ref": "#/$defs/env_name" },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "x-messages": { "pattern": "must be a group name such as eu (lowercase letters, digits, - and _)" }
        },
        "tailnet_ip": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$",
          "x-messages": { "pattern": "must be an IPv4 address such as 100.64.0.3" }
        },
        "webhook_domain": {
          "$ref": "#/$defs/domain",
          "description": "The deploy webhook domain of this box. It replaces [webhook] domain. The box needs a group."
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "upstream"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "upstream": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "description": "A tailnet MagicDNS name or tailnet address, with the port: http://laptop.example.tailnet.internal:8080.",
          "x-messages": { "pattern": "must be a URL such as http://laptop:8080" }
        },
        "host": {
          "type": "string",
          "enum": ["client", "upstream"],
          "description": "The Host the upstream receives: the client's name (default) or the upstream's own name (for a backend behind tailscale serve)."
        },
        "identity": {
          "type": "boolean",
          "description": "Inject X-Tailnet-Device, the caller's device name."
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domain" },
          "description": "More names for the same route. They are served like domain."
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "x-messages": { "pattern": "must be a Traefik entrypoint name such as websecure_tailnet" }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "kind": { "type": "string", "enum": ["postgres", "redis", "container"] },
        "box": {
          "oneOf": [
            { "$ref": "#/$defs/name" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
          ],
          "x-messages": { "oneOf": "must be a box name or a list of box names" }
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s]+$",
          "x-messages": { "pattern": "must be an image reference without spaces" }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "expose": { "type": "string", "enum": ["loopback", "tailnet"] },
        "command": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "memory": { "$ref": "#/$defs/size" },
        "update": { "type": "string", "enum": ["notify", "auto", "off"] },
        "network_mode": { "type": "string", "enum": ["host"] },
        "volumes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "x-messages": { "pattern": "variable names use only letters, digits and underscores" }
          },
          "additionalProperties": {
            "type": "string",
            "x-messages": { "type": "must be a string; put quotes around the value" }
          }
        },
        "secrets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "x-messages": { "pattern": "variable names use only letters, digits and underscores" }
          },
          "additionalProperties": { "$ref": "#/$defs/var_name" }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test"],
          "properties": {
            "test": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "interval": { "type": "string" },
            "timeout": { "type": "string" },
            "retries": { "type": "integer", "minimum": 0 },
            "start_period": { "type": "string" }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": { "type": "string", "enum": ["pg_dump", "mysql", "redis", "file"] },
            "schedule": {
              "type": "string",
              "pattern": "^\\S+( \\S+){4}$",
              "x-messages": { "pattern": "must be a five-field cron line such as \"0 3 * * *\"" }
            },
            "retain": { "type": "integer", "minimum": 1 },
            "source_path": { "type": "string", "pattern": "^/" }
          }
        },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "files_mode": { "type": "string", "enum": ["private", "public"] }
      }
    }
  }
}
