{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AltanS/bay/schemas/bay_lock.schema.json",
  "title": "projects/<name>/bay.lock",
  "description": "The per-project lockfile in the fleet repo. The CLI owns it: it pins the repo commit, the box per environment and the adopted data names. Version 2: no path on this machine (a version 1 lock is read as version 2 with local_path dropped).",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "name", "envs"],
  "properties": {
    "lock_version": { "const": 2 },
    "name": { "$ref": "#/$defs/name" },
    "repo": { "type": ["string", "null"], "minLength": 1 },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "toml_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "envs": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/env" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "commit_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
    "sha256_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "previous": {
      "description": "The pin this environment had before the last `bay up`: one level, enough for `bay rollback`. force_reason is set when `bay up --force --reason` replaced it without an approval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "deployed_at": { "type": ["string", "null"] },
        "receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "force_reason": { "type": "string", "minLength": 1 }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "box": { "$ref": "#/$defs/name" },
        "commit": { "$ref": "#/$defs/commit_or_null" },
        "deployed_at": { "type": ["string", "null"] },
        "result": { "type": "string", "enum": ["pending", "ok", "failed"] },
        "plan_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{12}$" },
        "last_receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "previous": { "$ref": "#/$defs/previous" },
        "adopted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_fleet_commit": {
              "description": "Set by bay adopt: the fleet commit the project was read from before it moved to its own repo.",
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "role": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "volumes": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
            },
            "containers": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" }
            },
            "images": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[^\\s]+$" }
            },
            "files": {
              "type": "object",
              "propertyNames": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$" },
              "additionalProperties": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\s{}]+$" }
            }
          }
        }
      }
    }
  }
}
