{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AltanS/bay/schemas/bay_lock.schema.json",
  "title": "projects/<name>/bay.lock",
  "description": "The per-project lockfile in the fleet repo. The CLI owns it: it pins the repo commit, the box per environment and the adopted data names. Version 2: no path on this machine (a version 1 lock is read as version 2 with local_path dropped).",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "name", "envs"],
  "properties": {
    "lock_version": { "const": 2 },
    "name": { "$ref": "#/$defs/name" },
    "repo": { "type": ["string", "null"], "minLength": 1 },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "toml_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "envs": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/env" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "commit_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
    "sha256_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "previous": {
      "description": "The pin this environment had before the last `bay up`: one level, enough for `bay rollback`. force_reason is set when `bay up --force --reason` replaced it without an approval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "deployed_at": { "type": ["string", "null"] },
        "receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "plan_id": {
          "description": "The plan that deployed this pin. plans/ prune keeps the plan a lock names.",
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "force_reason": { "type": "string", "minLength": 1 },
        "containers": {
          "description": "Since 2.2.0: the code each build container of the project ran before the bay up that set this previous, from the receipt the plan read. Plain bay rollback takes its code target from it. commit null: the receipt named none, so a rollback keeps that container's image. Absent in a lock written before 2.2.0 (bay rollback then falls back to the box's <env>.prev.json).",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "image"],
            "properties": {
              "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
              "image": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "box": { "$ref": "#/$defs/name" },
        "commit": { "$ref": "#/$defs/commit_or_null" },
        "deployed_at": { "type": ["string", "null"] },
        "result": { "type": "string", "enum": ["pending", "ok", "failed"] },
        "plan_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{12}$" },
        "last_receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "previous": { "$ref": "#/$defs/previous" },
        "frozen": {
          "description": "Set by `bay rollback`. While true, a push builds and tags its image but never deploys it, whatever `track` says. The next `bay up` to a commit newer than frozen_commit clears it.",
          "type": "boolean"
        },
        "frozen_commit": { "$ref": "#/$defs/commit_or_null" },
        "adopted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_fleet_commit": {
              "description": "Set by bay adopt: the fleet commit the project was read from before it moved to its own repo.",
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "app_commit": {
              "description": "Set by bay adopt: the app repo commit that added the bay.toml. bay up accepts it before it is pushed and moves no code for it.",
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "role": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "volumes": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" }
            },
            "containers": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" }
            },
            "images": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[^\\s]+$" }
            },
            "files": {
              "type": "object",
              "propertyNames": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$" },
              "additionalProperties": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\s{}]+$" }
            }
          }
        }
      }
    }
  }
}
