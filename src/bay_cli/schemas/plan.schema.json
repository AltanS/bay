{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AltanS/bay/schemas/plan.schema.json",
  "title": "bay plan --json",
  "description": "One plan: WANTED (bay.toml at a commit) against PINNED (the fleet lock and services file) and RUNNING (the box receipt). Saved as <fleet>/plans/<plan_id>.json. Version 1. Documented in docs/plan.md. A plan for one project has project set; a whole-environment plan (bay plan <env> in a fleet, no --project) has project null and lists its projects in projects. A new field may appear without a version bump; readers ignore fields they do not know.",
  "type": "object",
  "required": [
    "plan_version", "plan_id", "plan_sha256", "created_at", "project", "env", "box", "box_env",
    "fleet", "wanted", "pinned", "running", "box_checked", "box_prediction",
    "steps", "unsupported",
    "missing_secrets", "blockers", "notes", "verdict", "exit_code", "approval", "stale"
  ],
  "properties": {
    "plan_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string" },
    "project": {
      "description": "The planned project. null for a whole-environment plan: then projects lists every project, and wanted and pinned hold no commit.",
      "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }]
    },
    "projects": {
      "description": "Only in a whole-environment plan: every project with [deploy.<env>], each at its WANTED commit. Empty in a route-only plan (no project, box_env is the box env of the ingress box).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "box", "box_env", "wanted", "pinned"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "box": { "type": ["string", "null"] },
          "box_env": { "type": ["string", "null"] },
          "wanted": { "$ref": "#/$defs/wanted" },
          "pinned": { "$ref": "#/$defs/pinned" }
        }
      }
    },
    "moves": {
      "description": "Only when a project's WANTED box (bay.toml) differs from its PINNED box (the lock). One entry per move; bay up writes the new box into the lock.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project", "env", "from", "to", "from_box_env", "to_box_env", "containers",
          "volumes", "databases", "risk", "data"
        ],
        "properties": {
          "project": { "$ref": "#/$defs/name" },
          "env": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "from_box_env": { "type": ["string", "null"] },
          "to_box_env": { "type": ["string", "null"] },
          "containers": { "type": "array", "items": { "type": "string" } },
          "volumes": {
            "description": "Named volumes that stay on the old box.",
            "type": "array",
            "items": { "type": "string" }
          },
          "databases": {
            "description": "Databases that stay in the old box's resource.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "resource"],
              "properties": { "name": { "type": "string" }, "resource": { "type": "string" } }
            }
          },
          "risk": { "enum": ["shared", "destructive"] },
          "data": { "enum": ["keep", null] }
        }
      }
    },
    "remove": {
      "description": "Only in a bay remove plan: what leaves the fleet, and the data that stays. bay up --plan-id applies it; Bay never deletes the volumes or the databases listed here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project", "scope", "in_fleet", "commit", "envs", "volumes", "databases", "cleanup"
      ],
      "properties": {
        "project": { "$ref": "#/$defs/name" },
        "scope": {
          "description": "project: every environment and the project folder. env: one environment.",
          "enum": ["project", "env"]
        },
        "in_fleet": { "type": "boolean" },
        "commit": {
          "description": "scope env: the commit the lock moves to (its bay.toml has no [deploy.<env>]).",
          "$ref": "#/$defs/commit_or_null"
        },
        "envs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env", "box", "box_env", "containers"],
            "properties": {
              "env": { "type": "string" },
              "box": { "type": ["string", "null"] },
              "box_env": { "type": ["string", "null"] },
              "containers": {
                "description": "Every container name of the project in this env; the receipt must confirm each is gone.",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "volumes": {
          "description": "Named volumes that stay, by their name on the box (<stack>_<volume>).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env", "box", "name"],
            "properties": {
              "env": { "type": "string" },
              "box": { "type": ["string", "null"] },
              "name": { "type": "string" }
            }
          }
        },
        "databases": {
          "description": "Databases and their roles that stay, adopted or derived names.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env", "box", "resource", "name", "role"],
            "properties": {
              "env": { "type": "string" },
              "box": { "type": ["string", "null"] },
              "resource": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "cleanup": {
          "description": "The docker volume rm and DROP DATABASE / DROP ROLE lines, to run by hand.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "env": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "box": { "type": ["string", "null"] },
    "box_env": { "type": ["string", "null"] },
    "fleet": {
      "type": "object",
      "required": ["name", "commit", "dirty", "behind"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "commit": { "$ref": "#/$defs/commit_or_null" },
        "dirty": { "type": ["boolean", "null"] },
        "behind": { "type": ["boolean", "null"] }
      }
    },
    "wanted": { "$ref": "#/$defs/wanted" },
    "pinned": { "$ref": "#/$defs/pinned" },
    "running": {
      "type": "object",
      "required": ["checked", "receipt_sha256", "boxes"],
      "properties": {
        "checked": { "type": "boolean" },
        "receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["box", "error", "containers"],
            "properties": {
              "box": { "type": ["string", "null"] },
              "error": { "type": ["string", "null"] },
              "containers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "image", "config_hash"],
                  "properties": {
                    "name": { "type": "string" },
                    "image": { "type": ["string", "null"] },
                    "config_hash": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "box_checked": { "type": "boolean" },
    "box_prediction": {
      "description": "With --remote: what the box will do to every container, from its own plan-only run. Empty without --remote.",
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "containers", "errors"],
      "properties": {
        "checked": { "type": "boolean" },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["box", "name", "action", "reasons"],
            "properties": {
              "box": { "type": "string" },
              "name": { "type": "string" },
              "action": { "enum": ["noop", "create", "recreate", "start", "remove"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "code": {
      "description": "Branch mode only, and only when bay up keeps code: the build containers whose running commit is newer than the pin. bay up applies the config and leaves their :latest where it is. Absent otherwise.",
      "type": "object",
      "additionalProperties": false,
      "required": ["keep"],
      "properties": {
        "keep": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unsupported": { "type": "array", "items": { "type": "string" } },
    "missing_secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "used_by"],
        "properties": {
          "name": { "type": "string" },
          "used_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "verdict": { "enum": ["auto", "approve", "blocked", "stale"] },
    "exit_code": { "enum": [0, 10, 20, 30] },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["reason", "approved_at"],
          "properties": {
            "reason": { "type": ["string", "null"] },
            "approved_at": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "stale": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "project": { "type": "null" } } },
      "then": { "required": ["projects"] },
      "else": { "not": { "required": ["projects"] } }
    },
    { "if": { "properties": { "verdict": { "const": "auto" } } }, "then": { "properties": { "exit_code": { "const": 0 } } } },
    { "if": { "properties": { "verdict": { "const": "approve" } } }, "then": { "properties": { "exit_code": { "const": 10 } } } },
    { "if": { "properties": { "verdict": { "const": "blocked" } } }, "then": { "properties": { "exit_code": { "const": 20 } } } },
    { "if": { "properties": { "verdict": { "const": "stale" } } }, "then": { "properties": { "exit_code": { "const": 30 } } } }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "commit_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
    "wanted": {
      "type": "object",
      "required": ["commit", "toml_sha256", "dirty"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit_or_null" },
        "toml_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "pinned": {
      "type": "object",
      "required": ["commit", "lock_sha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit_or_null" },
        "lock_sha256": { "$ref": "#/$defs/sha256_or_null" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "container", "resource", "project", "action", "risk", "reason", "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^s[1-9][0-9]*$" },
        "kind": {
          "enum": ["container", "volume", "database", "database_user", "secret", "resource", "tailnet", "route", "fleet", "move", "image"]
        },
        "container": { "type": ["string", "null"] },
        "resource": {
          "description": "For a move step: \"<from box> -> <to box>\".",
          "type": ["string", "null"]
        },
        "project": {
          "description": "The project the step belongs to. null only for a fleet-wide thing: a [resources.*] entry, the webhook, the tailnet, or a container no project owns.",
          "type": ["string", "null"]
        },
        "action": {
          "enum": [
            "create", "update", "remove", "rename", "move", "recreate", "start",
            "route_added", "route_changed", "route_removed"
          ]
        },
        "risk": { "enum": ["safe", "shared", "destructive"] },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "enum": ["compile", "box"] }
      }
    }
  }
}
