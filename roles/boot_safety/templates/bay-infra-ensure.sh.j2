#!/bin/bash
# {{ ansible_managed }}
#
# Ensure all infrastructure containers defined in the infra compose file exist.
# Creates any that are absent; skips any that already exist (running or stopped).
#
# Uses `docker inspect` to check existence — NOT compose project labels.
# Compose v5 uses project labels to track "its" containers; containers restarted
# by Docker's restart policy after a hard reboot lose those labels. --no-recreate
# is therefore blind and tries to create every service, hitting name conflicts on
# already-running containers. docker inspect by name is authoritative.
#
# Triggered on every boot by bay-infra-boot.service. The normal path (all
# containers exist) is a fast no-op. Only acts when a container was deleted
# outright (OOM hard kill, manual removal, corruption), or when a container
# is in a bad state.
#
# Rule: a container with the label com.bay.config-hash was made by the Bay
# reconciler. This script NEVER removes or replaces it. The compose file on the
# box is not what the reconciler deploys, so a compose-made replacement can
# differ from the Bay spec, and the next rig deploy then plans a recreate. A
# labelled container that is dead or restarting gets one `docker restart`, then
# a WARNING. An exited or created one is left alone: a container someone stopped
# on purpose stays stopped, and Docker's restart policy brings back the rest.
# Compose create is only for a container that does not exist at all.

set -euo pipefail

COMPOSE_FILE={{ boot_safety_compose_file | quote }}
TRAEFIK_CONTAINER={{ traefik_container_name | default('traefik') | quote }}

{% raw %}
echo "bay-infra-ensure: checking infra containers from $COMPOSE_FILE"

# Extract container names from compose config (only services with explicit container_name).
# Services without container_name use compose's default naming (<project>_<svc>_1) and
# are not managed by this script — they recover via Docker's own restart policy.
mapfile -t CONTAINER_NAMES < <(
  /usr/bin/docker compose -f "$COMPOSE_FILE" config --format json 2>/dev/null \
    | python3 -c "
import sys, json
cfg = json.load(sys.stdin)
for svc in cfg.get('services', {}).values():
    name = svc.get('container_name', '')
    if name:
        print(name)
"
)

if [ "${#CONTAINER_NAMES[@]}" -eq 0 ]; then
  echo "bay-infra-ensure: no container_name entries found in compose file, nothing to do"
  exit 0
fi

# True when the container carries the reconciler label.
is_bay_managed() {
  local h
  h=$(docker inspect "$1" --format '{{index .Config.Labels "com.bay.config-hash"}}' 2>/dev/null || true)
  [ -n "$h" ]
}

# Wait up to $2 seconds for container $1 to be running. Returns 0 when it is.
wait_running() {
  local i
  for i in $(seq 1 "$2"); do
    [ "$(docker inspect "$1" --format '{{.State.Status}}' 2>/dev/null || echo absent)" = "running" ] && return 0
    sleep 1
  done
  return 1
}

# Wait up to $1 seconds for port 80 to be bound. Returns 0 when it is.
wait_port80() {
  local i
  for i in $(seq 1 "$1"); do
    ss -tln 2>/dev/null | grep ':80 ' >/dev/null && return 0
    sleep 1
  done
  return 1
}

# The likely cause of a bad Traefik. Traefik has host networking and binds the
# tailnet address (traefik_split_entrypoints). Before tailscaled has an address,
# the bind fails and Traefik exits, so a recreate cannot help.
traefik_hint() {
  echo "bay-infra-ensure: WARNING — likely cause: a listener address does not exist yet (the tailnet IP before tailscaled is up). Check net.ipv4.ip_nonlocal_bind (sysctl net.ipv4.ip_nonlocal_bind), 'tailscale status' and 'docker logs $TRAEFIK_CONTAINER'."
}

created=0
restarted=" "
for name in "${CONTAINER_NAMES[@]}"; do
  state=$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || echo "absent")
  if [ "$state" = "absent" ]; then
    echo "bay-infra-ensure: $name absent — creating via compose"
    # Retry up to 3 times; treat 'already in use' as success (TOCTOU)
    for attempt in 1 2 3; do
      out=$(/usr/bin/docker compose -f "$COMPOSE_FILE" up -d "$name" 2>&1) && break
      if grep -q "already in use" <<<"$out"; then
        echo "bay-infra-ensure: $name already appeared between check and create — OK"
        break
      fi
      echo "bay-infra-ensure: $name create attempt $attempt failed: $out"
      [ "$attempt" -lt 3 ] && sleep 2
    done
    echo "bay-infra-ensure: $name was made from the compose file, not by the Bay reconciler. The next 'bay deploy --rig <env>' will recreate it under the reconciler."
    created=$((created + 1))
    continue
  fi
  if ! is_bay_managed "$name"; then
    echo "bay-infra-ensure: $name exists (state=$state) — skipping"
    continue
  fi
  case "$state" in
    dead|restarting)
      echo "bay-infra-ensure: $name is $state (Bay-managed, never replaced) — restarting once"
      restarted="$restarted$name "
      docker restart "$name" >/dev/null || echo "bay-infra-ensure: WARNING — docker restart $name failed"
      if ! wait_running "$name" 30; then
        echo "bay-infra-ensure: WARNING — $name still not running 30s after the restart. The container is left as it is."
        [ "$name" = "$TRAEFIK_CONTAINER" ] && traefik_hint
      fi
      ;;
    *)
      echo "bay-infra-ensure: $name exists (state=$state) — skipping"
      ;;
  esac
done

echo "bay-infra-ensure: done. ${created} container(s) created."

# ── Verify Traefik port bindings ──────────────────────────────────────────
# Traefik uses host networking — ports are bound by the process, not Docker.
# A running container with an unhealthy process won't serve traffic.
traefik_state=$(docker inspect "$TRAEFIK_CONTAINER" --format '{{.State.Status}}' 2>/dev/null || echo "absent")
if [ "$traefik_state" = "running" ]; then
  echo "bay-infra-ensure: verifying $TRAEFIK_CONTAINER port bindings..."
  if wait_port80 30; then
    echo "bay-infra-ensure: $TRAEFIK_CONTAINER port 80 bound — OK"
  elif is_bay_managed "$TRAEFIK_CONTAINER"; then
    # Never remove it: the recreate would not fix a missing listener address.
    case "$restarted" in
      *" $TRAEFIK_CONTAINER "*)
        echo "bay-infra-ensure: $TRAEFIK_CONTAINER running but port 80 not bound after 30s (already restarted once)"
        ;;
      *)
        echo "bay-infra-ensure: $TRAEFIK_CONTAINER running but port 80 not bound after 30s — restarting once (Bay-managed, never replaced)"
        docker restart "$TRAEFIK_CONTAINER" >/dev/null || echo "bay-infra-ensure: WARNING — docker restart $TRAEFIK_CONTAINER failed"
        if wait_port80 30; then
          echo "bay-infra-ensure: $TRAEFIK_CONTAINER port 80 bound after restart — OK"
          exit 0
        fi
        ;;
    esac
    echo "bay-infra-ensure: WARNING — $TRAEFIK_CONTAINER port 80 still not bound after the restart. The container is left as it is."
    traefik_hint
  else
    echo "bay-infra-ensure: $TRAEFIK_CONTAINER running but port 80 not bound after 30s — recreating"
    docker rm -f "$TRAEFIK_CONTAINER"
    /usr/bin/docker compose -f "$COMPOSE_FILE" up -d "$TRAEFIK_CONTAINER"
    for i in $(seq 1 15); do
      if ss -tlnp 2>/dev/null | grep -q ':80 '; then
        echo "bay-infra-ensure: $TRAEFIK_CONTAINER port 80 bound after recreate — OK"
        break
      fi
      [ "$i" -eq 15 ] && echo "bay-infra-ensure: WARNING — $TRAEFIK_CONTAINER port 80 still not bound after recreate"
      sleep 1
    done
  fi
fi
{% endraw %}
