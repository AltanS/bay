#!/bin/bash
# Managed by Ansible — do not edit manually.
#
# Read-only docker surface for the {{ debug_agent_user }} account.
# Granted through sudo INSTEAD of the `docker` group: group membership is
# root, because any member can bind-mount / into a container.
#
# Permitted: ps, logs, inspect, stats --no-stream, images, system df,
#            compose ps, compose logs
# Refused:   everything else, and every flag outside the small allowlist.
set -euo pipefail

DOCKER=/usr/bin/docker

die() { echo "bay-docker-ro: $*" >&2; exit 1; }

[ "$#" -ge 1 ] || die "usage: bay-docker-ro <ps|logs|inspect|stats|images|system df|compose ps|compose logs> [args]"

verb=$1
shift

case "$verb" in
  ps|logs|images)
    cmd=( "$verb" )
    ;;
  inspect)
    cmd=( inspect )
    inspect_format_seen=1
    ;;
  stats)
    cmd=( stats --no-stream )
    ;;
  system)
    [ "${1:-}" = df ] || die "only 'system df' is permitted"
    shift
    cmd=( system df )
    ;;
  compose)
    sub=${1:-}
    shift || true
    case "$sub" in
      ps|logs) cmd=( compose "$sub" ) ;;
      *) die "only 'compose ps' and 'compose logs' are permitted" ;;
    esac
    ;;
  *)
    die "subcommand not permitted: $verb"
    ;;
esac

{% raw %}
# ── inspect --format allowlist ───────────────────────────────────────────────
# A bare `docker inspect` prints the container's whole config, Config.Env
# included — bearer tokens, webhook secrets, database URLs. This surface is
# advertised as read-only, and reading every secret on the box is not what an
# operator means by that.
#
# So inspect REQUIRES a --format, and only these are accepted. None of them can
# reach .Config.Env, .Config.Cmd or .Config.Entrypoint. Anything else exits
# non-zero. Bay also moved the rig's own secrets out of Config.Env and into
# env_file, but a guard must not depend on a container being well behaved.
BAY_INSPECT_FORMAT_ALLOW=(
  '{{.Name}}'
  '{{.Id}}'
  '{{.Image}}'
  '{{.Config.Image}}'
  '{{.Created}}'
  '{{.RestartCount}}'
  '{{.State.Status}}'
  '{{.State.Running}}'
  '{{.State.Restarting}}'
  '{{.State.Paused}}'
  '{{.State.OOMKilled}}'
  '{{.State.Dead}}'
  '{{.State.ExitCode}}'
  '{{.State.Error}}'
  '{{.State.StartedAt}}'
  '{{.State.FinishedAt}}'
  '{{.State.Health.Status}}'
  '{{.State.Health.FailingStreak}}'
  '{{.HostConfig.RestartPolicy.Name}}'
  '{{.HostConfig.Memory}}'
  '{{.HostConfig.NanoCpus}}'
  '{{.NetworkSettings.IPAddress}}'
  '{{json .State}}'
  '{{json .State.Health}}'
  '{{json .NetworkSettings.Ports}}'
  '{{json .HostConfig.RestartPolicy}}'
)
{% endraw %}

_inspect_format_allowed() {
  local candidate=$1 allowed
  for allowed in "${BAY_INSPECT_FORMAT_ALLOW[@]}"; do
    [ "$candidate" = "$allowed" ] && return 0
  done
  return 1
}

if [ "${inspect_format_seen:-0}" = 1 ]; then
  _fmt=""
  _want_value=0
  for arg in "$@"; do
    if [ "$_want_value" = 1 ]; then
      _fmt=$arg
      _want_value=0
      continue
    fi
    case "$arg" in
      --format=*) _fmt=${arg#--format=} ;;
      --format) _want_value=1 ;;
    esac
  done
  [ "$_want_value" = 0 ] || die "--format needs a value"
  [ -n "$_fmt" ] || die "inspect requires a --format from the allowlist; a bare inspect would print Config.Env"
  _inspect_format_allowed "$_fmt" || die "inspect --format not permitted: $_fmt"
fi

for arg in "$@"; do
  case "$arg" in
    exec|run|cp|attach|build|create|kill|rm|rmi|start|stop|restart|update|\
    login|save|load|push|pull|commit|export|import|network|volume|swarm|\
    secret|config|plugin|service|node|context|builder|buildx)
      die "token not permitted: $arg"
      ;;
    -v|--volume|--mount|-u|--user|--privileged|--entrypoint|-w|--workdir|\
    --host|-H|--config|--context|-c|--tlscert|--tlskey|--tlscacert)
      die "flag not permitted: $arg"
      ;;
    -*)
      flag=${arg%%=*}
      case "$flag" in
        --tail|--since|--until|-n|--no-stream|--format|-a|--all|--timestamps|-t|--no-trunc)
          ;;
        *) die "flag not permitted: $arg" ;;
      esac
      ;;
    *) ;;
  esac
done

exec "$DOCKER" "${cmd[@]}" "$@"
