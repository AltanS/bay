# {{ ansible_managed }}
# nftables firewall configuration for Bay
#
# Chain priority order:
#   -10  crowdsec/crowdsec6 (bouncer-managed — CAPI + local bans)
#     0  filter (base firewall — port allowlist + default drop)
#
# Trusted admin IPs are excluded via the bouncer's exclude_ips config
# (not nftables chains — accept in one chain doesn't prevent drop in the next).
#
# Traefik uses network_mode: host, so traffic hits nftables directly.
# Static CIDR blocklist loaded from /etc/nftables.d/ (managed by crowdsec role).
#
# Only flush our own tables — Docker's ip family tables (DOCKER-FORWARD, etc.)
# are created once at daemon startup and must not be destroyed.

{% if crowdsec_trusted_ips | default([]) | length > 0 %}
# Clean up legacy bypass table (nftables accept doesn't prevent later chains from dropping)
table inet crowdsec_bypass {}
delete table inet crowdsec_bypass

{% endif %}
table inet filter {}
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Allow established and related connections
        ct state established,related accept

        # Drop invalid connections
        ct state invalid drop

        # Allow loopback
        iif lo accept

        # Container traffic to the host (DNS, health checks).
        # nftables_container_host_ports empty (the default) = accept everything
        # from container interfaces, as before. Non-empty narrows the accept to
        # exactly those ports. See roles/nftables/defaults/main.yml.
{% for _iface in ['docker*', 'br-*', 'veth*'] %}
{% if nftables_container_host_ports | default([]) | length > 0 %}
{% for _chp in nftables_container_host_ports %}
        iifname "{{ _iface }}" {{ _chp.proto | default('tcp') }} dport {{ _chp.port }} accept
{% endfor %}
{% else %}
        iifname "{{ _iface }}" accept
{% endif %}
{% endfor %}

        # Allow ICMP (ping, path MTU discovery)
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # Allow configured TCP ports
{% for port in firewall_allowed_tcp_ports %}
        tcp dport {{ port }} accept
{% endfor %}

        # Allow configured UDP ports
{% for port in firewall_allowed_udp_ports %}
        udp dport {{ port }} accept
{% endfor %}

        # NOTE: a loop here previously emitted
        #   iifname "tailscale0" tcp dport <port> accept
        # for every cross-region link target, intending to restrict
        # tailnet-linked accessories to tailnet-only access. It never
        # enforced anything — Docker-published ports bypass the input
        # chain via iptables DNAT (PREROUTING -> DOCKER / DOCKER-USER),
        # so the input chain is never consulted for published traffic.
        # The enforcement that actually prevents public access is
        # Docker's destination-IP scoping of its DNAT rule, triggered
        # by binding to a tailnet IP via `expose: tailnet` on the
        # accessory stanza.

        # Log and drop everything else
        log prefix "nftables-drop: " flags all counter drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        # Allow Docker container traffic (forwarded by Docker)
        ct state established,related accept

        # Docker manages its own forward rules via iptables/nftables.
        # This bare accept makes `policy drop` above decorative — it is kept
        # by default because container networking depends on it. Set
        # nftables_forward_permissive: false to let the drop policy apply.
{% if nftables_forward_permissive | default(true) %}
        accept
{% endif %}
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

# Include additional nftables configs (CrowdSec CIDR blocklist, etc.)
include "/etc/nftables.d/*.conf"
