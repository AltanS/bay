# {{ ansible_managed }}
#
# Alert credentials for every bay emitter. Root-owned, mode 0600.
#
# Read two ways, and the file format has to satisfy both:
#   * systemd units set `EnvironmentFile=-{{ alert_env_path }}`. systemd reads
#     it as PID 1, before it drops to User=, so a unit running as an
#     unprivileged account still gets the values from a 0600 root:root file.
#   * cron and hand runs get them from `_notify.sh.j2`, which sources this
#     file when it is readable.
#
# Values are SINGLE-quoted. Both readers strip the quotes and neither expands
# anything inside them, so a token or URL cannot become shell code in a script
# that runs from root cron. A value containing a literal single quote is not
# supported — rotate it rather than escaping it.
#
# The bare telegram_bot_token / telegram_chat_id names are outbound_monitor's
# deprecated spelling. They used to be honoured by a `{% raw %}{% set %}{% endraw %}` in each of that
# role's two templates; with the credentials out of the templates, the
# fallback has to live here or an existing override silently stops working.
TELEGRAM_BOT_TOKEN='{{ docker_monitor_telegram_bot_token | default('') or telegram_bot_token | default('') }}'
TELEGRAM_CHAT_ID='{{ docker_monitor_telegram_chat_id | default('') or telegram_chat_id | default('') }}'
ALERT_WEBHOOK_URL='{{ alert_webhook_url | default('') }}'

# ── Explicit recipients ──────────────────────────────────────────────────
#
# One line per recipient configured with a LITERAL credential, keyed by its
# 1-based position in alert_recipients — the same index _notify.sh.j2 uses for
# its _bay_send_r<n> function. A recipient using token_env / url_env is absent
# here on purpose: it sources its value from the unit's own environment.
{% for _r in (alert_recipients | default([])) %}
{% set _rn = _r | bay_alert_recipient %}
{% set _rc = _rn.config %}
{% if _rn.adapter == 'telegram' and _rc.token_env is not defined and (_rc.bot_token | default('')) | length > 0 %}
BAY_RC_{{ loop.index }}_TOKEN='{{ _rc.bot_token }}'
{% endif %}
{% if _rn.adapter != 'telegram' and _rc.url_env is not defined and (_rc.url | default('')) | length > 0 %}
BAY_RC_{{ loop.index }}_URL='{{ _rc.url }}'
{% endif %}
{% endfor %}
