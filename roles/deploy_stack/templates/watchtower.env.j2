# {{ ansible_managed }}
# Watchtower's notification URL embeds the Telegram bot token, so it must not
# be an inline `environment:` entry — that is a `docker inspect` away from any
# account with the read-only debug surface.
#
# Empty when no token is configured, which keeps the container's env identical
# to the old `| default(omit)` behaviour: no key at all rather than an empty
# one.
#
# Values go through `bay_env_value`, exactly as env.j2 does: it doubles `$` so
# Compose does not interpolate it (the reconciler's parse_env_file undoes that)
# and REFUSES a newline, which the env-file format cannot escape and which
# would otherwise inject a second, attacker-chosen KEY=VALUE line.
{% if (watchtower_telegram_bot_token | default('')) | length > 0 and (watchtower_telegram_chat_id | default('')) | length > 0 %}
WATCHTOWER_NOTIFICATION_URL=telegram://{{ watchtower_telegram_bot_token | bay_env_value }}@telegram?chats={{ watchtower_telegram_chat_id | bay_env_value }}
{% endif %}
