#!/usr/bin/env bash
# {{ ansible_managed }}
# A Bay job (bay.toml [[jobs]]): the job container and its main container are
# named below. Run by bay-job@<job>.service, which bay-job@<job>.timer starts.
# One run at a time: systemd does not start the service while it runs.
# No value is interpolated into a comment: a newline in it would end the comment.
set -euo pipefail

# The image the main container runs now, so a job always runs the deployed code.
IMAGE=$(docker inspect --format '{% raw %}{{.Config.Image}}{% endraw %}' {{ job.of | quote }})

exec docker run --rm \
  --name {{ job_name | quote }} \
  --label {{ ('com.bay.job-of=' ~ job.of) | quote }} \
{% if job_main.network_mode is defined %}
  --network {{ job_main.network_mode | quote }} \
{% else %}
  --network {{ traefik_docker_network | default('services') | quote }} \
{% endif %}
{% if job_main.env is defined or job_main.database is defined %}
  --env-file {{ (stack_dir ~ '/env/' ~ job.of ~ '.env') | quote }} \
{% endif %}
{% for vol in job_main.volumes | default([]) | bay_prefix_volumes(stack_name | default('bay')) %}
  -v {{ vol | quote }} \
{% endfor %}
{% if job_memory %}
  --memory {{ job_memory | quote }} \
  --memory-swap {{ job_memory | quote }} \
{% endif %}
  "${IMAGE}" sh -c {{ job.command | quote }}
