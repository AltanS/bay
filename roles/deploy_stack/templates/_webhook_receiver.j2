{% set _has_local_builds = (active_services | dict2items | selectattr('value.build', 'defined') | list | length > 0) %}
{% set _is_build_server = ((build_server | default('')) == inventory_hostname) %}
{% set _default_strategy = git_deploy_build_strategy | default('local') %}
{% set ns = namespace(has_remote=false) %}
{% for item in (services | default({})) | dict2items | selectattr('value.build', 'defined') %}
{%   set raw = item.value.build.strategy | default(_default_strategy) %}
{%   set strat = 'remote' if raw == 'push' else raw %}
{%   if strat == 'remote' %}
{%     set ns.has_remote = true %}
{%   endif %}
{% endfor %}
{% if webhook is defined and (_has_local_builds or (_is_build_server and ns.has_remote)) %}
  # ── Webhook Receiver (auto-deployed for build: services) ──────────
  bay-webhook:
    image: bay-webhook:latest
    pull_policy: never
    container_name: bay-webhook
    restart: unless-stopped
    # Fixed UID + the host's shared build-control GID, so triggers/ and state/
    # can be 2770 instead of 0777. Mirrors the reconciler spec in
    # roles/container_lifecycle/tasks/build_specs.yml.
    user: "{{ git_deploy_webhook_uid | default(10001) }}:{{ git_deploy_build_gid | default(2000) }}"
    networks:
      - {{ traefik_docker_network }}
    # WEBHOOK_SECRET and the Telegram pair are in the env file, not here.
    env_file:
      - {{ stack_dir }}/env/bay-webhook.env
    environment:
      - TRIGGER_DIR=/triggers
      - TELEGRAM_FAILURES_LOG=/state/telegram-failures.log
      - SERVICE_BRANCHES={% for svc_name in active_services | dict2items | selectattr('value.build', 'defined') | map(attribute='key') %}{{ svc_name }}:{{ active_services[svc_name].build.branch | default('main') }}{% if not loop.last %},{% endif %}{% endfor %}

      - TELEGRAM_HEADER={{ docker_monitor_alert_header | default('') }}
      - HOSTNAME={% include '_host_label.j2' +%}
      - LOCAL_REGION={{ region | default('') }}
      - WEBHOOK_PEER_TIMEOUT={{ git_deploy_webhook_peer_timeout | default(10) }}
{% if _is_build_server and ns.has_remote %}
      - IS_BUILD_SERVER=true
{% endif %}

    volumes:
      - {{ stack_dir }}/triggers:/triggers
      - {{ stack_dir }}/state:/state
      - {{ stack_dir }}/webhook/config.json:/config/services.json:ro
      - {{ stack_dir }}/webhook/image-map.json:/config/image-map.json:ro
{{ macros.logging_block({}) }}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_docker_network }}"
      - "traefik.http.routers.bay-webhook.rule=Host(`{{ webhook.domain }}`)"
      - "traefik.http.routers.bay-webhook.entrypoints=websecure"
      - "traefik.http.routers.bay-webhook.tls.certresolver=letsencrypt"
      - "traefik.http.middlewares.bay-webhook-ratelimit.ratelimit.average={{ webhook_rate_limit_average | default(10) }}"
      - "traefik.http.middlewares.bay-webhook-ratelimit.ratelimit.burst={{ webhook_rate_limit_burst | default(30) }}"
      - "traefik.http.middlewares.bay-webhook-ratelimit.ratelimit.period={{ webhook_rate_limit_period | default('1s') }}"
      - "traefik.http.middlewares.bay-webhook-ratelimit.ratelimit.sourceCriterion.ipStrategy.depth=1"
      - "traefik.http.routers.bay-webhook.middlewares=public-chain,bay-webhook-ratelimit"
      - "traefik.http.services.bay-webhook.loadbalancer.server.port=9000"
{% if watchtower_enabled | default(false) %}
      - "com.centurylinklabs.watchtower.enable=false"
{% endif %}
{% endif %}
