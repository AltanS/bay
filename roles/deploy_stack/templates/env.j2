# {{ ansible_managed }}
# Environment file for {{ env_service_name }}
{% if env_clear is defined %}
{% for key, value in env_clear.items() %}
{{ key }}={{ value | bay_env_value }}
{% endfor %}
{% endif %}
{% if env_secrets is defined %}
{% if env_secrets is mapping %}
{% for env_var, vault_key in env_secrets.items() %}
{{ env_var }}={{ secrets[vault_key] | bay_env_value }}
{% endfor %}
{% else %}
{% for secret_name in env_secrets %}
{% set vault_key = env_service_name | upper | replace('-', '_') ~ '_' ~ secret_name %}
{{ secret_name }}={{ secrets[vault_key] | bay_env_value }}
{% endfor %}
{% endif %}
{% endif %}
{% if env_database %}
# Database binding (auto-injected from database: block)
{% set db_name = env_database.name | default(env_service_name) %}
{% set db_user = env_database.user | default(env_service_name) %}
{% set db_vault_key = (db_user | upper | replace('-', '_')) ~ '_POSTGRES_PASSWORD' %}
{% set db_host = env_database.accessory %}
{% set db_port = '5432' %}
{% set db_password = secrets[db_vault_key] %}
DATABASE_URL=postgres://{{ db_user }}:{{ db_password | urlencode }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password | bay_env_value }}
{% endif %}
{% if _link_env is defined and _link_env[env_service_name] is defined %}
# Cross-region link variables
{% for key, value in _link_env[env_service_name].items() %}
{{ key }}={{ value | bay_env_value }}
{% endfor %}
{% endif %}
