# {{ ansible_managed }}
# Credentials for the bay webhook receiver.
#
# These used to be inline `environment:` entries, which land in Config.Env and
# come straight back out of `docker inspect` — including through the read-only
# debug_agent surface. An env_file keeps them at 0640 on disk and out of the
# container's inspectable config in the compose path.
#
# Values go through `bay_env_value`, exactly as env.j2 does: it doubles `$` so
# Compose does not interpolate it (the reconciler's parse_env_file undoes that)
# and REFUSES a newline, which the env-file format cannot escape and which
# would otherwise inject a second, attacker-chosen KEY=VALUE line.
{% if (webhook.secret | default('')) | length > 0 %}
WEBHOOK_SECRET={{ webhook.secret | bay_env_value }}
{% endif %}
{% if (docker_monitor_telegram_bot_token | default('')) | length > 0 %}
TELEGRAM_BOT_TOKEN={{ docker_monitor_telegram_bot_token | bay_env_value }}
{% endif %}
{% if (docker_monitor_telegram_chat_id | default('')) | length > 0 %}
TELEGRAM_CHAT_ID={{ docker_monitor_telegram_chat_id | bay_env_value }}
{% endif %}
{% if (alert_webhook_url | default('')) | length > 0 %}
ALERT_WEBHOOK_URL={{ alert_webhook_url | bay_env_value }}
{% endif %}
