# {{ ansible_managed }}
# Credentials for the bay webhook receiver.
#
# These used to be inline `environment:` entries, which land in Config.Env and
# come straight back out of `docker inspect` — including through the read-only
# debug_agent surface. An env_file keeps them at 0640 on disk and out of the
# container's inspectable config in the compose path.
#
# Values go through `bay_env_value`, exactly as env.j2 does: it doubles `$` so
# Compose does not interpolate it (the reconciler's parse_env_file undoes that)
# and REFUSES a newline, which the env-file format cannot escape and which
# would otherwise inject a second, attacker-chosen KEY=VALUE line.
{% if (webhook.secret | default('')) | length > 0 %}
WEBHOOK_SECRET={{ webhook.secret | bay_env_value }}
{% endif %}
{% if (docker_monitor_telegram_bot_token | default('')) | length > 0 %}
TELEGRAM_BOT_TOKEN={{ docker_monitor_telegram_bot_token | bay_env_value }}
{% endif %}
{% if (docker_monitor_telegram_chat_id | default('')) | length > 0 %}
TELEGRAM_CHAT_ID={{ docker_monitor_telegram_chat_id | bay_env_value }}
{% endif %}
{% if (alert_webhook_url | default('')) | length > 0 %}
ALERT_WEBHOOK_URL={{ alert_webhook_url | bay_env_value }}
{% endif %}

{#
  Explicit recipients (alert_recipients), for the receiver's send_alert().

  BAY_ALERT_ROUTING is the non-secret routing table from the bay_alert_routing
  filter, the one docker-monitor bakes into its script: per recipient, the
  alert IDs it receives and its non-secret config. It is rendered without
  headers, because a header may carry a bearer token and the table is meant
  to hold no secret.

  The credentials follow under the same 1-based index alert.env.j2 uses, from
  the same values and under the same conditions, so BAY_RC_<n>_* means the
  same recipient in both files. Declarative webhook headers travel as
  BAY_RC_<n>_HEADERS (a JSON object). A token_env / chat_id_env / url_env
  names a variable in THIS container's environment, which holds only what this
  file and the container spec set.

  Nothing is emitted for a consumer without alert_recipients, so a legacy
  consumer's env file is unchanged.
#}
{% if (alert_recipients | default([])) | length > 0 %}
BAY_ALERT_ROUTING={{ alert_recipients | bay_alert_routing(alerts_disabled | default([]), alerts_enabled | default([]), false) | to_json | bay_env_value }}
{% for _r in alert_recipients %}
{% set _rn = _r | bay_alert_recipient %}
{% set _rc = _rn.config %}
{% if _rn.adapter == 'telegram' and _rc.token_env is not defined and (_rc.bot_token | default('')) | length > 0 %}
BAY_RC_{{ loop.index }}_TOKEN={{ _rc.bot_token | bay_env_value }}
{% endif %}
{% if _rn.adapter != 'telegram' and _rc.url_env is not defined and (_rc.url | default('')) | length > 0 %}
BAY_RC_{{ loop.index }}_URL={{ _rc.url | bay_env_value }}
{% endif %}
{% if _rn.adapter != 'telegram' and (_rc.headers | default({})) | length > 0 %}
BAY_RC_{{ loop.index }}_HEADERS={{ _rc.headers | to_json | bay_env_value }}
{% endif %}
{% endfor %}
{% endif %}
