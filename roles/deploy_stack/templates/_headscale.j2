{% if access_gateway | default('wireguard') == 'headscale' and headscale_server | default(true) | bool %}
  # ── Headscale Coordination Server ─────────────────────────────────────
  headscale:
    image: headscale/headscale:{{ headscale_version }}
    container_name: headscale
    restart: unless-stopped
    command: serve
    # Same hardening as the reconciler spec (container_lifecycle/tasks/build_specs.yml).
    read_only: true
    tmpfs:
      - /var/run/headscale
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    volumes:
      - /opt/headscale/config:/etc/headscale:ro
      - /opt/headscale/data:/var/lib/headscale
    ports:
      - "3478:3478/udp"
    networks:
      - {{ traefik_docker_network }}
{{ macros.logging_block({}) }}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_docker_network }}"
      - "traefik.http.routers.headscale.rule=Host(`{{ headscale_domain }}`)"
      - "traefik.http.routers.headscale.entrypoints=websecure"
      - "traefik.http.routers.headscale.tls.certresolver=letsencrypt"
      - "traefik.http.routers.headscale.middlewares=headscale-client-ip,public-chain"
      # Removes a client-sent True-Client-IP; see headscale_trusted_proxies.
      - "traefik.http.middlewares.headscale-client-ip.headers.customrequestheaders.True-Client-IP="
      - "traefik.http.services.headscale.loadbalancer.server.port=8080"
      - "com.centurylinklabs.watchtower.enable=false"
{%   if not (headscale_admin_api_public | default(false) | bool) %}
      # Admin API gate: /api and /swagger only from headscale_admin_api_allowed_ips.
      # Documentation only; the reconciler builds the labels in
      # container_lifecycle/tasks/build_specs.yml.
      - "traefik.http.routers.headscale-admin.rule=Host(`{{ headscale_domain }}`) && (PathPrefix(`/api`) || PathPrefix(`/swagger`))"
      - "traefik.http.routers.headscale-admin.priority=1000"
      - "traefik.http.routers.headscale-admin.entrypoints={{ 'websecure,websecure_tailnet' if traefik_split_entrypoints | default(false) | bool else 'websecure' }}"
      - "traefik.http.routers.headscale-admin.tls.certresolver=letsencrypt"
      - "traefik.http.routers.headscale-admin.middlewares=headscale-client-ip,public-chain,headscale-admin-allow"
      - "traefik.http.routers.headscale-admin.service=headscale"
      - "traefik.http.middlewares.headscale-admin-allow.ipallowlist.sourcerange={{ (headscale_admin_api_allowed_ips | default(['127.0.0.1/32', '::1/128'])) | join(',') }}"
{%   endif %}

{% endif %}
