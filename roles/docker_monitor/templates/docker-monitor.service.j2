# {{ ansible_managed }}
[Unit]
Description=Docker Container Monitor (crashes, restart loops, health checks)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ docker_monitor_script_path }}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
