#!/usr/bin/env python3
# {{ ansible_managed }}
# Docker container monitor
# Watches Docker events and sends alerts (legacy pair + alert_recipients) for:
#   - Container crashes (non-zero exit code)
#   - Container recovery (start after crash)
#   - Restart loops (too many starts within a time window)
#   - Health check failures

import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request
from collections import defaultdict
from datetime import datetime, timezone

# Credentials come from the environment, never from a rendered literal: this
# file is installed under /usr/local/bin and was world-readable for its whole
# life. systemd supplies them via EnvironmentFile=/etc/bay/alert.env (0600
# root:root) — see roles/alert_channel.
TELEGRAM_BOT_TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "")
TELEGRAM_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", "")
HOSTNAME = "{% include '_host_label.j2' %}"

ALERT_CONTAINER_CRASH = {{ docker_monitor_alert_container_crash | bool | string }}
ALERT_RESTART_LOOP = {{ docker_monitor_alert_restart_loop | bool | string }}
ALERT_HEALTHCHECK_FAILURE = {{ docker_monitor_alert_healthcheck_failure | bool | string }}

RESTART_LOOP_THRESHOLD = {{ docker_monitor_restart_loop_threshold }}
RESTART_LOOP_WINDOW = {{ docker_monitor_restart_loop_window }}
# Seconds between two container.restart_loop alerts for the same container.
# Wall-clock and persisted in STATE_FILE, so a monitor restart does not reset
# it. See docker_monitor_restart_loop_cooldown in the role defaults.
RESTART_LOOP_COOLDOWN = {{ docker_monitor_restart_loop_cooldown | default(1800) | int }}
# Seconds a crash_state row may live before save_crash_state drops it. 0 keeps
# rows forever. See docker_monitor_crash_state_max_age in the role defaults.
CRASH_STATE_MAX_AGE = {{ docker_monitor_crash_state_max_age | default(604800) | int }}

IGNORE_CONTAINERS = {{ docker_monitor_ignore_containers | to_json }}

STATE_FILE = "{{ stack_dir | default('/opt/bay') }}/.container-crashes.json"
MSG_HEADER = {{ docker_monitor_alert_header | to_json }}
MSG_FOOTER = {{ docker_monitor_alert_footer | to_json }}

ALERT_WEBHOOK_URL = os.environ.get("ALERT_WEBHOOK_URL", "")
ALERT_WEBHOOK_FORMAT = {{ alert_webhook_format | default('campfire') | to_json }}
ALERT_WEBHOOK_TIMEOUT = {{ alert_webhook_timeout | default(10) }}
ALERT_WEBHOOK_MAX_CHARS = {{ alert_webhook_max_chars | default(3500) }}

# Operator mute overrides, rendered by roles/alert_policy. Read at CALL time,
# parsed and never executed, and fail-open: see bay_alert_muted.
ALERT_POLICY_PATH = {{ alert_policy_path | default('/etc/bay/alert-overrides') | to_json }}

# The generic webhook sink, shared verbatim with the webhook receiver and the
# control-node deploy alerts. See roles/alert_channel/files/bay_alert.py.
{% include 'bay_alert.py' %}

{#
  Explicit recipients: the Python twin of the _bay_send_r<n> functions and the
  _bay_route `case` list in roles/alert_channel/templates/_notify.sh.j2.

  ROUTING is baked in; CREDENTIALS are not. The bay_alert_routing filter builds
  one non-secret entry per recipient (same list, same order, same 1-based
  index as alert.env.j2), carrying the alert IDs it receives. The webhook
  receiver gets the same table from the same filter. A literal bot_token or url
  is read at run time from BAY_RC_<n>_TOKEN / BAY_RC_<n>_URL, and token_env /
  chat_id_env / url_env name a variable in the unit's environment instead; see
  bay_send_to_recipient in bay_alert.py.

  Each entry is emitted as a JSON string literal and parsed at import, so no
  consumer value is ever pasted into Python syntax.
#}
# Explicit recipients (alert_recipients). Routing resolved at render time from
# alerts/registry.yml; credentials come from the environment only.
BAY_RECIPIENTS = [
{% for _entry in (alert_recipients | default([])) | bay_alert_routing(alerts_disabled | default([]), alerts_enabled | default([])) %}
    json.loads({{ _entry | to_json | to_json }}),
{% endfor %}
]

# In-memory state
restart_timestamps = defaultdict(list)  # container_name -> [timestamps]
# container_name -> time.monotonic() of its last container.health_check_failed
# alert. A MISSING key means "never alerted": monotonic() counts from boot, so
# a `.get(name, 0)` default made every unhealthy event in the first
# HEALTH_COOLDOWN_SECONDS after a reboot look like it was inside the cooldown.
health_cooldowns = {}
crash_state = {}  # container_name -> {"exit_code": int, "crashed_at": str, "crash_count": int}
HEALTH_COOLDOWN_SECONDS = 300
# container_name -> wall-clock epoch of its last container.restart_loop alert.
# Persisted in STATE_FILE under RESTART_LOOP_STATE_KEY. Docker container names
# must start with a letter or digit, so a key starting with "_" can never
# collide with a crash_state entry.
restart_loop_alerted = {}
RESTART_LOOP_STATE_KEY = "_restart_loop_alerted"


def send_alert(alert_id, message):
    """Fan one alert out to every configured sink, the way bay_notify does.

    `alert_id` is the alert's registry ID from alerts/registry.yml. It must be
    passed as a literal string at every call site — tests/test_alert_registry.py
    enforces that, because the registry drift check scans for literals and a
    variable would make it under-report silently.

    Same order and rules as bay_notify in _notify.sh.j2:

      1. An operator mute (ALERT_POLICY_PATH) suppresses every sink, legacy
         included. Otherwise "disable this alert" would still deliver to the
         two sinks people actually have.
      2. The LEGACY pair (TELEGRAM_* and ALERT_WEBHOOK_URL) fires
         unconditionally. It never consults the registry, so alerts_disabled
         and enabled_by_default: false do not reach it — the same
         grandfathering the shell emitters have. That keeps a legacy
         consumer's delivery unchanged.
      3. Each explicit recipient whose render-time ID set contains alert_id
         gets it through its own adapter.

    Every send is best-effort: a monitor that dies on a failed alert stops
    monitoring.
    """
    try:
        if bay_alert_muted(alert_id, ALERT_POLICY_PATH):
            return
    except Exception as e:  # noqa: BLE001 — a broken mute check must not mute
        print(f"Failed to read alert overrides: {e}", file=sys.stderr)

    body = MSG_HEADER + message + MSG_FOOTER

    bay_send_telegram(
        body,
        TELEGRAM_BOT_TOKEN,
        TELEGRAM_CHAT_ID,
        timeout=10,
        on_error=lambda reason: print(
            f"Failed to send Telegram alert: {reason}", file=sys.stderr
        ),
    )

    bay_send_webhook(
        body,
        ALERT_WEBHOOK_URL,
        ALERT_WEBHOOK_FORMAT,
        timeout=ALERT_WEBHOOK_TIMEOUT,
        max_chars=ALERT_WEBHOOK_MAX_CHARS,
        on_error=lambda reason: print(
            f"Failed to send webhook alert: {reason}", file=sys.stderr
        ),
    )

    bay_route_to_recipients(
        alert_id,
        body,
        BAY_RECIPIENTS,
        os.environ,
        timeout=ALERT_WEBHOOK_TIMEOUT,
        max_chars=ALERT_WEBHOOK_MAX_CHARS,
        on_error=lambda label, reason: print(
            f"Failed to send alert to recipient {label}: {reason}", file=sys.stderr
        ),
    )


def is_ignored(container_name):
    """Check if a container should be ignored (suffix match)."""
    for pattern in IGNORE_CONTAINERS:
        if container_name.endswith(pattern):
            return True
    return False


def load_crash_state():
    """Load crash state from disk. Returns empty dict on missing/corrupt file.

    Also restores the restart-loop cooldowns, which share the file under
    RESTART_LOOP_STATE_KEY; the returned dict holds crash entries only.
    """
    global restart_loop_alerted
    try:
        with open(STATE_FILE, "r") as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    if not isinstance(data, dict):
        return {}
    alerted = data.pop(RESTART_LOOP_STATE_KEY, None)
    if isinstance(alerted, dict):
        restart_loop_alerted = {
            str(name): float(ts)
            for name, ts in alerted.items()
            if isinstance(ts, (int, float))
        }
    return data


def _crash_row_expired(row, now):
    """True when a crash_state row is older than CRASH_STATE_MAX_AGE.

    `crashed_at` is written by handle_die as `datetime.now().isoformat()`: a
    naive LOCAL timestamp such as 2026-09-19T22:36:43.123456. An aware one
    (a hand-edited file) is compared against an aware now instead of raising.

    A row whose timestamp is missing or unparsable counts as EXPIRED. Keeping
    it would be keeping it forever, because its age can never be computed,
    which is the unbounded growth this prune exists to stop. The cost is at
    most one container.recovered alert for a row that was already corrupt.
    A timestamp in the future (clock skew) is not expired.
    """
    if not isinstance(row, dict):
        return True
    try:
        crashed_at = datetime.fromisoformat(str(row["crashed_at"]))
        if crashed_at.tzinfo is not None:
            age = datetime.now(timezone.utc).timestamp() - crashed_at.timestamp()
        else:
            age = (now - crashed_at).total_seconds()
    except (KeyError, TypeError, ValueError, OverflowError):
        return True
    return age > CRASH_STATE_MAX_AGE


def prune_crash_state(now=None):
    """Drop crash_state rows older than CRASH_STATE_MAX_AGE. Returns the count.

    Without this, a row written for a one-off `docker run` container that
    never starts again stays in the state file for ever.
    """
    if CRASH_STATE_MAX_AGE <= 0:
        return 0
    current = datetime.now() if now is None else now
    expired = [n for n, row in crash_state.items() if _crash_row_expired(row, current)]
    for name in expired:
        del crash_state[name]
    return len(expired)


def save_crash_state():
    """Write crash state atomically (tmp + rename) to avoid corruption."""
    state_dir = os.path.dirname(STATE_FILE)
    # Drop cooldowns that have run out, so the file cannot grow without bound.
    now = time.time()
    for name in [n for n, ts in restart_loop_alerted.items() if now - ts >= RESTART_LOOP_COOLDOWN]:
        del restart_loop_alerted[name]
    # Same for crash rows: see prune_crash_state.
    prune_crash_state()
    data = dict(crash_state)
    if restart_loop_alerted:
        data[RESTART_LOOP_STATE_KEY] = restart_loop_alerted
    try:
        fd, tmp_path = tempfile.mkstemp(dir=state_dir, suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f, indent=2)
            os.replace(tmp_path, STATE_FILE)
        except BaseException:
            os.unlink(tmp_path)
            raise
    except OSError as e:
        print(f"Failed to write state file: {e}", file=sys.stderr)


def format_timestamp():
    """Format current time as human-readable UTC string."""
    return datetime.now(timezone.utc).strftime("%b %d, %H:%M UTC")


def format_duration(seconds):
    """Format seconds into a human-readable duration string."""
    seconds = int(seconds)
    if seconds < 0:
        seconds = 0

    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)

    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes:
        parts.append(f"{minutes}m")
    if seconds or not parts:
        parts.append(f"{seconds}s")

    return " ".join(parts)


def handle_die(event):
    """Handle container die event (crash detection + state tracking)."""
    attrs = event.get("Actor", {}).get("Attributes", {})
    container_name = attrs.get("name", "unknown")
    exit_code = attrs.get("exitCode", "?")

    if is_ignored(container_name):
        return

    # Exit 0 = clean shutdown, 143 = SIGTERM (128+15), 137 = SIGKILL (128+9)
    # Both 143 and 137 are normal during docker stop (SIGTERM then SIGKILL after timeout)
    if str(exit_code) in ("0", "137", "143"):
        return

    # Track crash in state file
    now_iso = datetime.now().isoformat()
    prev = crash_state.get(container_name)
    crash_count = (prev["crash_count"] + 1) if prev else 1
    crash_state[container_name] = {
        "exit_code": int(exit_code) if str(exit_code).isdigit() else exit_code,
        "crashed_at": now_iso,
        "crash_count": crash_count,
    }
    save_crash_state()

    if not ALERT_CONTAINER_CRASH:
        return

    print(
        f"[{datetime.now().isoformat()}] Container died: {container_name} (exit {exit_code})",
        flush=True,
    )
    send_alert(
        "container.crash",
        f"\U0001f6a8 <b>Container crash</b>\n\n"
        f"\u25b8 Host:       <code>{HOSTNAME}</code>\n"
        f"\u25b8 Container:  <code>{container_name}</code>\n"
        f"\u25b8 Exit code:  <code>{exit_code}</code>\n"
        f"\u25b8 Time:       {format_timestamp()}"
    )


def handle_start(event):
    """Handle container start event (recovery detection + restart loop detection)."""
    attrs = event.get("Actor", {}).get("Attributes", {})
    container_name = attrs.get("name", "unknown")

    if is_ignored(container_name):
        return

    # --- Recovery detection ---
    if container_name in crash_state:
        crash_info = crash_state.pop(container_name)
        save_crash_state()

        try:
            crashed_at = datetime.fromisoformat(crash_info["crashed_at"])
            duration_secs = (datetime.now() - crashed_at).total_seconds()
            duration_str = format_duration(duration_secs)
        except (KeyError, ValueError):
            duration_str = "unknown"

        now_iso = datetime.now().isoformat()
        print(
            f"[{now_iso}] Container recovered: {container_name} (was crashed for {duration_str})",
            flush=True,
        )
        send_alert(
            "container.recovered",
            f"\u2705 <b>Container recovered</b>\n\n"
            f"\u25b8 Host:       <code>{HOSTNAME}</code>\n"
            f"\u25b8 Container:  <code>{container_name}</code>\n"
            f"\u25b8 Downtime:   <code>{duration_str}</code>\n"
            f"\u25b8 Time:       {format_timestamp()}"
        )

    # --- Restart loop detection ---
    if not ALERT_RESTART_LOOP:
        return

    now = time.monotonic()
    timestamps = restart_timestamps[container_name]
    timestamps.append(now)

    # Prune timestamps outside the window
    cutoff = now - RESTART_LOOP_WINDOW
    restart_timestamps[container_name] = [t for t in timestamps if t > cutoff]

    if len(restart_timestamps[container_name]) >= RESTART_LOOP_THRESHOLD:
        count = len(restart_timestamps[container_name])
        # Reset to avoid repeated alerts for the same burst of starts
        restart_timestamps[container_name] = []

        # Cooldown: a container that keeps looping crosses the threshold every
        # window. Without this it re-alerted every cycle (16 identical
        # critical alerts in 16 minutes). Wall-clock, persisted in STATE_FILE.
        wall_now = time.time()
        last_alert = restart_loop_alerted.get(container_name)
        if last_alert is not None and 0 <= wall_now - last_alert < RESTART_LOOP_COOLDOWN:
            print(
                f"[{datetime.now().isoformat()}] Restart loop: {container_name} ({count} starts in {RESTART_LOOP_WINDOW}s), alert suppressed by cooldown",
                flush=True,
            )
            return
        restart_loop_alerted[container_name] = wall_now
        save_crash_state()

        print(
            f"[{datetime.now().isoformat()}] Restart loop: {container_name} ({count} starts in {RESTART_LOOP_WINDOW}s)",
            flush=True,
        )
        send_alert(
            "container.restart_loop",
            f"\U0001f504 <b>Restart loop detected</b>\n\n"
            f"\u25b8 Host:       <code>{HOSTNAME}</code>\n"
            f"\u25b8 Container:  <code>{container_name}</code>\n"
            f"\u25b8 Restarts:   <code>{count}</code> in {RESTART_LOOP_WINDOW}s\n"
            f"\u25b8 Time:       {format_timestamp()}"
        )


def handle_health_status(event):
    """Handle health_status event (health check failure alerts)."""
    if not ALERT_HEALTHCHECK_FAILURE:
        return

    attrs = event.get("Actor", {}).get("Attributes", {})
    container_name = attrs.get("name", "unknown")
    health_status = event.get("Action", "")

    if is_ignored(container_name):
        return

    # Only alert on unhealthy status
    if "unhealthy" not in health_status:
        return

    # Cooldown: suppress repeated alerts for the same container. The first
    # alert for a container always fires (see health_cooldowns).
    now = time.monotonic()
    last_alert = health_cooldowns.get(container_name)
    if last_alert is not None and now - last_alert < HEALTH_COOLDOWN_SECONDS:
        return

    health_cooldowns[container_name] = now

    print(
        f"[{datetime.now().isoformat()}] Health check failed: {container_name}",
        flush=True,
    )
    send_alert(
        "container.health_check_failed",
        f"\U0001f3e5 <b>Health check failed</b>\n\n"
        f"\u25b8 Host:       <code>{HOSTNAME}</code>\n"
        f"\u25b8 Container:  <code>{container_name}</code>\n"
        f"\u25b8 Time:       {format_timestamp()}"
    )


def main():
    """Watch Docker events and dispatch to handlers."""
    global crash_state
    crash_state = load_crash_state()
    # Rows from a long-dead one-off container must not fire a container.recovered
    # when a new container reuses the name months later.
    if prune_crash_state():
        save_crash_state()
    if crash_state:
        print(
            f"[{datetime.now().isoformat()}] Loaded {len(crash_state)} crashed container(s) from state file",
            flush=True,
        )

    proc = subprocess.Popen(
        [
            "docker", "events",
            "--format", "{{ '{{json .}}' }}",
            "--filter", "event=die",
            "--filter", "event=start",
            "--filter", "event=health_status",
        ],
        stdout=subprocess.PIPE,
        text=True,
    )

    print(f"[{datetime.now().isoformat()}] Docker monitor started", flush=True)

    for line in proc.stdout:
        try:
            event = json.loads(line.strip())
        except json.JSONDecodeError:
            continue

        action = event.get("Action", "")

        if action == "die":
            handle_die(event)
        elif action == "start":
            handle_start(event)
        elif action.startswith("health_status"):
            handle_health_status(event)


if __name__ == "__main__":
    main()
