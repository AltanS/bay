[Unit]
Description=Bay per-service log rotation + prune ({{ '%i' }})
Documentation=https://github.com/AltanS/bay/blob/main/docs/adr/002-log-archival.md
After=docker.service

[Service]
Type=oneshot
UMask=0027
ExecStart={{ log_archive_bin_dir }}/rotate-logs.sh {{ '%i' }} {{ stack_dir }}
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

# Alert credentials come from a root-owned 0600 file, never from an inline
# Environment= line: `systemctl show` prints those to any local user.
EnvironmentFile=-{{ alert_env_path | default('/etc/bay/alert.env') }}
Environment=TELEGRAM_HEADER={{ docker_monitor_alert_header | default('') }}
Environment=BAY_STACK={{ stack_name }}
Environment=BAY_LOG_CHATTR={{ (log_retention_chattr | default(false)) | string | lower }}

# Hardening — rotator needs to write under {{ stack_dir }}/logs/ and
# toggle archiver timer via systemctl.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ stack_dir }}/logs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
