{% set config = {} %}
{% for item in services | default({}) | dict2items | selectattr('value.build', 'defined') %}
{% set svc_name = item.key %}
{% set svc = item.value %}
{% set build = svc.build %}
{% set entry = {"branch": build.branch | default("main")} %}
{% if build.paths is defined %}
{% set paths = {} %}
{% if build.paths.include is defined %}
{% set _ = paths.update({"include": build.paths.include}) %}
{% endif %}
{% if build.paths.exclude is defined %}
{% set _ = paths.update({"exclude": build.paths.exclude}) %}
{% endif %}
{% if paths %}
{% set _ = entry.update({"paths": paths}) %}
{% endif %}
{% endif %}
{#
  The hold keys of an app-repo project (compiler.py `_hold_keys`). The receiver
  passes a push that changes the bay.toml or a mounted file whatever `watch`
  says, so the config-only rule and the hold guard in rebuild.sh see it.
#}
{% if build.bay_toml_path is defined and build.bay_toml_path %}
{% set _ = entry.update({"bay_toml_path": build.bay_toml_path}) %}
{% endif %}
{% if build.bay_toml_files is defined and build.bay_toml_files %}
{% set _ = entry.update({"bay_toml_files": build.bay_toml_files | list}) %}
{% endif %}
{#
  The bay.toml files of the other projects that build from the same repo and
  branch: their push is config only for this project too (rebuild.sh
  `_config_only`), so the receiver passes it as well.
#}
{% set _shared = services | bay_shared_toml_paths(svc_name) %}
{% if _shared %}
{% set _ = entry.update({"shared_toml_paths": _shared}) %}
{% endif %}
{#
  A project without `watch` whose build context is narrower than the repo:
  only the files under it (and its Dockerfile) are build inputs, so a push
  outside it is a no-input-change push (app.py `input_filter`). Absent for
  every other project, whose config stays as before.
#}
{% set _context = build | bay_build_context %}
{% if _context %}
{% set _ = entry.update({"context": _context, "dockerfile": build.dockerfile | default("Dockerfile")}) %}
{% endif %}
{% set _ = entry.update({"regions": svc.regions | default([])}) %}
{% set _ = entry.update({"peer_urls": git_deploy_peer_webhook_urls | default({})}) %}
{% set _ = entry.update({"strategy": build.strategy | default(git_deploy_build_strategy | default('local'))}) %}
{% set _ = config.update({svc_name: entry}) %}
{% endfor %}
{{ config | to_nice_json }}
