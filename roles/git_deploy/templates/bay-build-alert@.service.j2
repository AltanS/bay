# {{ ansible_managed }}
# Fires via OnFailure= when bay-build@<svc> is killed by systemd
# (timeout, OOM, signal). Does NOT fire on normal exit-code failures —
# rebuild.sh handles its own Telegram notifications for those.
[Unit]
Description=Build failure alert - %i

[Service]
Type=oneshot
User={{ app_user }}
# Alert credentials (roles/alert_channel). systemd reads this as PID 1, before
# it drops to User=, so a 0600 root:root file still reaches an unprivileged
# unit. `-` tolerates a host that has not been re-provisioned yet.
EnvironmentFile=-{{ alert_env_path | default('/etc/bay/alert.env') }}
ExecStart={{ stack_dir }}/bin/build-alert.sh %i
