#!/usr/bin/env bash
# {{ ansible_managed }}
# Rebuild and deploy a single service triggered by webhook/systemd
set -euo pipefail
{#-
    publish_flags(cfg) — emit `docker run` -p flags for a service's host-port
    binding. Mirrors deploy_stack/templates/_macros.j2:container_base exactly so
    the pull-signal recreate (GH bay#21) and the local-build webhook recreate
    publish the same bindings the full `deploy_stack` compose path does.
    Without this, a `docker run`-based recreate drops `ports.expose:`/`port:`
    host bindings (PortBindings: {}), breaking tailnet/loopback/host exposure —
    e.g. cross-region service links over the headscale mesh.

    `expose:` is authoritative for the bind IP (string `port:` form defaults to
    loopback). Defined once and called from BOTH docker run blocks below so the
    two recreate paths can't drift.
-#}
{% macro publish_flags(cfg) %}
{% if cfg.port is defined %}
{% set _port_pair = cfg.port | regex_replace('^\\d+\\.\\d+\\.\\d+\\.\\d+:', '') %}
{% set _expose = cfg.expose | default('loopback') %}
{% if _expose == 'loopback' %}
      -p "127.0.0.1:{{ _port_pair }}" \
{% elif _expose == 'tailnet' %}
      -p "{{ gateway_bind_ip }}:{{ _port_pair }}" \
{% elif _expose == 'host' %}
      -p "0.0.0.0:{{ _port_pair }}" \
{% endif %}
{% elif cfg.ports is defined and cfg.ports.expose is defined %}
{% set _internal = cfg.ports.internal %}
{% if cfg.ports.expose == 'loopback' %}
      -p "127.0.0.1:{{ _internal }}:{{ _internal }}" \
{% elif cfg.ports.expose == 'tailnet' %}
      -p "{{ gateway_bind_ip }}:{{ _internal }}:{{ _internal }}" \
{% elif cfg.ports.expose == 'host' %}
      -p "0.0.0.0:{{ _internal }}:{{ _internal }}" \
{% endif %}
{% endif %}
{% endmacro %}

SERVICE="$1"
STACK_DIR="{{ stack_dir }}"
BUILD_DIR="{{ git_deploy_build_dir }}"
IMAGE_PREFIX="{{ git_deploy_image_prefix }}"
REMOTE_BUILD_DIR="{{ git_deploy_remote_build_dir }}"

STATE_DIR="${STACK_DIR}/state"
# Webhook HMAC key, hex-encoded, mode 0600 owner app_user. Written by
# roles/git_deploy/tasks/render_webhook.yml.
WEBHOOK_HMAC_KEY_FILE="{{ stack_dir }}/webhook/hmac.key"
STATE_FILE="${STATE_DIR}/${SERVICE}.json"
CB_MAX_FAILURES={{ git_deploy_cb_max_failures }}
HEALTH_CHECK_TIMEOUT={{ git_deploy_health_check_timeout }}
# The bay_reconcile package every deploy ships to the box (container_lifecycle
# reconcile.yml). The hold guard hashes bay.toml with it, and the receipt stamp
# below writes through it, so the box and the CLI share one implementation.
RECONCILE_PYTHONPATH="${STACK_DIR}/.reconcile"
# The env whose receipt (/var/lib/bay/receipts/<env>.json) this box writes.
# Same expression as the receipt task in container_lifecycle reconcile.yml.
RECEIPT_ENV={{ (target_host | default(group_names | default([]) | reject('equalto', 'all') | first | default('default'))) | string | quote }}
# One file per container: "<commit12> <image id>" for every build whose health
# check failed here. bay_reconcile.codepin refuses those (FAILED_COMMITS_DIR
# there), so `bay up` never promotes a failed image. Created by the deploy
# (container_lifecycle reconcile.yml), group docker, group-writable.
FAILED_COMMITS_DIR="/var/lib/bay/failed-commits"

BAY_ALERT_HEADER={{ docker_monitor_alert_header | to_json }}

# Delivery failures append here (observability contract, Phase 1).
BAY_ALERT_FAILURE_LOG="${STATE_DIR}/telegram-failures.log"
BAY_ALERT_FAILURE_CONTEXT="service=${SERVICE} host=${HOSTNAME}"

# Commit SHA — set later per strategy, used for notification dedup. Always the
# 12-character commit: it is also the image's commit tag.
SHA=""
# Extra `docker run` labels for a webhook recreate (the carried config hash).
EXTRA_LABELS=()

{% include '_notify.sh.j2' %}
HOSTNAME="${BAY_HOST}"

# Build-pipeline notifier. Appends the correlation ID that ties an alert back
# to one specific build, then fans the message out to every configured sink
# via bay_notify. Kept local because the correlation ID is build-specific;
# everything else about delivery lives in the shared snippet above.
notify_build() {
  local alert_id="$1"
  local message="$2"
  [[ -n "${CORR_ID:-}" && "${CORR_ID}" != "unknown" ]] && message+="$(printf '\n\n\xf0\x9f\x94\x97 Correlation ID: %s' "${CORR_ID}")"
  bay_notify "${alert_id}" "${message}"  # bay-alert-id: forwarder
}

format_timestamp() {
  date -u +"%b %d, %H:%M UTC"
}

format_duration() {
  local secs=$(( EPOCHSECONDS - BUILD_START ))
  if [[ $secs -ge 60 ]]; then
    printf '%dm %ds' $((secs / 60)) $((secs % 60))
  else
    printf '%ds' "$secs"
  fi
}

_log() {
  echo "[rebuild] [${CORR_ID:-no-corr}] $*"
}

# ── Circuit breaker state file helpers (schema v1) ──
# Schema v1:
#   {
#     "version": 1,
#     "consecutive_failures": 0,
#     "opened_at": null,
#     "last_failure": null | {sha, stage, reason, at},
#     "alerts": {"opened_sent": false, "last_blocked_alert_at": null}
#   }
# All fields are always present; unknown values are null.

_clean_state_json() {
  printf '{"version":1,"consecutive_failures":0,"opened_at":null,"last_failure":null,"alerts":{"opened_sent":false,"last_blocked_alert_at":null}}'
}

# Read the current CB state and emit v1 JSON on stdout. If the file is
# missing or malformed, emits a clean-state v1 document. Old-shape files
# ({"failures":N,"last_failure":"<iso>","last_notified_sha":"<sha>"}) are
# migrated on read: `failures` -> `consecutive_failures`, the old ISO
# string in `last_failure` -> `last_failure.at`, `last_notified_sha` ->
# `last_failure.sha`. `opened_at` remains null (migration doesn't infer
# trip state), and `alerts.*` default to their clean values.
_read_state() {
  if [[ ! -f "${STATE_FILE}" ]]; then
    _clean_state_json
    return 0
  fi
  # Validate JSON; fall back to clean state if malformed.
  if ! jq empty "${STATE_FILE}" 2>/dev/null; then
    _clean_state_json
    return 0
  fi
  # If the file already has "version", trust it (but fill in any missing
  # fields defensively so callers always see the full shape).
  if jq -e 'has("version")' "${STATE_FILE}" >/dev/null 2>&1; then
    jq -c '
      {
        version: 1,
        consecutive_failures: (.consecutive_failures // 0),
        opened_at: (.opened_at // null),
        last_failure: (.last_failure // null),
        alerts: {
          opened_sent: (.alerts.opened_sent // false),
          last_blocked_alert_at: (.alerts.last_blocked_alert_at // null)
        }
      }
    ' "${STATE_FILE}"
    return 0
  fi
  # Legacy shape — migrate in-place on read.
  jq -c '
    {
      version: 1,
      consecutive_failures: ((.failures // 0) | tonumber? // 0),
      opened_at: null,
      last_failure: (
        if (.last_notified_sha // "") != "" or (.last_failure // "") != "" then
          {
            sha: (.last_notified_sha // ""),
            stage: "",
            reason: "",
            at: (.last_failure // "")
          }
        else
          null
        end
      ),
      alerts: {opened_sent: false, last_blocked_alert_at: null}
    }
  ' "${STATE_FILE}"
}

# Write a JSON state document to ${STATE_FILE} atomically. Reads JSON
# from stdin. Uses the same temp-file + mv pattern as the previous
# _record_failure implementation so readers never see a partial file.
_write_state() {
  mkdir -p "${STATE_DIR}" || true
  local tmpfile="${STATE_FILE}.tmp"
  cat > "${tmpfile}"
  # 0664, not 0644: STATE_DIR is shared with the webhook container via
  # git_deploy_build_group (setgid + g+w). Without the group write bit,
  # render_webhook.yml's one-off re-group task keeps finding this file on every
  # deploy instead of nothing.
  chmod 0664 "${tmpfile}"
  mv -f "${tmpfile}" "${STATE_FILE}"
}

# Record a build failure and decide whether to notify.
# Sends at most 2 notifications per incident: one on first failure,
# one when the circuit breaker trips. Subsequent failures with the same
# commit SHA, stage and (digit-insensitive) reason are silently counted;
# a different stage or error on the same commit still notifies.
#   $1 — commit SHA (empty = always notify, no dedup)
#   $2 — context label / stage (e.g. "Build", "Remote build", "Image pull")
#   $3 — optional detail / reason (e.g. build output tail, shown in <pre> block)
_record_failure() {
  local sha="${1:-}"
  local context="${2:-Deploy}"
  local detail="${3:-}"

  local state notified_sha prev_stage prev_reason current new_count now opened_sent
  state=$(_read_state)
  current=$(printf '%s' "${state}" | jq -r '.consecutive_failures // 0')
  current=${current:-0}
  notified_sha=$(printf '%s' "${state}" | jq -r '.last_failure.sha // ""')
  prev_stage=$(printf '%s' "${state}" | jq -r '.last_failure.stage // ""')
  prev_reason=$(printf '%s' "${state}" | jq -r '.last_failure.reason // ""')
  opened_sent=$(printf '%s' "${state}" | jq -r '.alerts.opened_sent // false')
  new_count=$((current + 1))
  now=$(date -Iseconds)

  # Effective SHA stored in last_failure.sha: if the caller passed one,
  # use it; otherwise carry the previous notified SHA forward.
  local effective_sha="${sha:-${notified_sha}}"

  # Compute opened_at: set on the transition to/at threshold; preserve
  # whatever was there on subsequent failures (in case the breaker is
  # already open and more failures pile on).
  local new_state
  if [[ "${new_count}" -ge "${CB_MAX_FAILURES}" ]]; then
    new_state=$(printf '%s' "${state}" | jq -c \
      --argjson count "${new_count}" \
      --arg sha "${effective_sha}" \
      --arg stage "${context}" \
      --arg reason "${detail}" \
      --arg at "${now}" \
      '
        .version = 1
        | .consecutive_failures = $count
        | .opened_at = (.opened_at // $at)
        | .last_failure = {sha: $sha, stage: $stage, reason: $reason, at: $at}
        | .alerts = (.alerts // {opened_sent: false, last_blocked_alert_at: null})
      ')
  else
    new_state=$(printf '%s' "${state}" | jq -c \
      --argjson count "${new_count}" \
      --arg sha "${effective_sha}" \
      --arg stage "${context}" \
      --arg reason "${detail}" \
      --arg at "${now}" \
      '
        .version = 1
        | .consecutive_failures = $count
        | .opened_at = null
        | .last_failure = {sha: $sha, stage: $stage, reason: $reason, at: $at}
        | .alerts = (.alerts // {opened_sent: false, last_blocked_alert_at: null})
      ')
  fi
  printf '%s' "${new_state}" | _write_state

  # The trigger was consumed (moved to ${SERVICE}.trigger.running) at the start
  # of this run, so there is nothing to remove here. A ${SERVICE}.trigger that
  # exists now was written DURING this run and must survive: it re-fires the
  # path unit once this run ends.

  # Circuit breaker OPEN — notify exactly once per open event.
  # `alerts.opened_sent` is the once-only guard (Phase 3): the very
  # first failure that brings consecutive_failures to threshold fires the
  # alert and flips the bit; any subsequent failures while the breaker
  # remains open re-enter this branch but the Telegram is suppressed so
  # operators don't get spammed. The `_reset_cb` / success path clears the
  # bit back to false so the next open event will alert again.
  if [[ "${new_count}" -ge "${CB_MAX_FAILURES}" ]]; then
    if [[ "${opened_sent}" != "true" ]]; then
      notify_build build.circuit_breaker_open "$(printf '\U0001f6d1 <b>Circuit breaker OPEN</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Failures:   %d consecutive\n\u25b8 Time:       %s\n\nAuto-builds disabled.\nRun: <code>bay build reset %s</code>' \
        "${HOSTNAME}" "${SERVICE}" "${new_count}" "$(format_timestamp)" "${SERVICE}")"
      # Mark opened_sent so future trips during the same open event don't
      # re-spam. Re-read state to capture any concurrent updates from the
      # write above, then atomically merge in the alert flag.
      _read_state | jq -c '.alerts.opened_sent = true' | _write_state
    else
      _log "Circuit breaker re-trip for ${SERVICE} — open-alert already sent, suppressing"
    fi
    return
  fi

  # Same commit AND same failure already notified — suppress duplicate. A
  # different stage or a different error on the same commit is new information
  # and must notify (2026-10-02: four distinct registry push failures on one
  # commit were collapsed into a single alert). Reasons are build-output tails,
  # so digits are stripped and whitespace squeezed before comparing: a changing
  # duration or port must not defeat the suppression.
  local fp_new fp_prev
  fp_new=$(printf '%s' "${detail}" | tr -d '0-9' | tr -s '[:space:]' ' ')
  fp_prev=$(printf '%s' "${prev_reason}" | tr -d '0-9' | tr -s '[:space:]' ' ')
  if [[ -n "${sha}" && "${sha}" == "${notified_sha}" \
     && "${context}" == "${prev_stage}" && "${fp_new}" == "${fp_prev}" ]]; then
    _log "Failure #${new_count} for ${SERVICE} — notification suppressed (same commit ${sha}, same failure)"
    return
  fi

  # First failure for this commit, or a different failure — send notification
  local msg
  msg="$(printf '\U0001f6a8 <b>%s failed</b> (%d/%d)\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>' \
    "${context}" "${new_count}" "${CB_MAX_FAILURES}" "${HOSTNAME}" "${SERVICE}")"
  [[ -n "${sha}" ]] && msg+="$(printf '\n\u25b8 Commit:     <code>%s</code>' "${sha}")"
  msg+="$(printf '\n\u25b8 Time:       %s' "$(format_timestamp)")"
  # `detail` is a raw tail of build output — arbitrary text that routinely
  # contains < and &. Unescaped it produces malformed HTML, which Telegram
  # rejects with a 400, so the whole failure alert is lost exactly when it
  # matters most. Escape before embedding.
  [[ -n "${detail}" ]] && msg+="$(printf '\n\n<pre>%s</pre>' "$(bay_html_escape "${detail}")")"
  notify_build build.failed "${msg}"
}

# Clear the circuit breaker state to a clean schema-v1 document. We
# write a file (rather than rm -f) so `bay build status` can always
# read a queryable "closed" state. The CLI's `bay build reset` still
# rm -f's the file — that's equivalent because `_read_state` on a
# missing file emits the same clean-state defaults.
_reset_cb() {
  _clean_state_json | _write_state
}

# ── Hold guard (docs/build-pipeline.md, "Track, hold and freeze") ──
# Every build is tagged <image>:<commit12>. `:latest` moves, and the container
# is recreated, only when the push may deploy. This prints WHY it may not, or
# nothing when it may:
#   - TRACK=pin: a push only builds; `bay up` deploys.
#   - FROZEN: `bay rollback` froze the env; a push only builds until the next
#     `bay up` to a newer commit.
#   - BAY_TOML_PATH + PINNED_TOML_HASH (only when bay.toml lives in the app
#     repo): the canonical hash of bay.toml at the pushed commit differs from
#     the pinned one, so the push changes config that only `bay up` can deploy.
#     A hash that cannot be computed holds too: never deploy blind.
#   $1  the checkout at the pushed commit
_hold_reason() {
  local repo_dir="$1" have
  if [[ "${TRACK:-branch}" == "pin" ]]; then
    printf 'track = pin: a push only builds, bay up deploys'
    return 0
  fi
  if [[ -n "${FROZEN:-}" ]]; then
    printf 'frozen by bay rollback: a push only builds until the next bay up'
    return 0
  fi
  if [[ -z "${BAY_TOML_PATH:-}" || -z "${PINNED_TOML_HASH:-}" ]]; then
    return 0
  fi
  if [[ ! -f "${repo_dir}/${BAY_TOML_PATH}" ]]; then
    printf 'config changed: %s is gone at this commit' "${BAY_TOML_PATH}"
    return 0
  fi
  if ! have=$(PYTHONPATH="${RECONCILE_PYTHONPATH}" python3 -m bay_reconcile.tomlhash "${repo_dir}/${BAY_TOML_PATH}" 2>&1); then
    printf 'config not checked (%s)' "${have}"
    return 0
  fi
  if [[ "${have}" != "${PINNED_TOML_HASH}" ]]; then
    printf 'config changed: %s differs from the pinned one' "${BAY_TOML_PATH}"
  fi
  return 0
}

# ── Config-only push (docs/build-pipeline.md, "Config-only push") ──
# A push that changes only the project's bay.toml (BAY_TOML_PATH) and the files
# its mounts read (BAY_TOML_FILES, relative to the repo root) carries no code:
# only `bay up` can deploy it. The bay.toml of another project that builds from
# the same repo and branch (SHARED_TOML_PATHS) counts too: it carries no code
# for this project either, and `bay up` pins every project of the repo at its
# head, so this image needs the commit tag as well. True (0) when the files
# changed between the previous commit and HEAD of the checkout are all such
# files, and what the image is built from ([build], image: `tomlhash --section build`) at HEAD still
# hashes to the pinned PINNED_BUILD_HASH. False when the bay.toml is not in the
# app repo, when no previous commit is known or found, when nothing changed, or
# when the build inputs changed or cannot be hashed: then the normal path runs
# (a [build] edit builds, and the hold guard holds it).
#   $1  the checkout at the pushed commit   $2  the previous commit (may be empty)
_config_only() {
  local repo_dir="$1" prev="$2" files f p hit have
  [[ -n "${BAY_TOML_PATH:-}" && -n "${PINNED_BUILD_HASH:-}" && -n "${prev}" ]] || return 1
  git -C "${repo_dir}" cat-file -e "${prev}^{commit}" 2>/dev/null || return 1
  files=$(git -C "${repo_dir}" diff --name-only "${prev}" HEAD 2>/dev/null) || return 1
  [[ -n "${files}" ]] || return 1
  while IFS= read -r f; do
    [[ -z "${f}" ]] && continue
    hit=""
    for p in "${BAY_TOML_PATH}" "${BAY_TOML_FILES[@]}" "${SHARED_TOML_PATHS[@]}"; do
      if [[ "${f}" == "${p}" || "${f}" == "${p}"/* ]]; then
        hit=1
        break
      fi
    done
    [[ -n "${hit}" ]] || return 1
  done <<< "${files}"
  have=$(PYTHONPATH="${RECONCILE_PYTHONPATH}" python3 -m bay_reconcile.tomlhash --section build "${repo_dir}/${BAY_TOML_PATH}" 2>/dev/null) || return 1
  [[ "${have}" == "${PINNED_BUILD_HASH}" ]] || return 1
  return 0
}

# The commit the running container was built from (its com.bay.commit label),
# or nothing.
#   $1  container
_running_commit() {
  local c
  c=$(docker inspect --format '{% raw %}{{index .Config.Labels "com.bay.commit"}}{% endraw %}' "$1" 2>/dev/null || true)
  [[ "${c}" == "<no value>" ]] && c=""
  printf '%s' "${c}"
}

# The previous commit of the config-only check: the commit the running container
# was built from (its com.bay.commit label), else the commit the checkout was at
# before this run's pull or fetch moved it, else nothing. A container created
# before 2.1.0 has no label, so the checkout says what was built last. That is
# only a candidate: _config_only_source still needs the image of that commit.
# A config-only push recreates nothing, so such a container keeps having no
# label; this fallback stays in use until a build deploys (and labels it).
#   $1  container   $2  the checkout's HEAD before this run's pull or fetch (may be empty)
_previous_commit() {
  local c
  c=$(_running_commit "$1")
  printf '%s' "${c:-$2}"
}

# Local builds share one checkout per repo and branch (CHECKOUT_SERVICES). The
# first service's run of a push pulls it, so for the next service the checkout's
# HEAD is already the pushed commit, and its config-only check would see no
# change. So each service keeps its own mark, the ref refs/bay/seen/<service>:
# the commit the checkout was at after that service's last pull (_mark_seen).
# _seen_head runs before the pull. It first gives every service of the checkout
# that has no mark yet the current HEAD (what that service's own run would read
# now), then prints this service's mark: the checkout's HEAD before the pull,
# as this service last saw it. A fresh clone has no marks: the current HEAD.
#   $1  the checkout
_seen_head() {
  local repo_dir="$1" head s
  head=$(git -C "${repo_dir}" rev-parse --short=12 HEAD 2>/dev/null) || return 0
  for s in "${CHECKOUT_SERVICES[@]}"; do
    git -C "${repo_dir}" rev-parse -q --verify "refs/bay/seen/${s}^{commit}" >/dev/null 2>&1 \
      || git -C "${repo_dir}" update-ref "refs/bay/seen/${s}" HEAD >/dev/null 2>&1 \
      || true
  done
  git -C "${repo_dir}" rev-parse -q --short=12 --verify "refs/bay/seen/${SERVICE}^{commit}" 2>/dev/null \
    || printf '%s' "${head}"
}

# After the pull: this service has seen the checkout at its new HEAD.
#   $1  the checkout
_mark_seen() {
  git -C "$1" update-ref "refs/bay/seen/${SERVICE}" HEAD >/dev/null 2>&1 || true
}

# True when both name the same commit: hex, one a prefix of the other, the
# shorter at least 7 characters.
_same_commit() {
  [[ "$1" =~ ^[0-9a-f]{7,40}$ && "$2" =~ ^[0-9a-f]{7,40}$ ]] || return 1
  [[ "$1" == "$2"* || "$2" == "$1"* ]]
}

# The image a config-only push names with the pushed commit, printed as a ref,
# or return 1: then the push is not config only and the normal path builds it.
# First <repo>:<prev12>, the previous commit's own tag. A build from before
# 2.1.0 has no such tag, so else <repo>:latest, but only when it holds the
# previous commit's code. The checkout also moves on a build that failed, and
# naming the older :latest image with the pushed commit would make `bay up`
# deploy old code as new. So :latest counts when:
#   - its com.bay.commit (else org.opencontainers.image.revision) label names
#     the previous commit (a label that names another commit refuses), or
#   - local builds only, it has no label (built before 2.1.0): the circuit
#     breaker shows no failure since the last good build, neither the commit
#     nor the image is in the failed-commits record, and the running container
#     (when there is one) runs this very image.
# The build server always needs the label: remote builds set it since 0.9.
# Local builds look in docker; remote builds look in the registry.
#   $1  image repo (no tag)   $2  the previous commit   $3  container
_config_only_source() {
  local repo="$1" prev="$2" svc="$3" info id label run fails
  if [[ "${BUILD_STRATEGY:-local}" == "remote" ]]; then
    if docker manifest inspect "${repo}:${prev:0:12}" >/dev/null 2>&1; then
      printf '%s' "${repo}:${prev:0:12}"
      return 0
    fi
    info=$(docker buildx imagetools inspect --format '{% raw %}{{json .Image}}{% endraw %}' "${repo}:latest" 2>/dev/null) || return 1
    label=$(printf '%s' "${info}" | jq -r '[.. | objects | select(has("Labels")) | .Labels | objects | (.["com.bay.commit"] // .["org.opencontainers.image.revision"])] | map(select(. != null and . != "")) | .[0] // ""' 2>/dev/null) || return 1
    _same_commit "${label}" "${prev}" || return 1
    printf '%s' "${repo}:latest"
    return 0
  fi
  if docker image inspect "${repo}:${prev:0:12}" >/dev/null 2>&1; then
    printf '%s' "${repo}:${prev:0:12}"
    return 0
  fi
  # The whole JSON, not --format: a Go template that names .Config.Labels fails
  # on an image built without any label.
  info=$(docker image inspect "${repo}:latest" 2>/dev/null) || return 1
  id=$(printf '%s' "${info}" | jq -r '.[0].Id // ""' 2>/dev/null) || return 1
  label=$(printf '%s' "${info}" | jq -r '.[0].Config.Labels // {} | (.["com.bay.commit"] // .["org.opencontainers.image.revision"] // "")' 2>/dev/null) || return 1
  [[ -n "${id}" ]] || return 1
  if [[ -f "${FAILED_COMMITS_DIR}/${svc}" ]] \
     && awk -v c="${prev:0:12}" -v i="${id}" '$1 == c || $2 == i { f = 1 } END { exit !f }' "${FAILED_COMMITS_DIR}/${svc}" 2>/dev/null; then
    return 1
  fi
  if [[ -n "${label}" ]]; then
    _same_commit "${label}" "${prev}" || return 1
  else
    fails=$(_read_state | jq -r '.consecutive_failures // 0' 2>/dev/null) || return 1
    [[ "${fails}" == "0" ]] || return 1
    run=$(docker inspect --format '{% raw %}{{.Image}}{% endraw %}' "${svc}" 2>/dev/null || true)
    [[ -z "${run}" || "${run}" == "${id}" ]] || return 1
  fi
  printf '%s' "${id}"
}

# End a config-only push: no build, no :latest move, no recreate, no alert, the
# circuit breaker untouched; the trigger was consumed at the start of the run.
# The code is the previous commit's, so its image also gets this commit's tag
# (a tag, never a build): `bay up` (and track = "pin") then finds <image>:<commit12>.
# When the image came from :latest (_config_only_source), it also gets
# <image>:<prev12>, so the next push finds the previous commit by its tag.
# Returns 1, before it changes anything, when there is no image of the previous
# commit: the caller then runs the normal path.
#   $1  image repo (no tag; may be empty)   $2  the previous commit
_config_only_push() {
  local repo="$1" prev="$2" src=""
  if [[ -n "${repo}" && -n "${prev}" ]]; then
    src=$(_config_only_source "${repo}" "${prev}" "${SERVICE}") || return 1
  fi
  trap - ERR
  if [[ -n "${src}" ]]; then
    local tag_err="" tag_ok=1 out
    if [[ "${BUILD_STRATEGY:-local}" == "remote" ]]; then
      if [[ "${src}" == "${repo}:${prev:0:12}" ]]; then
        out=$(docker buildx imagetools create --prefer-index=false -t "${repo}:${SHA}" "${src}" 2>&1 >/dev/null) || { tag_ok=0; tag_err+="${out}"; }
      else
        out=$(docker buildx imagetools create --prefer-index=false -t "${repo}:${SHA}" -t "${repo}:${prev:0:12}" "${src}" 2>&1 >/dev/null) || { tag_ok=0; tag_err+="${out}"; }
      fi
    else
      out=$(docker tag "${src}" "${repo}:${SHA}" 2>&1) || { tag_ok=0; tag_err+="${out}"; }
      if [[ "${src}" != "${repo}:${prev:0:12}" ]]; then
        out=$(docker tag "${src}" "${repo}:${prev:0:12}" 2>&1) || { tag_ok=0; tag_err+="${out}"; }
      fi
    fi
    # A tag that was not made leaves `bay up` without <image>:<commit12>: this
    # is a failed push, not a config-only one. Nothing is built.
    if [[ "${tag_ok}" == "0" ]]; then
      _log "config-only push ${SHA}: tag failed"
      _record_failure "${SHA}" "Config-only tag" "tagging ${src} as ${repo}:${SHA} failed: $(printf '%s' "${tag_err}" | tail -c 400)"
      exit 1
    fi
  fi
  echo "[rebuild] [${CORR_ID:-no-corr}] config-only push ${SHA}: run bay up"
  exit 0
}

# A held build is not a failure. The image stays under its commit tag, `:latest`
# and the running container are not touched, the circuit breaker is not touched
# (no _record_failure, no _reset_cb), and the trigger was consumed at the start
# of the run. One build.held alert says what to do. Always exits 0.
#   $1  the reason _hold_reason printed   $2  the image ref the build left
_hold_build() {
  local reason="$1" image="$2" todo
  trap - ERR
  case "${reason}" in
    "config not checked"*) todo="config not checked, run bay up" ;;
    config*) todo="config changed, run bay up" ;;
    track*)  todo="track = pin, run bay up to deploy it" ;;
    *)       todo="frozen by bay rollback, run bay up to deploy it" ;;
  esac
  _log "HOLD ${SERVICE} at ${SHA:-unknown}: ${reason}; image ${image}, :latest not moved, container not recreated"
  notify_build build.held "$(printf '⏸️ <b>Build held</b>\n\n▸ Host:       <code>%s</code>\n▸ Service:    <code>%s</code>\n▸ Commit:     <code>%s</code>\n▸ Image:      <code>%s</code>\n▸ Reason:     %s\n▸ Time:       %s\n\n%s' \
    "${HOSTNAME}" "${SERVICE}" "${SHA:-unknown}" "${image}" "$(bay_html_escape "${reason}")" "$(format_timestamp)" "${todo}")"
  exit 0
}

# Move `:latest` to this commit's image and keep the old one as `:previous` for
# the health-check rollback. Only called once the hold guard let the push deploy.
# When `:latest` already is that image (a rebuild of the running commit),
# `:previous` stays: moving it would make the rollback target the image under
# test.
#   $1  image repo (no tag)   $2  commit tag
_promote_latest() {
  local repo="$1" sha="$2" have want
  have=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "${repo}:latest" 2>/dev/null || true)
  want=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "${repo}:${sha}" 2>/dev/null || true)
  if [[ -z "${have}" || "${have}" != "${want}" ]]; then
    docker tag "${repo}:latest" "${repo}:previous" 2>/dev/null || true
  fi
  docker tag "${repo}:${sha}" "${repo}:latest"
}

# ── Release (bay.toml `release`, docs/build-pipeline.md "Release") ──
# Runs the service's release command once, in a one-shot container of the image
# that is about to go live, while the old container still serves. A service
# without `release` has no _run_release and passes straight through. A failure
# is a failed build: the circuit breaker counts it, build.failed alerts, `:latest`
# does not move and the old container keeps running.
#   $1  the new image   $2  a tag to point back at $3 on failure (optional)
_release_or_fail() {
  local image="$1" back_tag="${2:-}" back_id="${3:-}" out rc=0 owner
  declare -F _run_release >/dev/null || return 0
  _log "Release for ${SERVICE} with ${image}"
  out=$(mktemp)
  _run_release "${image}" >"${out}" 2>&1 || rc=$?
  if [[ ${rc} -eq 0 ]]; then
    rm -f "${out}"
    _log "Release for ${SERVICE} done"
    return 0
  fi
  # A timeout kills the docker client, not the container: remove it here, but
  # only a container this service's release made (its label names the service).
  owner=$(docker inspect -f '{% raw %}{{index .Config.Labels "com.bay.release-of"}}{% endraw %}' "${SERVICE}-release" 2>/dev/null || true)
  if [[ "${owner}" == "${SERVICE}" ]]; then
    docker rm -f "${SERVICE}-release" >/dev/null 2>&1 || true
  fi
  if [[ -n "${back_tag}" && -n "${back_id}" ]]; then
    docker tag "${back_id}" "${back_tag}" 2>/dev/null || true
  fi
  local why="exit ${rc}"
  [[ ${rc} -eq 124 ]] && why="timed out after {{ bay_release_timeout | default(600) }}s"
  _log "Release for ${SERVICE} failed (${why}); :latest not moved, old container kept"
  _record_failure "${SHA}" "Release" "${why}: $(tail -c 400 "${out}")"
  rm -f "${out}"
  trap - ERR
  exit 1
}

# ── Failed builds (docs/build-pipeline.md, "Health check and rollback") ──
# A build whose health check failed must never run again by its commit tag:
# `bay up` and `bay rollback --to` find code by `<image>:<commit12>`. Untag it
# (the image itself may stay under other tags) and record "<commit12> <image
# id>" in FAILED_COMMITS_DIR/<container>. The record matters for a registry
# image, whose commit tag codepin could pull again, and for a later tag of the
# same image (a config-only push names the previous image with its own commit).
#   $1  container   $2  the failed build's commit tag ref (may be empty)
_forget_failed_build() {
  local svc="$1" failed_tag="$2" commit id
  [[ -n "${failed_tag}" ]] || return 0
  commit="${failed_tag##*:}"
  id=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "${failed_tag}" 2>/dev/null || true)
  docker rmi "${failed_tag}" >/dev/null 2>&1 || true
  if ! { mkdir -p "${FAILED_COMMITS_DIR}" && printf '%s %s\n' "${commit:0:12}" "${id:--}" >> "${FAILED_COMMITS_DIR}/${svc}"; } 2>/dev/null; then
    _log "could not record failed commit ${commit:0:12} in ${FAILED_COMMITS_DIR}/${svc}; its tag is removed"
  fi
  return 0
}

# A commit that deployed and passed its health check is no longer failed (a
# manual rebuild of a commit whose first failure was not its code).
#   $1  container   $2  commit
_clear_failed_commit() {
  local file="${FAILED_COMMITS_DIR}/$1"
  [[ "$2" =~ ^[0-9a-f]{7,40}$ && -f "${file}" ]] || return 0
  sed -i "/^${2:0:12}\( \|\$\)/d" "${file}" 2>/dev/null || true
  return 0
}

# The config hash the last deploy stamped on the running container, or nothing.
# The webhook recreate runs the config of that deploy, so it carries the label
# over: the next `bay up` then plans a noop, not a recreate for
# `no config-hash label`.
_config_hash_of() {
  local h
  h=$(docker inspect --format '{% raw %}{{index .Config.Labels "com.bay.config-hash"}}{% endraw %}' "$1" 2>/dev/null || true)
  [[ "${h}" == "<no value>" ]] && h=""
  printf '%s' "${h}"
}

# Record in this env's receipt which commit and image the container runs now
# (`bay status`, `bay plan`). A failure is a log line, never a failed deploy:
# the container is already running.
#   $1  container   $2  commit (may be empty)   $3  image ref
_stamp_receipt() {
  if ! PYTHONPATH="${RECONCILE_PYTHONPATH}" python3 -m bay_reconcile.receipt stamp \
      --env "${RECEIPT_ENV}" --name "$1" --commit "$2" --image "$3" >/dev/null 2>&1; then
    _log "receipt not stamped for $1 (no receipt for ${RECEIPT_ENV} yet, or no write access)"
  fi
  return 0
}

# What the container just started runs, for the receipt. The start is by tag:
# the reconciler reads a moved tag through the reference a container was
# started with. So compare the image the container runs with the image ID the
# tag had right after the promotion (the build lock should keep them equal).
# The same image: the pushed commit. Another image: one log line, and the
# started image's own commit label, or no commit when it has none; never the
# pushed commit, and no failed-build record for it.
# Sets STARTED_ID, STARTED_COMMIT, STARTED_REF (the receipt's image) and
# STARTED_FAILED_TAG (the commit tag a failed health check untags).
#   $1  container   $2  the promoted image ID   $3  the pushed commit (may be empty)
#   $4  the pushed commit's image ref (may be empty)   $5  the tag the container
#       was started from
_started_commit() {
  local promoted="$2" info label started
  STARTED_ID=$(docker inspect --format '{% raw %}{{.Image}}{% endraw %}' "$1" 2>/dev/null || true)
  if [[ -n "${STARTED_ID}" && "${STARTED_ID}" == "${promoted}" ]]; then
    STARTED_COMMIT="$3"
    STARTED_REF="${4:-$5}"
    STARTED_FAILED_TAG="${3:+$4}"
    return 0
  fi
  STARTED_COMMIT=""
  STARTED_REF="$5"
  STARTED_FAILED_TAG=""
  info=$(docker image inspect "${STARTED_ID:-none}" 2>/dev/null || true)
  label=$(printf '%s' "${info}" | jq -r '.[0].Config.Labels // {} | (.["com.bay.commit"] // .["org.opencontainers.image.revision"] // "")' 2>/dev/null || true)
  [[ "${label}" =~ ^[0-9a-f]{7,64}$ ]] && STARTED_COMMIT="${label:0:12}"
  started="${STARTED_ID#sha256:}"
  promoted="${promoted#sha256:}"
  _log "started image differs from promoted :latest: started ${started:0:12}, promoted ${promoted:0:12}; receipt commit ${STARTED_COMMIT:-none} (the started image's label)"
  return 0
}

# Poll container health after restart. Returns 0 if healthy, 1 if failed.
# For containers with HEALTHCHECK: waits for healthy/unhealthy status.
# For containers without: polls State.Running repeatedly to catch crash loops.
# Consecutive-unhealthy guard: requires 2 consecutive unhealthy reads before
# returning 1. A single unhealthy read during Docker's StartPeriod window
# may be a transient inspect race (Docker 29.x quirk) — one extra read with
# a 2s gap is enough to distinguish a real failure from a race condition.
_wait_healthy() {
  local name="$1" timeout="${2:-${HEALTH_CHECK_TIMEOUT}}"
  local deadline running health checks=0 unhealthy_count=0
  deadline=$(( $(date +%s) + timeout ))

  # Initial settle time
  sleep 2

  while [[ $(date +%s) -lt $deadline ]]; do
    running=$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' "$name" 2>/dev/null || echo "false")
    if [[ "$running" != "true" ]]; then
      _log "Container ${name} is not running (exited or crashed)"
      return 1
    fi

    health=$(docker inspect --format '{% raw %}{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}' "$name" 2>/dev/null || echo "unknown")

    case "$health" in
      healthy)
        unhealthy_count=0
        _log "Container ${name} is healthy"
        return 0
        ;;
      unhealthy)
        unhealthy_count=$(( unhealthy_count + 1 ))
        if [[ $unhealthy_count -ge 2 ]]; then
          _log "Container ${name} is unhealthy (${unhealthy_count} consecutive reads)"
          return 1
        fi
        _log "Container ${name}: transient unhealthy read (${unhealthy_count}/2) — continuing"
        sleep 2
        ;;
      none)
        unhealthy_count=0
        # No healthcheck defined — require multiple consecutive running checks
        # to catch crash loops (container restarts between checks)
        checks=$((checks + 1))
        if [[ $checks -ge 3 ]]; then
          _log "Container ${name} is running (no healthcheck, ${checks} consecutive checks passed)"
          return 0
        fi
        sleep 2
        ;;
      starting|*)
        unhealthy_count=0
        sleep 2
        ;;
    esac
  done

  # Timeout — check final state
  running=$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' "$name" 2>/dev/null || echo "false")
  if [[ "$running" == "true" ]]; then
    health=$(docker inspect --format '{% raw %}{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}' "$name" 2>/dev/null || echo "unknown")
    if [[ "$health" == "starting" || "$health" == "none" ]]; then
      _log "Container ${name} still starting after ${timeout}s — treating as healthy"
      return 0
    fi
  fi

  _log "Health check timed out for ${name} after ${timeout}s"
  return 1
}

# Roll back to previous image after a failed health check.
# Stops the failed container, retags :previous, restarts, and verifies.
# Always exits the script (never returns to caller).
#   $1 — container/service name
#   $2 — previous image tag (e.g., IMAGE_NAME:previous or IMAGE_REPO:previous)
#   $3 — current image tag (e.g., IMAGE_NAME:latest or IMAGE_REF)
#   $4 — the failed build's commit tag (IMAGE_NAME:SHA, IMAGE_REPO:<revision>);
#        untagged and recorded so `bay up` never promotes it (may be empty)
_handle_rollback() {
  local svc="$1" prev_tag="$2" current_tag="$3" failed_tag="${4:-}"

  # Disable ERR trap — we're handling the failure ourselves
  trap - ERR

  _log "Health check failed for ${svc} — attempting rollback"
  docker stop "${svc}" 2>/dev/null || true
  docker rm "${svc}" 2>/dev/null || true
  _forget_failed_build "${svc}" "${failed_tag}"

  # Check if previous image exists locally
  if ! docker image inspect "${prev_tag}" &>/dev/null; then
    _record_failure "${SHA}" "Health check" "No previous image available for rollback"
    notify_build build.health_check_failed "$(printf '\U0001f6a8 <b>Health check FAILED</b> — no rollback available\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nManual intervention required.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    exit 1
  fi

  # Capture :latest digest before retag so we can restore it if rollback also fails.
  # TODO: remove this retag + restore pattern once _run_container accepts an explicit image-ref arg.
  local latest_digest
  latest_digest=$(docker inspect --format '{% raw %}{{.Id}}{% endraw %}' "${current_tag}" 2>/dev/null || echo "")

  # Retag previous image as current
  docker tag "${prev_tag}" "${current_tag}"

  # Restart with previous image (uses _run_container defined in per-service block)
  if ! _run_container; then
    _record_failure "${SHA}" "Rollback" "Failed to start container with previous image"
    notify_build build.rollback_failed "$(printf '\U0001f6d1 <b>ROLLBACK FAILED</b> — container would not start\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nManual intervention required.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    # Restore :latest to pre-rollback digest so tags don't converge on broken image
    if [[ -n "${latest_digest}" ]]; then
      docker tag "${latest_digest}" "${current_tag}" 2>/dev/null || true
    fi
    exit 1
  fi

  # Verify rollback health
  if ! _wait_healthy "${svc}" "${HEALTH_CHECK_TIMEOUT}"; then
    docker stop "${svc}" 2>/dev/null || true
    docker rm "${svc}" 2>/dev/null || true
    _record_failure "${SHA}" "Rollback" "Previous image also failed health check"
    notify_build build.rollback_failed "$(printf '\U0001f6d1 <b>ROLLBACK FAILED</b> — previous image also unhealthy\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nBoth new and previous images failed.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    # Restore :latest to pre-rollback digest so tags don't converge on broken image
    if [[ -n "${latest_digest}" ]]; then
      _log "Rollback health check failed — restored :latest to pre-rollback digest ${latest_digest}"
      docker tag "${latest_digest}" "${current_tag}" 2>/dev/null || true
    fi
    exit 1
  fi

  # Rollback succeeded — service is running on previous image.
  # _record_failure has just run, so consecutive_failures is up to date.
  # Append a CB-state preview to the operator-facing Telegram so they can
  # see how close the breaker is to tripping (Phase 3, contract
  # exit-path map row 4).
  _record_failure "${SHA}" "Health check" "Rolled back to previous image"
  _rb_count=$(_read_state | jq -r '.consecutive_failures // 0')
  _rb_count=${_rb_count:-0}
  _rb_cb_line=""
  if [[ "${_rb_count}" -lt "${CB_MAX_FAILURES}" ]]; then
    _rb_cb_line="$(printf '\n\n\u26a0\ufe0f Circuit breaker at %d/%d — next failure will block pushes.\nReset: <code>bay build reset %s</code>' \
      "${_rb_count}" "${CB_MAX_FAILURES}" "${svc}")"
  fi
  _rb_failed_line=""
  if [[ -n "${failed_tag}" ]]; then
    _rb_failed_line="$(printf '\nCommit <code>%s</code> is marked failed on this host: bay up will not deploy its image.' \
      "$(bay_html_escape "${failed_tag##*:}")")"
  fi
  notify_build build.rolled_back "$(printf '\u23ea <b>Rolled back to previous</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Reason:     health check failed after %ds\n\u25b8 Time:       %s\n\nService is running on previous image.%s\nInvestigate: <code>docker logs %s --tail 50</code>%s' \
    "${HOSTNAME}" "${svc}" "${HEALTH_CHECK_TIMEOUT}" "$(format_timestamp)" "${_rb_failed_line}" "${svc}" "${_rb_cb_line}")"
  exit 1
}

_deploy_failed() {
  _record_failure "${SHA}" "Webhook deploy"
}
trap '_deploy_failed' ERR

BUILD_START="${EPOCHSECONDS}"

# ── Read correlation ID and detect pull signal from trigger file ──
# Trigger file format (v2): line 1 = corr_id (UUID4), line 2 = signal ("pull" or empty),
# optional line 3 = revision, optional line 4 = built_at (epoch seconds)
# Legacy format (v1): single line "pull" or empty — CORR_ID set to "unknown"
# Manual trigger (no trigger file): CORR_ID set to "manual-<epoch>"
# Lines 3 and 4 (optional, pull signals only): the commit the build server
# pushed (EXPECTED_REVISION) and the epoch second its build finished
# (BUILT_AT). Triggers without them still work; the revision check is skipped.
#
# The trigger is CONSUMED here: moved atomically to <trigger>.running. The
# path unit watches <trigger> with PathExists, so a trigger written while this
# run is busy lands on a free name and fires the unit again after this run
# ends. The old flow deleted the trigger in ExecStartPost, which also deleted
# any trigger written mid-run. The .running file is removed on exit (EXIT trap
# here, ExecStopPost in bay-build@.service for a SIGKILL or timeout).
TRIGGER_FILE="${STACK_DIR}/triggers/${SERVICE}.trigger"
RUNNING_FILE="${TRIGGER_FILE}.running"
CORR_ID="unknown"
PULL_SIGNAL=0
EXPECTED_REVISION=""
BUILT_AT=""
if [[ -f "${TRIGGER_FILE}" ]] && mv -f "${TRIGGER_FILE}" "${RUNNING_FILE}" 2>/dev/null; then
  trap 'rm -f "${RUNNING_FILE}"' EXIT
  CORR_ID=$(sed -n '1p' "${RUNNING_FILE}" 2>/dev/null || echo "unknown")
  [[ -z "${CORR_ID}" ]] && CORR_ID="unknown"
  PULL_SIGNAL_RAW=$(sed -n '2p' "${RUNNING_FILE}" 2>/dev/null || echo "")
  EXPECTED_REVISION=$(sed -n '3p' "${RUNNING_FILE}" 2>/dev/null | tr -d '\r' || true)
  BUILT_AT=$(sed -n '4p' "${RUNNING_FILE}" 2>/dev/null | tr -d '\r' || true)
  [[ "${EXPECTED_REVISION}" =~ ^[0-9a-fA-F]{7,64}$ ]] || EXPECTED_REVISION=""
  [[ "${BUILT_AT}" =~ ^[0-9]{1,12}$ ]] || BUILT_AT=""
  # Legacy 1-line format: line 1 was "pull" — detect and handle
  if [[ "${CORR_ID}" == "pull" && -z "${PULL_SIGNAL_RAW}" ]]; then
    CORR_ID="unknown"
    PULL_SIGNAL_RAW="pull"
  fi
  if [[ "${PULL_SIGNAL_RAW}" == "pull" ]]; then
    PULL_SIGNAL=1
    echo "[rebuild] [${CORR_ID}] Pull signal detected for ${SERVICE}"
  fi
else
  # No trigger file — manually invoked rebuild
  CORR_ID="manual-${EPOCHSECONDS}"
fi

_log "Starting rebuild for ${SERVICE} at $(date -Iseconds)"

{#
  Two quoting helpers for the per-service config below. Read before editing.

  `dq(v)` escapes a value for a bash DOUBLE-quoted assignment: backslash
  first, then `$`, backtick and `"`. Without it a repo, branch, dockerfile or
  context holding `$(...)` was a command substitution that ran at assignment
  time, as the build user, on every rebuild.

  `evq(v)` is for the three command strings that are later handed to `eval`.
  Escaping for the assignment is not enough there: eval re-parses the VALUE,
  so the value itself has to carry shell quoting. `| quote` produces that
  quoting and `dq` then protects it from the assignment. Both layers are
  needed; either alone is a hole.
#}
{% macro dq(v) %}{{ v | string | replace('\\', '\\\\') | replace('$', '\\$') | replace('`', '\\`') | replace('"', '\\"') }}{% endmacro %}
{% macro evq(v) %}{{ dq(v | string | quote) }}{% endmacro %}
# ── Per-service build config (rendered at deploy time) ──
# git_deploy_rebuild_services includes local builds, remote builds,
# and pull-only services (non-builder image consumers).
{% set _build_services = [] %}
{% set _pull_only_services = [] %}
{% for svc_name in git_deploy_rebuild_services %}
{% if services[svc_name].build is defined %}
{% set _ = _build_services.append(svc_name) %}
{% else %}
{% set _ = _pull_only_services.append(svc_name) %}
{% endif %}
{% endfor %}
{% set _dedup = services | bay_build_dedup_map(_build_services) %}
{% set _is_first = namespace(val=true) %}
{% for svc_name in _build_services %}
{% set svc = services[svc_name] %}
{% set build = svc.build %}
{% set branch = build.branch | default('main') %}
{% set dockerfile = build.dockerfile | default('Dockerfile') %}
{% set context = build.context | default('.') %}
{% set image_name = git_deploy_image_prefix ~ '-' ~ svc_name %}
{% set raw_strategy = build.strategy | default(git_deploy_build_strategy | default('local')) %}
{% set strategy = 'remote' if raw_strategy == 'push' else raw_strategy %}
{% set slug = build.repo | bay_repo_slug(branch) %}
{% set has_token = build.token is defined %}
{#
  The clone URL carries NO credential. It used to embed the PAT as the URL
  password, rendered into this script and then
  run through `eval`, which made the PAT an argv element of every git child
  process — readable in /proc/*/cmdline by any local user — and wrote it
  permanently into .git/config on the first fetch.

  The PAT now reaches git through a GIT_ASKPASS helper that Ansible renders
  separately (roles/git_deploy/templates/git-askpass.sh.j2, mode 0700, owner
  app_user): clone_repos.yml writes one per repo group, remote_build.yml one
  per remote-built service. The paths below must match those two tasks.
#}
{% if has_token %}
{% set repo_url = build.repo %}
{% if repo_url.startswith('git@') %}
{% set parts = repo_url.split(':') %}
{% set host = parts[0] | replace('git@', '') %}
{% set path = parts[1] %}
{% set clone_url = 'https://' ~ host ~ '/' ~ path %}
{% elif '://' in repo_url %}
{% set proto_rest = repo_url.split('://') %}
{% set clone_url = 'https://' ~ proto_rest[1] %}
{% else %}
{% set clone_url = repo_url %}
{% endif %}
{% else %}
{% set clone_url = build.repo %}
{% endif %}
{% set askpass_remote = git_deploy_remote_build_dir ~ '/.git-askpass-' ~ svc_name %}
{% set askpass_local = git_deploy_build_dir ~ '/.git-askpass-' ~ slug %}
