# ── Circuit breaker ──
# When the breaker is OPEN, blocking the push silently was the 2026-04-16
# incident path: pushes returned exit 0 with only a journald log line, so
# operators chasing webhook traces saw nothing. Phase 3 now emits
# a rate-limited Telegram alert here — at most once per
# CB_BLOCKED_ALERT_INTERVAL_SEC — using `alerts.last_blocked_alert_at` as
# the last-sent epoch timestamp.
CB_BLOCKED_ALERT_INTERVAL_SEC=3600

_cb_state=$(_read_state)
_cb_count=$(printf '%s' "${_cb_state}" | jq -r '.consecutive_failures // 0')
_cb_count=${_cb_count:-0}

if [[ "${_cb_count}" -ge "${CB_MAX_FAILURES}" ]]; then
  _log "Circuit breaker OPEN for ${SERVICE} (${_cb_count} consecutive failures)"
  _log "Run 'bay build reset ${SERVICE}' after fixing the issue, then push again."

  # Read alert metadata from state. `last_blocked_alert_at` may be null
  # (never alerted) or an epoch-seconds integer.
  _cb_last_alert=$(printf '%s' "${_cb_state}" | jq -r '.alerts.last_blocked_alert_at // 0')
  _cb_last_alert=${_cb_last_alert:-0}
  # jq emits "null" as the string "null" without `// 0` — guard anyway in
  # case state is partial.
  if [[ "${_cb_last_alert}" == "null" || -z "${_cb_last_alert}" ]]; then
    _cb_last_alert=0
  fi
  _cb_now=$(date +%s)
  _cb_age=$(( _cb_now - _cb_last_alert ))

  if [[ "${_cb_age}" -ge "${CB_BLOCKED_ALERT_INTERVAL_SEC}" ]]; then
    _cb_reason=$(printf '%s' "${_cb_state}" | jq -r '.last_failure.reason // "(unknown)"')
    _cb_opened_at=$(printf '%s' "${_cb_state}" | jq -r '.opened_at // "(unknown)"')
    # Truncate reason to 200 chars for Telegram; full text stays in state.
    {% raw %}if [[ "${#_cb_reason}" -gt 200 ]]; then
      _cb_reason="${_cb_reason:0:200}…"
    fi
{% endraw %}
    notify_build build.push_blocked "$(printf '\u26a0\ufe0f <b>Push blocked — circuit breaker OPEN</b>\n\n\u25b8 Host:          <code>%s</code>\n\u25b8 Service:       <code>%s</code>\n\u25b8 Failures:      %d consecutive\n\u25b8 Opened at:     <code>%s</code>\n\u25b8 Last reason:   <pre>%s</pre>\n\u25b8 Time:          %s\n\nAuto-builds remain disabled. Re-alerts at most once per hour.\nRun: <code>bay build reset %s</code>' \
      "${HOSTNAME}" "${SERVICE}" "${_cb_count}" "${_cb_opened_at}" "$(bay_html_escape "${_cb_reason}")" "$(format_timestamp)" "${SERVICE}")"
    # Stamp last_blocked_alert_at so the next blocked push within the
    # window is silenced. Re-read state to avoid clobbering concurrent
    # writes from a second invocation racing on the same trigger.
    _read_state | jq -c --argjson at "${_cb_now}" '.alerts.last_blocked_alert_at = $at' | _write_state
  else
    _log "Suppressed CB blocked-push alert for ${SERVICE} (last sent ${_cb_age}s ago, interval ${CB_BLOCKED_ALERT_INTERVAL_SEC}s)"
  fi
  exit 0
fi

# ── Cross-service build serialization (issue #9) ──
# Multiple bay-build@*.path units can fire in the same instant — most
# commonly from a monorepo push that matches several services' path globs.
# Without serialization, two rebuild.sh runs hit the shared
# buildx_buildkit_argo-builder0 container concurrently and OOM-kill it.  # legacy-argo: live buildx builder name on hosts, migrate separately
# fd-based flock here means the kernel releases the lock on process exit
# (no stale-lockfile cleanup needed). A 1-hour timeout bounds deadlocks if
# any single build legitimately hangs that long.
#
# Note: the per-repo flock further down (${REPO_DIR}/.git/rebuild.lock)
# remains as a defensive inner layer — it's now redundant under this lock
# but cheap, and survives if anyone ever loosens or scopes the global lock.
{% set _build_lock_path = git_deploy_build_lock_path | default(stack_dir ~ '/build.lock') %}
{% set _build_lock_timeout = git_deploy_build_lock_timeout | default(3600) %}
if ! { exec 9>"{{ _build_lock_path }}"; } 2>/dev/null; then  # brace group scopes 2>/dev/null to the open; bare `exec >f 2>/dev/null` silences the shell's stderr permanently
  _log "Cannot open build lock {{ _build_lock_path }} — aborting (check directory ownership)"
  trap - ERR
  exit 1
fi
_lock_wait_start=${EPOCHSECONDS}
_log "Waiting for build lock ({{ _build_lock_path }})"
if ! flock -x -w {{ _build_lock_timeout }} 9; then
  _log "Lock wait timed out after {{ _build_lock_timeout }}s — aborting"
  notify_build build.lock_timeout "$(printf '⏱️ <b>Build lock timeout</b>\n\n▸ Host:       <code>%s</code>\n▸ Service:    <code>%s</code>\n▸ Waited:     %ds\n▸ Time:       %s\n\nA concurrent build held the lock longer than the timeout. Investigate hung builds: <code>journalctl -u bay-build@* --since '\''2 hours ago'\''</code>' \
    "${HOSTNAME}" "${SERVICE}" "{{ _build_lock_timeout }}" "$(format_timestamp)")"
  trap - ERR
  exit 1
fi
_lock_waited=$(( EPOCHSECONDS - _lock_wait_start ))
_log "Lock acquired (waited ${_lock_waited}s)"

# ── Pull signal: pull image from registry and restart container ──
# Triggered by the build server after a successful remote build+push.
# Skips the build entirely — just pull the new image and restart.
if [[ "${PULL_SIGNAL}" -eq 1 && -n "${IMAGE_REF}" ]]; then
  _log "Pulling ${IMAGE_REF} from registry"
  if ! docker pull "${IMAGE_REF}"; then
    _record_failure "" "Image pull"
    trap - ERR
    exit 1
  fi

  # Tag running container's image as :previous for rollback
  _PREV_DIGEST=$(docker inspect --format '{% raw %}{{.Image}}{% endraw %}' "${SERVICE}" 2>/dev/null || true)
  if [[ -n "${_PREV_DIGEST}" ]]; then
    docker tag "${_PREV_DIGEST}" "${IMAGE_REPO}:previous" 2>/dev/null || true
    _log "Tagged running image as ${IMAGE_REPO}:previous for rollback"
  fi

  # Restart container with the new image
  docker stop "${SERVICE}" 2>/dev/null || true
  docker rm "${SERVICE}"   2>/dev/null || true

{% set _pull_ns = namespace(first=true) %}
{% for svc_name in git_deploy_rebuild_services %}
{% set svc = services[svc_name] %}
{% set _has_build = svc.build is defined %}
{% set _is_remote = false %}
{% if _has_build %}
{% set _raw = svc.build.strategy | default(git_deploy_build_strategy | default('local')) %}
{% set _is_remote = (_raw == 'remote' or _raw == 'push') %}
{% endif %}
{% set _is_pull_eligible = (_is_remote and svc.image is defined) or (not _has_build and svc.image is defined) %}
{% if _is_pull_eligible %}
{% set _tc = {
  'traefik_docker_network': traefik_docker_network | default('services'),
  'traefik_security_headers_enabled': traefik_security_headers_enabled | default(true),
  'traefik_compress_enabled': traefik_compress_enabled | default(true),
  'traefik_error_pages_enabled': traefik_error_pages_enabled | default(false),
  'traefik_rate_limit_average': traefik_rate_limit_average | default(100),
  'traefik_rate_limit_burst': traefik_rate_limit_burst | default(50),
  'traefik_rate_limit_period': traefik_rate_limit_period | default('1s'),
  'traefik_in_flight_req_amount': traefik_in_flight_req_amount | default(100),
  'traefik_circuit_breaker_expression': traefik_circuit_breaker_expression | default('NetworkErrorRatio() > 0.5'),
  'traefik_retry_attempts': traefik_retry_attempts | default(4),
  'stack_name': stack_name | default('bay'),
} %}
{% if not _pull_ns.first %}el{% endif %}if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
  _run_container() {
    docker run -d \
      --name "{{ svc_name }}" \
      --hostname "{{ svc_name }}" \
      --restart unless-stopped \
{% if svc.network_mode is defined %}
      --network "{{ svc.network_mode }}" \
{% else %}
      --network "{{ traefik_docker_network | default('services') }}" \
{% endif %}
{% if svc.env is defined or svc.database is defined %}
      --env-file "${STACK_DIR}/env/{{ svc_name }}.env" \
{% endif %}
{{ publish_flags(svc) -}}
{% for vol in svc.volumes | default([]) | bay_prefix_volumes(stack_name | default('bay')) %}
      -v "{{ vol }}" \
{% endfor %}
{% if svc.mem_limit is defined %}
      --memory "{{ svc.mem_limit }}" \
{% endif %}
{% for k, v in (svc | bay_traefik_labels(svc_name, _tc)).items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      -l 'bay.managed=true' \
      -l 'bay.stack={{ stack_name }}' \
{% set _wt_labels = (svc['update'] | default('monitor')) | bay_watchtower_labels(watchtower_enabled | default(false)) %}
{% for k, v in _wt_labels.items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      "${IMAGE_REF}"{{ ' ' ~ svc.command if svc.command is defined else '' }}
  }
{% set _pull_ns.first = false %}
{% endif %}
{% endfor %}
{% if not _pull_ns.first %}
  fi
{% endif %}

  _run_container

  if ! _wait_healthy "${SERVICE}" "${HEALTH_CHECK_TIMEOUT}"; then
    _handle_rollback "${SERVICE}" "${IMAGE_REPO}:previous" "${IMAGE_REF}"
  fi

  _reset_cb

  _log "Pull deploy complete for ${SERVICE} at $(date -Iseconds)"
  notify_build deploy.pull_complete "$(printf '\u2705 <b>Pull deploy complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s' \
    "${HOSTNAME}" "${SERVICE}" "${IMAGE_REF}" "$(format_duration)" "$(format_timestamp)")"
  exit 0
fi

# ── Pull-only guard ──
# Pull-only services (no build: block) can only be triggered by pull signals.
# If we reach here without a pull signal, something is wrong — skip gracefully.
if [[ "${BUILD_STRATEGY}" == "pull_only" ]]; then
  _log "Service ${SERVICE} is pull-only but no pull signal detected — skipping"
  exit 0
fi

# ── Strategy routing ──
if [[ "${BUILD_STRATEGY}" == "remote" ]]; then
  # ── Remote strategy: fetch, build, push to registry ──
  # No container restart — deployment servers pull via S2 fan-out.

  # Ensure clone directory exists
  mkdir -p "$(dirname "${REPO_DIR}")"

  # Clone if repo doesn't exist yet
  if [[ ! -d "${REPO_DIR}/.git" ]]; then
    _log "Cloning repository for ${SERVICE}"
    _CLONE_STDERR=$(eval "${CLONE_CMD}" 2>&1)
    _CLONE_EXIT=$?
    if [[ ${_CLONE_EXIT} -ne 0 ]]; then
      if grep -q "403" <<<"${_CLONE_STDERR}"; then
        _log "clone failed (HTTP 403)"
        _log "  repo: ${CLONE_REPO}"
        _log "  token: ${CLONE_TOKEN_KEY}"
        _log "hint: verify the PAT has Contents:Read (fine-grained) or repo (classic) scope."
      else
        echo "${_CLONE_STDERR}" >&2
      fi
      exit ${_CLONE_EXIT}
    fi
  fi

  # Acquire repo lock
  exec 200>"${REPO_DIR}/.git/rebuild.lock"
  flock -x 200
  _log "Acquired repo lock for ${SERVICE}"

  # Fetch + reset (force-push safe)
  cd "${REPO_DIR}"
  _FETCH_STDERR=$(eval "${FETCH_CMD}" 2>&1)
  _FETCH_EXIT=$?
  if [[ ${_FETCH_EXIT} -ne 0 ]]; then
    if grep -q "403" <<<"${_FETCH_STDERR}"; then
      _log "clone failed (HTTP 403)"
      _log "  repo: ${CLONE_REPO}"
      _log "  token: ${CLONE_TOKEN_KEY}"
      _log "hint: verify the PAT has Contents:Read (fine-grained) or repo (classic) scope."
    else
      echo "${_FETCH_STDERR}" >&2
    fi
    exit ${_FETCH_EXIT}
  fi
  git reset --hard FETCH_HEAD

  # Get commit SHA (12-char for registry tags, matching remote_build.yml)
  SHA=$(git rev-parse --short=12 HEAD)

  # Check if image already exists in registry for this SHA
  if docker manifest inspect "${IMAGE_REPO}:${SHA}" &>/dev/null && docker manifest inspect "${IMAGE_REF}" &>/dev/null; then
    _log "Image ${IMAGE_REPO}:${SHA} and ${IMAGE_REF} already in registry, skipping build"
  else
    # Write build secrets to temp files
    SECRETS_DIR="${REMOTE_BUILD_DIR}/.secrets"
    mkdir -p "${SECRETS_DIR}"
    chmod 700 "${SECRETS_DIR}"
    SECRET_FLAGS=""
    for key in "${!BUILD_SECRETS[@]}"; do
      TMPFILE="${SECRETS_DIR}/${SERVICE}-${key}"
      printf '%s' "${BUILD_SECRETS[$key]}" > "${TMPFILE}"
      chmod 600 "${TMPFILE}"
      SECRET_FLAGS="${SECRET_FLAGS} --secret id=${key},src=${TMPFILE}"
    done

    # Build
    _log "Building ${IMAGE_REPO}:${SHA} (CONTEXT=${CONTEXT} REPO_DIR=${REPO_DIR} PWD=$(pwd))"
    ls -la "${CONTEXT}" 2>&1 | head -5 || _log "WARNING: build context '${CONTEXT}' not found"
    BUILD_OUTPUT=$(mktemp)
    if ! docker buildx build \
      --builder {{ bay_buildx_builder }} \
      --provenance=false \
      --push \
{% if git_deploy_registry_cache | default(false) %}
      --cache-from "type=registry,ref=${IMAGE_REPO}:buildcache" \
      --cache-to "type=registry,ref=${IMAGE_REPO}:buildcache,mode=max" \
{% endif %}
      -t "${IMAGE_REPO}:${SHA}" \
      -t "${IMAGE_REF}" \
      -f "${DOCKERFILE}" \
      "${BUILD_ARGS[@]}" \
      ${SECRET_FLAGS} \
      "${CONTEXT}" 2>&1 | tee "${BUILD_OUTPUT}"; then
      TAIL_OUTPUT=$(tail -c 500 "${BUILD_OUTPUT}")
      _record_failure "${SHA}" "Remote build" "${TAIL_OUTPUT}"
      rm -f "${BUILD_OUTPUT}"
      # Clean up secret temp files
      for key in "${!BUILD_SECRETS[@]}"; do
        rm -f "${SECRETS_DIR}/${SERVICE}-${key}"
      done
      trap - ERR
      exit 1
    fi
    rm -f "${BUILD_OUTPUT}"

    # buildx exported both tags straight to the registry above, so there is
    # no separate push step and no image left in the local daemon store.
    _log "Pushed ${IMAGE_REPO}:${SHA} and ${IMAGE_REF} to registry"

    # Trim old local content-hash tags left behind by earlier releases
    # (which exported the image into the local daemon) so
    # the build server doesn't accumulate ~1 GB per push indefinitely. The
    # Ansible-side cleanup in remote_build.yml only fires on `bay deploy`
    # — webhook auto-builds (this path) never hit it, which is how the
    # 2026-04-17 76%-disk incident happened. Keeps `latest` + newest N
    # content-hash tags (default {{ git_deploy_build_keep_tags | default(3) }}),
    # skips anything a running container references.
    KEEP_TAGS="{{ git_deploy_build_keep_tags | default(3) }}"
    if [[ "${KEEP_TAGS}" -gt 0 ]]; then
      _log "Pruning old local content-hash tags for ${IMAGE_REPO} (keep=${KEEP_TAGS})"
      RUNNING_REFS=$(docker ps --format '{{ '{{' }}.Image{{ '}}' }}' 2>/dev/null || true)
      # Build a newline-delimited list of repo-scoped tags currently used by
      # running containers, stripped of the repo: prefix so it matches the
      # tag column emitted below.
      RUNNING_TAGS=$(printf '%s\n' "${RUNNING_REFS}" \
        | grep -E "^${IMAGE_REPO}:" 2>/dev/null \
        | sed "s|^${IMAGE_REPO}:||" \
        || true)
      # List non-latest, non-dangling tags newest-first. --format emits
      # `<tag>|<createdat>`; sort -t'|' -k2 -r orders by CreatedAt desc.
      CANDIDATES=$(docker images "${IMAGE_REPO}" \
        --format '{{ '{{' }}.Tag{{ '}}' }}|{{ '{{' }}.CreatedAt{{ '}}' }}' 2>/dev/null \
        | grep -v '^latest|' \
        | grep -v '^<none>|' \
        | sort -t'|' -k2 -r \
        | cut -d'|' -f1 || true)
      # Filter out tags used by running containers (defensive; docker rmi
      # itself also refuses such images).
      if [[ -n "${RUNNING_TAGS}" ]]; then
        CANDIDATES=$(printf '%s\n' "${CANDIDATES}" \
          | grep -vxF -f <(printf '%s\n' "${RUNNING_TAGS}") \
          || true)
      fi
      TO_REMOVE=$(printf '%s\n' "${CANDIDATES}" | tail -n +$((KEEP_TAGS + 1)))
      if [[ -n "${TO_REMOVE}" ]]; then
        while IFS= read -r tag; do
          [[ -z "${tag}" ]] && continue
          if docker rmi "${IMAGE_REPO}:${tag}" >/dev/null 2>&1; then
            _log "  pruned ${IMAGE_REPO}:${tag}"
          fi
        done <<< "${TO_REMOVE}"
      fi
    fi

    # Clean up secret temp files
    for key in "${!BUILD_SECRETS[@]}"; do
      rm -f "${SECRETS_DIR}/${SERVICE}-${key}"
    done
  fi

  # Release repo lock
  exec 200>&-

  _reset_cb

  _log "Completed remote build for ${SERVICE} at $(date -Iseconds)"
  notify_build build.remote_complete "$(printf '\u2705 <b>Remote build complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Commit:     <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s\n\nNotifying deployment servers to pull.' \
    "${HOSTNAME}" "${SERVICE}" "${SHA}" "${IMAGE_REF}" "$(format_duration)" "$(format_timestamp)")"

  # ── Fan-out image-level pull signals to deployment servers ──
  # After a successful build+push, POST to each region's /webhook/pull-image
  # with the image ref in the body. Each region pulls the image once and
  # restarts all local containers using it.
  # Uses associative arrays for image->region mapping, computed from all
  # services sharing each built image across all regions.
{% set _image_region_map = services | bay_image_region_map(git_deploy_rebuild_services) %}
{% set _peer_urls = git_deploy_peer_webhook_urls | default({}) %}
{% if _image_region_map and _peer_urls %}
  # Image-to-region mapping (computed at deploy time)
  declare -A IMAGE_REGIONS=(
{% for image_ref, regions in _image_region_map.items() %}
    ["{{ image_ref }}"]="{{ regions | join(' ') }}"
{% endfor %}
  )

  # Peer webhook URLs
  declare -A PEER_URLS=(
{% for region_name, region_url in _peer_urls.items() %}
    ["{{ region_name }}"]="{{ region_url | regex_replace('/$', '') }}"
{% endfor %}
  )

  if [[ -n "${IMAGE_REF}" && -n "${IMAGE_REGIONS[${IMAGE_REF}]+_}" ]]; then
    for region in ${IMAGE_REGIONS[${IMAGE_REF}]}; do
      if [[ -n "${PEER_URLS[${region}]+_}" ]]; then
        PULL_URL="${PEER_URLS[${region}]}/webhook/pull-image"
        PULL_BODY='{"image":"'"${IMAGE_REF}"'"}'
        _log "Sending image-level pull signal to ${region} for ${IMAGE_REF}"
        # The MAC key comes out of a 0600 file, hex-encoded. The raw webhook
        # secret used to be rendered into this script as an openssl argument.
        HMAC_KEY_HEX=$(cat "${WEBHOOK_HMAC_KEY_FILE}")
        HMAC_SIG=$(printf '%s' "${PULL_BODY}" | openssl dgst -sha256 -mac HMAC -macopt hexkey:"${HMAC_KEY_HEX}" -binary | xxd -p -c 256)
        if curl -sf -X POST \
          --connect-timeout 10 \
          --max-time 30 \
          -H "Content-Type: application/json" \
          -H "X-Hub-Signature-256: sha256=${HMAC_SIG}" \
          -H "X-Bay-Pull-Signal: 1" \
          -d "${PULL_BODY}" \
          "${PULL_URL}"; then
          _log "Pull signal sent to ${region} for ${IMAGE_REF} successfully"
        else
          _log "WARNING: Pull signal to ${region} for ${IMAGE_REF} failed"
          notify_build build.fanout_failed "$(printf '\u26a0\ufe0f <b>Pull fan-out failed</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Peer:       <code>%s</code>\n\u25b8 URL:        <code>%s</code>\n\u25b8 Time:       %s' \
            "${HOSTNAME}" "${SERVICE}" "${IMAGE_REF}" "${region}" "${PULL_URL}" "$(format_timestamp)")"
        fi
      fi
    done
  fi
{% endif %}

  # Exit here — no container restart for remote strategy on build server.
  exit 0
fi

# ── Local strategy: build and restart on this server ──

# ── Acquire repo lock (serializes pull + build for shared repos) ──
# Uses fd-based flock so variables set inside are available afterward.
# When two services share a repo and both webhooks fire, the second
# waits here until the first finishes building — then S2 dedup kicks
# in and retags from the primary instead of rebuilding.
exec 200>"${REPO_DIR}/.git/rebuild.lock"
flock -x 200
_log "Acquired repo lock for ${SERVICE}"

# ── Pull latest code ──
cd "${REPO_DIR}"
eval "${PULL_CMD}"

# ── Get new commit SHA ──
SHA=$(git rev-parse --short HEAD)

# ── Check if image already exists for this SHA ──
if docker image inspect "${IMAGE_NAME}:${SHA}" &>/dev/null; then
  _log "Image ${IMAGE_NAME}:${SHA} already exists, skipping build"
elif [[ -n "${PRIMARY_IMAGE}" ]] && docker image inspect "${PRIMARY_IMAGE}:${SHA}" &>/dev/null; then
  _log "Re-tagging from primary ${PRIMARY_IMAGE}:${SHA} (build dedup)"
  docker tag "${PRIMARY_IMAGE}:${SHA}" "${IMAGE_NAME}:${SHA}"
  docker tag "${IMAGE_NAME}:${SHA}" "${IMAGE_NAME}:latest"
else
  # Write build secrets to temp files
  SECRET_FLAGS=""
  for key in "${!BUILD_SECRETS[@]}"; do
    TMPFILE="/tmp/build-secret-${SERVICE}-${key}"
    printf '%s' "${BUILD_SECRETS[$key]}" > "${TMPFILE}"
    chmod 600 "${TMPFILE}"
    SECRET_FLAGS="${SECRET_FLAGS} --secret id=${key},src=${TMPFILE}"
  done

  # Re-tag current :latest as :previous (ignore if no :latest)
  docker tag "${IMAGE_NAME}:latest" "${IMAGE_NAME}:previous" 2>/dev/null || true

  # Build
  _log "Building ${IMAGE_NAME}:${SHA} (CONTEXT=${CONTEXT} REPO_DIR=${REPO_DIR} PWD=$(pwd))"
  ls -la "${CONTEXT}" 2>&1 | head -5 || _log "WARNING: build context '${CONTEXT}' not found"
  BUILD_OUTPUT=$(mktemp)
  if ! docker buildx build \
    --builder {{ bay_buildx_builder }} \
    --load \
    -t "${IMAGE_NAME}:${SHA}" \
    -f "${DOCKERFILE}" \
    "${BUILD_ARGS[@]}" \
    ${SECRET_FLAGS} \
    "${CONTEXT}" 2>&1 | tee "${BUILD_OUTPUT}"; then
    TAIL_OUTPUT=$(tail -c 500 "${BUILD_OUTPUT}")
    _record_failure "${SHA}" "Build" "${TAIL_OUTPUT}"
    rm -f "${BUILD_OUTPUT}"
    # Clean up secret temp files on failure
    for key in "${!BUILD_SECRETS[@]}"; do
      rm -f "/tmp/build-secret-${SERVICE}-${key}"
    done
    # Disable ERR trap to avoid duplicate notification
    trap - ERR
    exit 1
  fi
  rm -f "${BUILD_OUTPUT}"

  # Tag as :latest
  docker tag "${IMAGE_NAME}:${SHA}" "${IMAGE_NAME}:latest"

  # Clean up secret temp files
  for key in "${!BUILD_SECRETS[@]}"; do
    rm -f "/tmp/build-secret-${SERVICE}-${key}"
  done
fi

# ── Release repo lock before restart ──
exec 200>&-

# ── Restart with new image ──
# Stop and remove old container, then recreate directly.
# Brief downtime is acceptable for developer-triggered rebuilds.
# The next Ansible deploy will manage the container via container_lifecycle.
docker stop "${SERVICE}" 2>/dev/null || true
docker rm "${SERVICE}"   2>/dev/null || true

{% for svc_name in git_deploy_services %}
{% set svc = services[svc_name] %}
{% set _tc = {
  'traefik_docker_network': traefik_docker_network | default('services'),
  'traefik_security_headers_enabled': traefik_security_headers_enabled | default(true),
  'traefik_compress_enabled': traefik_compress_enabled | default(true),
  'traefik_error_pages_enabled': traefik_error_pages_enabled | default(false),
  'traefik_rate_limit_average': traefik_rate_limit_average | default(100),
  'traefik_rate_limit_burst': traefik_rate_limit_burst | default(50),
  'traefik_rate_limit_period': traefik_rate_limit_period | default('1s'),
  'traefik_in_flight_req_amount': traefik_in_flight_req_amount | default(100),
  'traefik_circuit_breaker_expression': traefik_circuit_breaker_expression | default('NetworkErrorRatio() > 0.5'),
  'traefik_retry_attempts': traefik_retry_attempts | default(4),
  'stack_name': stack_name | default('bay'),
} %}
{% if not loop.first %}el{% endif %}if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
  _run_container() {
    docker run -d \
      --name "{{ svc_name }}" \
      --hostname "{{ svc_name }}" \
      --restart unless-stopped \
{% if svc.network_mode is defined %}
      --network "{{ svc.network_mode }}" \
{% else %}
      --network "{{ traefik_docker_network | default('services') }}" \
{% endif %}
{% if svc.env is defined or svc.database is defined %}
      --env-file "${STACK_DIR}/env/{{ svc_name }}.env" \
{% endif %}
{{ publish_flags(svc) -}}
{% for vol in svc.volumes | default([]) | bay_prefix_volumes(stack_name | default('bay')) %}
      -v "{{ vol }}" \
{% endfor %}
{% if svc.mem_limit is defined %}
      --memory "{{ svc.mem_limit }}" \
{% endif %}
{% for k, v in (svc | bay_traefik_labels(svc_name, _tc)).items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      -l 'bay.managed=true' \
      -l 'bay.stack={{ stack_name }}' \
{% set _wt_labels = (svc['update'] | default('monitor')) | bay_watchtower_labels(watchtower_enabled | default(false)) %}
{% for k, v in _wt_labels.items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      "${IMAGE_NAME}:latest"{{ ' ' ~ svc.command if svc.command is defined else '' }}
  }
{% endfor %}
{% if git_deploy_services | length > 0 %}
fi
{% endif %}

_run_container

if ! _wait_healthy "${SERVICE}" "${HEALTH_CHECK_TIMEOUT}"; then
  _handle_rollback "${SERVICE}" "${IMAGE_NAME}:previous" "${IMAGE_NAME}:latest"
fi

_reset_cb

# ── Fan-out: trigger alias rebuilds for dedup groups ──
# When a primary service builds, its aliases just retag from the primary
# image. Write CORR_ID into each alias trigger so log correlation survives
# the fan-out (readers set CORR_ID=[unknown] from an empty trigger file).
#
# Alias trigger format: line 1 = CORR_ID only. We intentionally OMIT
# line 2 (the pull signal) — the primary trigger drives the image build
# on this host, and aliases piggyback on the same local image via the
# dedup retag at the top of the script. Emitting "pull" here would route
# aliases through the registry-pull path, which is wrong (nothing has
# been pushed to the registry for local-strategy builds).
#
# Write atomically: temp file + mv -f so the path-unit watcher that fires
# bay-build@<alias>.service never observes a partial/empty trigger.
{% for svc_name in git_deploy_services %}
{% if _dedup[svc_name].primary and _dedup[svc_name].group_size > 1 %}
if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
{% for other_svc in git_deploy_services %}
{% if not _dedup[other_svc].primary and _dedup[other_svc].primary_svc == svc_name %}
  _log "Fan-out: triggering alias {{ other_svc }}"
  _alias_trigger="${STACK_DIR}/triggers/{{ other_svc }}.trigger"
  _alias_tmp="${_alias_trigger}.tmp.$$"
  printf '%s\n' "${CORR_ID}" > "${_alias_tmp}" && mv -f "${_alias_tmp}" "${_alias_trigger}"
{% endif %}
{% endfor %}
fi
{% endif %}
{% endfor %}

_log "Completed rebuild for ${SERVICE} at $(date -Iseconds)"
notify_build deploy.webhook_complete "$(printf '\u2705 <b>Webhook deploy complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Commit:     <code>%s</code>\n\u25b8 Image:      <code>%s:latest</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s' \
  "${HOSTNAME}" "${SERVICE}" "${SHA}" "${IMAGE_NAME}" "$(format_duration)" "$(format_timestamp)")"
exit 0
