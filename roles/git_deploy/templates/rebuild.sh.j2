      -l 'bay.stack={{ stack_name }}' \
{% set _wt_labels = (svc['update'] | default('monitor')) | bay_watchtower_labels(watchtower_enabled | default(false)) %}
{% for k, v in _wt_labels.items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
