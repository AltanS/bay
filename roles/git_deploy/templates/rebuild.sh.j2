#!/usr/bin/env bash
# {{ ansible_managed }}
# Rebuild and deploy a single service triggered by webhook/systemd
set -euo pipefail
{#-
    publish_flags(cfg) — emit `docker run` -p flags for a service's host-port
    binding. Mirrors deploy_stack/templates/_macros.j2:container_base exactly so
    the pull-signal recreate (GH bay#21) and the local-build webhook recreate
    publish the same bindings the full `deploy_stack` compose path does.
    Without this, a `docker run`-based recreate drops `ports.expose:`/`port:`
    host bindings (PortBindings: {}), breaking tailnet/loopback/host exposure —
    e.g. cross-region service links over the headscale mesh.

    `expose:` is authoritative for the bind IP (string `port:` form defaults to
    loopback). Defined once and called from BOTH docker run blocks below so the
    two recreate paths can't drift.
-#}
{% macro publish_flags(cfg) %}
{% if cfg.port is defined %}
{% set _port_pair = cfg.port | regex_replace('^\\d+\\.\\d+\\.\\d+\\.\\d+:', '') %}
{% set _expose = cfg.expose | default('loopback') %}
{% if _expose == 'loopback' %}
      -p "127.0.0.1:{{ _port_pair }}" \
{% elif _expose == 'tailnet' %}
      -p "{{ gateway_bind_ip }}:{{ _port_pair }}" \
{% elif _expose == 'host' %}
      -p "0.0.0.0:{{ _port_pair }}" \
{% endif %}
{% elif cfg.ports is defined and cfg.ports.expose is defined %}
{% set _internal = cfg.ports.internal %}
{% if cfg.ports.expose == 'loopback' %}
      -p "127.0.0.1:{{ _internal }}:{{ _internal }}" \
{% elif cfg.ports.expose == 'tailnet' %}
      -p "{{ gateway_bind_ip }}:{{ _internal }}:{{ _internal }}" \
{% elif cfg.ports.expose == 'host' %}
      -p "0.0.0.0:{{ _internal }}:{{ _internal }}" \
{% endif %}
{% endif %}
{% endmacro %}

SERVICE="$1"
STACK_DIR="{{ stack_dir }}"
BUILD_DIR="{{ git_deploy_build_dir }}"
IMAGE_PREFIX="{{ git_deploy_image_prefix }}"
REMOTE_BUILD_DIR="{{ git_deploy_remote_build_dir }}"

STATE_DIR="${STACK_DIR}/state"
# Webhook HMAC key, hex-encoded, mode 0600 owner app_user. Written by
# roles/git_deploy/tasks/webhook.yml.
WEBHOOK_HMAC_KEY_FILE="{{ stack_dir }}/webhook/hmac.key"
STATE_FILE="${STATE_DIR}/${SERVICE}.json"
CB_MAX_FAILURES={{ git_deploy_cb_max_failures }}
HEALTH_CHECK_TIMEOUT={{ git_deploy_health_check_timeout }}

BAY_ALERT_HEADER={{ docker_monitor_alert_header | to_json }}

# Delivery failures append here (observability contract, Phase 1).
BAY_ALERT_FAILURE_LOG="${STATE_DIR}/telegram-failures.log"
BAY_ALERT_FAILURE_CONTEXT="service=${SERVICE} host=${HOSTNAME}"

# Commit SHA — set later per strategy, used for notification dedup
SHA=""

{% include '_notify.sh.j2' %}
HOSTNAME="${BAY_HOST}"

# Build-pipeline notifier. Appends the correlation ID that ties an alert back
# to one specific build, then fans the message out to every configured sink
# via bay_notify. Kept local because the correlation ID is build-specific;
# everything else about delivery lives in the shared snippet above.
notify_build() {
  local alert_id="$1"
  local message="$2"
  [[ -n "${CORR_ID:-}" && "${CORR_ID}" != "unknown" ]] && message+="$(printf '\n\n\xf0\x9f\x94\x97 Correlation ID: %s' "${CORR_ID}")"
  bay_notify "${alert_id}" "${message}"  # bay-alert-id: forwarder
}

format_timestamp() {
  date -u +"%b %d, %H:%M UTC"
}

format_duration() {
  local secs=$(( EPOCHSECONDS - BUILD_START ))
  if [[ $secs -ge 60 ]]; then
    printf '%dm %ds' $((secs / 60)) $((secs % 60))
  else
    printf '%ds' "$secs"
  fi
}

_log() {
  echo "[rebuild] [${CORR_ID:-no-corr}] $*"
}

# ── Circuit breaker state file helpers (schema v1) ──
# Schema v1:
#   {
#     "version": 1,
#     "consecutive_failures": 0,
#     "opened_at": null,
#     "last_failure": null | {sha, stage, reason, at},
#     "alerts": {"opened_sent": false, "last_blocked_alert_at": null}
#   }
# All fields are always present; unknown values are null.

_clean_state_json() {
  printf '{"version":1,"consecutive_failures":0,"opened_at":null,"last_failure":null,"alerts":{"opened_sent":false,"last_blocked_alert_at":null}}'
}

# Read the current CB state and emit v1 JSON on stdout. If the file is
# missing or malformed, emits a clean-state v1 document. Old-shape files
# ({"failures":N,"last_failure":"<iso>","last_notified_sha":"<sha>"}) are
# migrated on read: `failures` -> `consecutive_failures`, the old ISO
# string in `last_failure` -> `last_failure.at`, `last_notified_sha` ->
# `last_failure.sha`. `opened_at` remains null (migration doesn't infer
# trip state), and `alerts.*` default to their clean values.
_read_state() {
  if [[ ! -f "${STATE_FILE}" ]]; then
    _clean_state_json
    return 0
  fi
  # Validate JSON; fall back to clean state if malformed.
  if ! jq empty "${STATE_FILE}" 2>/dev/null; then
    _clean_state_json
    return 0
  fi
  # If the file already has "version", trust it (but fill in any missing
  # fields defensively so callers always see the full shape).
  if jq -e 'has("version")' "${STATE_FILE}" >/dev/null 2>&1; then
    jq -c '
      {
        version: 1,
        consecutive_failures: (.consecutive_failures // 0),
        opened_at: (.opened_at // null),
        last_failure: (.last_failure // null),
        alerts: {
          opened_sent: (.alerts.opened_sent // false),
          last_blocked_alert_at: (.alerts.last_blocked_alert_at // null)
        }
      }
    ' "${STATE_FILE}"
    return 0
  fi
  # Legacy shape — migrate in-place on read.
  jq -c '
    {
      version: 1,
      consecutive_failures: ((.failures // 0) | tonumber? // 0),
      opened_at: null,
      last_failure: (
        if (.last_notified_sha // "") != "" or (.last_failure // "") != "" then
          {
            sha: (.last_notified_sha // ""),
            stage: "",
            reason: "",
            at: (.last_failure // "")
          }
        else
          null
        end
      ),
      alerts: {opened_sent: false, last_blocked_alert_at: null}
    }
  ' "${STATE_FILE}"
}

# Write a JSON state document to ${STATE_FILE} atomically. Reads JSON
# from stdin. Uses the same temp-file + mv pattern as the previous
# _record_failure implementation so readers never see a partial file.
_write_state() {
  mkdir -p "${STATE_DIR}" || true
  local tmpfile="${STATE_FILE}.tmp"
  cat > "${tmpfile}"
  chmod 0644 "${tmpfile}"
  mv -f "${tmpfile}" "${STATE_FILE}"
}

# Record a build failure and decide whether to notify.
# Sends at most 2 notifications per incident: one on first failure,
# one when the circuit breaker trips. Subsequent failures for the
# same commit SHA are silently counted.
#   $1 — commit SHA (empty = always notify, no dedup)
#   $2 — context label / stage (e.g. "Build", "Remote build", "Image pull")
#   $3 — optional detail / reason (e.g. build output tail, shown in <pre> block)
_record_failure() {
  local sha="${1:-}"
  local context="${2:-Deploy}"
  local detail="${3:-}"

  local state notified_sha current new_count now opened_sent
  state=$(_read_state)
  current=$(printf '%s' "${state}" | jq -r '.consecutive_failures // 0')
  current=${current:-0}
  notified_sha=$(printf '%s' "${state}" | jq -r '.last_failure.sha // ""')
  opened_sent=$(printf '%s' "${state}" | jq -r '.alerts.opened_sent // false')
  new_count=$((current + 1))
  now=$(date -Iseconds)

  # Effective SHA stored in last_failure.sha: if the caller passed one,
  # use it; otherwise carry the previous notified SHA forward.
  local effective_sha="${sha:-${notified_sha}}"

  # Compute opened_at: set on the transition to/at threshold; preserve
  # whatever was there on subsequent failures (in case the breaker is
  # already open and more failures pile on).
  local new_state
  if [[ "${new_count}" -ge "${CB_MAX_FAILURES}" ]]; then
    new_state=$(printf '%s' "${state}" | jq -c \
      --argjson count "${new_count}" \
      --arg sha "${effective_sha}" \
      --arg stage "${context}" \
      --arg reason "${detail}" \
      --arg at "${now}" \
      '
        .version = 1
        | .consecutive_failures = $count
        | .opened_at = (.opened_at // $at)
        | .last_failure = {sha: $sha, stage: $stage, reason: $reason, at: $at}
        | .alerts = (.alerts // {opened_sent: false, last_blocked_alert_at: null})
      ')
  else
    new_state=$(printf '%s' "${state}" | jq -c \
      --argjson count "${new_count}" \
      --arg sha "${effective_sha}" \
      --arg stage "${context}" \
      --arg reason "${detail}" \
      --arg at "${now}" \
      '
        .version = 1
        | .consecutive_failures = $count
        | .opened_at = null
        | .last_failure = {sha: $sha, stage: $stage, reason: $reason, at: $at}
        | .alerts = (.alerts // {opened_sent: false, last_blocked_alert_at: null})
      ')
  fi
  printf '%s' "${new_state}" | _write_state

  rm -f "${STACK_DIR}/triggers/${SERVICE}.trigger"

  # Circuit breaker OPEN — notify exactly once per open event.
  # `alerts.opened_sent` is the once-only guard (Phase 3): the very
  # first failure that brings consecutive_failures to threshold fires the
  # alert and flips the bit; any subsequent failures while the breaker
  # remains open re-enter this branch but the Telegram is suppressed so
  # operators don't get spammed. The `_reset_cb` / success path clears the
  # bit back to false so the next open event will alert again.
  if [[ "${new_count}" -ge "${CB_MAX_FAILURES}" ]]; then
    if [[ "${opened_sent}" != "true" ]]; then
      notify_build build.circuit_breaker_open "$(printf '\U0001f6d1 <b>Circuit breaker OPEN</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Failures:   %d consecutive\n\u25b8 Time:       %s\n\nAuto-builds disabled.\nRun: <code>bay build reset %s</code>' \
        "${HOSTNAME}" "${SERVICE}" "${new_count}" "$(format_timestamp)" "${SERVICE}")"
      # Mark opened_sent so future trips during the same open event don't
      # re-spam. Re-read state to capture any concurrent updates from the
      # write above, then atomically merge in the alert flag.
      _read_state | jq -c '.alerts.opened_sent = true' | _write_state
    else
      _log "Circuit breaker re-trip for ${SERVICE} — open-alert already sent, suppressing"
    fi
    return
  fi

  # Same commit already notified — suppress duplicate
  if [[ -n "${sha}" && "${sha}" == "${notified_sha}" ]]; then
    _log "Failure #${new_count} for ${SERVICE} — notification suppressed (same commit ${sha})"
    return
  fi

  # First failure for this commit — send notification
  local msg
  msg="$(printf '\U0001f6a8 <b>%s failed</b> (%d/%d)\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>' \
    "${context}" "${new_count}" "${CB_MAX_FAILURES}" "${HOSTNAME}" "${SERVICE}")"
  [[ -n "${sha}" ]] && msg+="$(printf '\n\u25b8 Commit:     <code>%s</code>' "${sha}")"
  msg+="$(printf '\n\u25b8 Time:       %s' "$(format_timestamp)")"
  # `detail` is a raw tail of build output — arbitrary text that routinely
  # contains < and &. Unescaped it produces malformed HTML, which Telegram
  # rejects with a 400, so the whole failure alert is lost exactly when it
  # matters most. Escape before embedding.
  [[ -n "${detail}" ]] && msg+="$(printf '\n\n<pre>%s</pre>' "$(bay_html_escape "${detail}")")"
  notify_build build.failed "${msg}"
}

# Clear the circuit breaker state to a clean schema-v1 document. We
# write a file (rather than rm -f) so `bay build status` can always
# read a queryable "closed" state. The CLI's `bay build reset` still
# rm -f's the file — that's equivalent because `_read_state` on a
# missing file emits the same clean-state defaults.
_reset_cb() {
  _clean_state_json | _write_state
}

# Poll container health after restart. Returns 0 if healthy, 1 if failed.
# For containers with HEALTHCHECK: waits for healthy/unhealthy status.
# For containers without: polls State.Running repeatedly to catch crash loops.
# Consecutive-unhealthy guard: requires 2 consecutive unhealthy reads before
# returning 1. A single unhealthy read during Docker's StartPeriod window
# may be a transient inspect race (Docker 29.x quirk) — one extra read with
# a 2s gap is enough to distinguish a real failure from a race condition.
_wait_healthy() {
  local name="$1" timeout="${2:-${HEALTH_CHECK_TIMEOUT}}"
  local deadline running health checks=0 unhealthy_count=0
  deadline=$(( $(date +%s) + timeout ))

  # Initial settle time
  sleep 2

  while [[ $(date +%s) -lt $deadline ]]; do
    running=$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' "$name" 2>/dev/null || echo "false")
    if [[ "$running" != "true" ]]; then
      _log "Container ${name} is not running (exited or crashed)"
      return 1
    fi

    health=$(docker inspect --format '{% raw %}{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}' "$name" 2>/dev/null || echo "unknown")

    case "$health" in
      healthy)
        unhealthy_count=0
        _log "Container ${name} is healthy"
        return 0
        ;;
      unhealthy)
        unhealthy_count=$(( unhealthy_count + 1 ))
        if [[ $unhealthy_count -ge 2 ]]; then
          _log "Container ${name} is unhealthy (${unhealthy_count} consecutive reads)"
          return 1
        fi
        _log "Container ${name}: transient unhealthy read (${unhealthy_count}/2) — continuing"
        sleep 2
        ;;
      none)
        unhealthy_count=0
        # No healthcheck defined — require multiple consecutive running checks
        # to catch crash loops (container restarts between checks)
        checks=$((checks + 1))
        if [[ $checks -ge 3 ]]; then
          _log "Container ${name} is running (no healthcheck, ${checks} consecutive checks passed)"
          return 0
        fi
        sleep 2
        ;;
      starting|*)
        unhealthy_count=0
        sleep 2
        ;;
    esac
  done

  # Timeout — check final state
  running=$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' "$name" 2>/dev/null || echo "false")
  if [[ "$running" == "true" ]]; then
    health=$(docker inspect --format '{% raw %}{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}' "$name" 2>/dev/null || echo "unknown")
    if [[ "$health" == "starting" || "$health" == "none" ]]; then
      _log "Container ${name} still starting after ${timeout}s — treating as healthy"
      return 0
    fi
  fi

  _log "Health check timed out for ${name} after ${timeout}s"
  return 1
}

# Roll back to previous image after a failed health check.
# Stops the failed container, retags :previous, restarts, and verifies.
# Always exits the script (never returns to caller).
#   $1 — container/service name
#   $2 — previous image tag (e.g., IMAGE_NAME:previous or IMAGE_REPO:previous)
#   $3 — current image tag (e.g., IMAGE_NAME:latest or IMAGE_REF)
_handle_rollback() {
  local svc="$1" prev_tag="$2" current_tag="$3"

  # Disable ERR trap — we're handling the failure ourselves
  trap - ERR

  _log "Health check failed for ${svc} — attempting rollback"
  docker stop "${svc}" 2>/dev/null || true
  docker rm "${svc}" 2>/dev/null || true

  # Check if previous image exists locally
  if ! docker image inspect "${prev_tag}" &>/dev/null; then
    _record_failure "${SHA}" "Health check" "No previous image available for rollback"
    notify_build build.health_check_failed "$(printf '\U0001f6a8 <b>Health check FAILED</b> — no rollback available\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nManual intervention required.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    exit 1
  fi

  # Capture :latest digest before retag so we can restore it if rollback also fails.
  # TODO: remove this retag + restore pattern once _run_container accepts an explicit image-ref arg.
  local latest_digest
  latest_digest=$(docker inspect --format '{% raw %}{{.Id}}{% endraw %}' "${current_tag}" 2>/dev/null || echo "")

  # Retag previous image as current
  docker tag "${prev_tag}" "${current_tag}"

  # Restart with previous image (uses _run_container defined in per-service block)
  if ! _run_container; then
    _record_failure "${SHA}" "Rollback" "Failed to start container with previous image"
    notify_build build.rollback_failed "$(printf '\U0001f6d1 <b>ROLLBACK FAILED</b> — container would not start\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nManual intervention required.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    # Restore :latest to pre-rollback digest so tags don't converge on broken image
    if [[ -n "${latest_digest}" ]]; then
      docker tag "${latest_digest}" "${current_tag}" 2>/dev/null || true
    fi
    exit 1
  fi

  # Verify rollback health
  if ! _wait_healthy "${svc}" "${HEALTH_CHECK_TIMEOUT}"; then
    docker stop "${svc}" 2>/dev/null || true
    docker rm "${svc}" 2>/dev/null || true
    _record_failure "${SHA}" "Rollback" "Previous image also failed health check"
    notify_build build.rollback_failed "$(printf '\U0001f6d1 <b>ROLLBACK FAILED</b> — previous image also unhealthy\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Time:       %s\n\nBoth new and previous images failed.\nInvestigate: <code>docker logs %s --tail 50</code>' \
      "${HOSTNAME}" "${svc}" "$(format_timestamp)" "${svc}")"
    # Restore :latest to pre-rollback digest so tags don't converge on broken image
    if [[ -n "${latest_digest}" ]]; then
      _log "Rollback health check failed — restored :latest to pre-rollback digest ${latest_digest}"
      docker tag "${latest_digest}" "${current_tag}" 2>/dev/null || true
    fi
    exit 1
  fi

  # Rollback succeeded — service is running on previous image.
  # _record_failure has just run, so consecutive_failures is up to date.
  # Append a CB-state preview to the operator-facing Telegram so they can
  # see how close the breaker is to tripping (Phase 3, contract
  # exit-path map row 4).
  _record_failure "${SHA}" "Health check" "Rolled back to previous image"
  _rb_count=$(_read_state | jq -r '.consecutive_failures // 0')
  _rb_count=${_rb_count:-0}
  _rb_cb_line=""
  if [[ "${_rb_count}" -lt "${CB_MAX_FAILURES}" ]]; then
    _rb_cb_line="$(printf '\n\n\u26a0\ufe0f Circuit breaker at %d/%d — next failure will block pushes.\nReset: <code>bay build reset %s</code>' \
      "${_rb_count}" "${CB_MAX_FAILURES}" "${svc}")"
  fi
  notify_build build.rolled_back "$(printf '\u23ea <b>Rolled back to previous</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Reason:     health check failed after %ds\n\u25b8 Time:       %s\n\nService is running on previous image.\nInvestigate: <code>docker logs %s --tail 50</code>%s' \
    "${HOSTNAME}" "${svc}" "${HEALTH_CHECK_TIMEOUT}" "$(format_timestamp)" "${svc}" "${_rb_cb_line}")"
  exit 1
}

_deploy_failed() {
  _record_failure "${SHA}" "Webhook deploy"
}
trap '_deploy_failed' ERR

BUILD_START="${EPOCHSECONDS}"

# ── Read correlation ID and detect pull signal from trigger file ──
# Trigger file format (v2): line 1 = corr_id (UUID4), line 2 = signal ("pull" or empty)
# Legacy format (v1): single line "pull" or empty — CORR_ID set to "unknown"
# Manual trigger (no trigger file): CORR_ID set to "manual-<epoch>"
TRIGGER_FILE="${STACK_DIR}/triggers/${SERVICE}.trigger"
CORR_ID="unknown"
PULL_SIGNAL=0
if [[ -f "${TRIGGER_FILE}" ]]; then
  CORR_ID=$(sed -n '1p' "${TRIGGER_FILE}" 2>/dev/null || echo "unknown")
  [[ -z "${CORR_ID}" ]] && CORR_ID="unknown"
  PULL_SIGNAL_RAW=$(sed -n '2p' "${TRIGGER_FILE}" 2>/dev/null || echo "")
  # Legacy 1-line format: line 1 was "pull" — detect and handle
  if [[ "${CORR_ID}" == "pull" && -z "${PULL_SIGNAL_RAW}" ]]; then
    CORR_ID="unknown"
    PULL_SIGNAL_RAW="pull"
  fi
  if [[ "${PULL_SIGNAL_RAW}" == "pull" ]]; then
    PULL_SIGNAL=1
    echo "[rebuild] [${CORR_ID}] Pull signal detected for ${SERVICE}"
  fi
else
  # No trigger file — manually invoked rebuild
  CORR_ID="manual-${EPOCHSECONDS}"
fi

_log "Starting rebuild for ${SERVICE} at $(date -Iseconds)"

# ── Per-service build config (rendered at deploy time) ──
# git_deploy_rebuild_services includes local builds, remote builds,
# and pull-only services (non-builder image consumers).
{% set _build_services = [] %}
{% set _pull_only_services = [] %}
{% for svc_name in git_deploy_rebuild_services %}
{% if services[svc_name].build is defined %}
{% set _ = _build_services.append(svc_name) %}
{% else %}
{% set _ = _pull_only_services.append(svc_name) %}
{% endif %}
{% endfor %}
{% set _dedup = services | bay_build_dedup_map(_build_services) %}
{% set _is_first = namespace(val=true) %}
{% for svc_name in _build_services %}
{% set svc = services[svc_name] %}
{% set build = svc.build %}
{% set branch = build.branch | default('main') %}
{% set dockerfile = build.dockerfile | default('Dockerfile') %}
{% set context = build.context | default('.') %}
{% set image_name = git_deploy_image_prefix ~ '-' ~ svc_name %}
{% set raw_strategy = build.strategy | default(git_deploy_build_strategy | default('local')) %}
{% set strategy = 'remote' if raw_strategy == 'push' else raw_strategy %}
{% set slug = build.repo | bay_repo_slug(branch) %}
{% set has_token = build.token is defined %}
{#
  The clone URL carries NO credential. It used to embed the PAT as the URL
  password, rendered into this script and then
  run through `eval`, which made the PAT an argv element of every git child
  process — readable in /proc/*/cmdline by any local user — and wrote it
  permanently into .git/config on the first fetch.

  The PAT now reaches git through a GIT_ASKPASS helper that Ansible renders
  separately (roles/git_deploy/templates/git-askpass.sh.j2, mode 0700, owner
  app_user): clone_repos.yml writes one per repo group, remote_build.yml one
  per remote-built service. The paths below must match those two tasks.
#}
{% if has_token %}
{% set repo_url = build.repo %}
{% if repo_url.startswith('git@') %}
{% set parts = repo_url.split(':') %}
{% set host = parts[0] | replace('git@', '') %}
{% set path = parts[1] %}
{% set clone_url = 'https://' ~ host ~ '/' ~ path %}
{% elif '://' in repo_url %}
{% set proto_rest = repo_url.split('://') %}
{% set clone_url = 'https://' ~ proto_rest[1] %}
{% else %}
{% set clone_url = repo_url %}
{% endif %}
{% else %}
{% set clone_url = build.repo %}
{% endif %}
{% set askpass_remote = git_deploy_remote_build_dir ~ '/.git-askpass-' ~ svc_name %}
{% set askpass_local = git_deploy_build_dir ~ '/.git-askpass-' ~ slug %}
{% if not _is_first.val %}el{% endif %}if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
{% if strategy == 'remote' %}
  REPO_DIR="${REMOTE_BUILD_DIR}/{{ svc_name }}/repo"
{% else %}
  REPO_DIR="${BUILD_DIR}/shared/{{ slug }}/repo"
{% endif %}
  BRANCH="{{ branch }}"
  DOCKERFILE="{{ dockerfile }}"
  CONTEXT="{{ context }}"
  IMAGE_NAME="{{ image_name }}"
{% if strategy == 'remote' and svc.image is defined %}
  IMAGE_REF="{{ svc.image }}"
  IMAGE_REPO="{{ svc.image | regex_replace(':.*$', '') }}"
{% else %}
  IMAGE_REF=""
  IMAGE_REPO=""
{% endif %}
{% if not _dedup[svc_name].primary %}
  PRIMARY_IMAGE="{{ git_deploy_image_prefix }}-{{ _dedup[svc_name].primary_svc }}"
{% else %}
  PRIMARY_IMAGE=""
{% endif %}
  BUILD_STRATEGY="{{ strategy }}"
{% if strategy == 'remote' %}
  CLONE_URL="{{ clone_url }}"
  GIT_AUTH_ENV="GIT_ASKPASS={{ askpass_remote }} GIT_TERMINAL_PROMPT=0"
  CLONE_CMD="${GIT_AUTH_ENV} git clone --branch {{ branch }} --single-branch {{ clone_url }} ${REPO_DIR}"
  FETCH_CMD="${GIT_AUTH_ENV} git -c url.{{ clone_url }}.insteadOf={{ build.repo }} fetch origin {{ branch }}"
{% set _token_key = namespace(val='unknown') %}
{% if has_token and secrets is defined %}{% for _k, _v in secrets.items() %}{% if _v == build.token %}{% set _token_key.val = _k %}{% endif %}{% endfor %}{% endif %}
  CLONE_TOKEN_KEY="{{ _token_key.val }}"
  CLONE_REPO="{{ build.repo }}"
{% elif has_token %}
  CLONE_URL="{{ clone_url }}"
  PULL_CMD="GIT_ASKPASS={{ askpass_local }} GIT_TERMINAL_PROMPT=0 git -c url.${CLONE_URL}.insteadOf={{ build.repo }} pull origin ${BRANCH}"
{% set _token_key = namespace(val='unknown') %}
{% if secrets is defined %}{% for _k, _v in secrets.items() %}{% if _v == build.token %}{% set _token_key.val = _k %}{% endif %}{% endfor %}{% endif %}
