      "${IMAGE_REF}"{{ ' ' ~ svc.command if svc.command is defined else '' }}
  }
{% set _pull_ns.first = false %}
{% endif %}
{% endfor %}
{% if not _pull_ns.first %}
  fi
{% endif %}

  _run_container
  _started_commit "${SERVICE}" "${_PULLED_ID}" "${EXPECTED_REVISION}" \
    "${EXPECTED_REVISION:+${IMAGE_REPO}:${EXPECTED_REVISION}}" "${IMAGE_REF}"

  if ! _wait_healthy "${SERVICE}" "${HEALTH_CHECK_TIMEOUT}"; then
    _handle_rollback "${SERVICE}" "${IMAGE_REPO}:previous" "${IMAGE_REF}" "${STARTED_FAILED_TAG}"
  fi

  # Revision check: the running container must be the commit the build server
  # announced. Skipped for triggers without a revision (old build servers,
  # manual triggers).
  #
  # An image built before the label existed reports "". The build server can
  # still announce it: it skips the build when the :<sha> tag is already in the
  # registry. For that case only, fall back to the image ID: the container must
  # run exactly the image this pull fetched. A stale container (dockerd kept the
  # old image) still fails, because its image ID differs.
  if [[ -n "${EXPECTED_REVISION}" ]]; then
    _live_rev=$(docker inspect --format '{% raw %}{{index .Config.Labels "org.opencontainers.image.revision"}}{% endraw %}' "${SERVICE}" 2>/dev/null || true)
    if [[ -z "${_live_rev}" ]]; then
      _live_img=$(docker inspect --format '{% raw %}{{.Image}}{% endraw %}' "${SERVICE}" 2>/dev/null || true)
      _pulled_img="${_PULLED_ID}"  # resolved once after the pull: a later tag move does not count
      if [[ -n "${_live_img}" && "${_live_img}" == "${_pulled_img}" ]]; then
        _log "Revision check: ${SERVICE} image has no revision label (built before the label existed); image ID matches the pulled ${IMAGE_REF}, accepting it as ${EXPECTED_REVISION}"
        _live_rev="${EXPECTED_REVISION}"
      fi
    fi
    if [[ "${_live_rev}" != "${EXPECTED_REVISION}" ]]; then
      _log "Revision check failed for ${SERVICE}: running ${_live_rev:-<none>}, expected ${EXPECTED_REVISION}"
      # Empty SHA: _record_failure always notifies when there is no SHA to dedup on.
      _record_failure "" "Revision check" "Revision check: running ${_live_rev:-<none>}, expected ${EXPECTED_REVISION}"
      trap - ERR
      exit 1
    fi
    if [[ -n "${BUILT_AT}" ]]; then
      _log "live ${EXPECTED_REVISION} in $(( $(date +%s) - BUILT_AT ))s"
    else
      _log "live ${EXPECTED_REVISION}"
    fi
  fi

  # The receipt names the commit tag when the trigger carried a revision and the
  # container runs the pulled image (_started_commit).
  _stamp_receipt "${SERVICE}" "${STARTED_COMMIT}" "${STARTED_REF}"
  _clear_failed_commit "${SERVICE}" "${STARTED_COMMIT}"
  _reset_cb

  _log "Pull deploy complete for ${SERVICE} at $(date -Iseconds)"
  notify_build deploy.pull_complete "$(printf '\u2705 <b>Pull deploy complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s' \
    "${HOSTNAME}" "${SERVICE}" "${IMAGE_REF}" "$(format_duration)" "$(format_timestamp)")"
  exit 0
fi

# ── Pull-only guard ──
# Pull-only services (no build: block) can only be triggered by pull signals.
# If we reach here without a pull signal, something is wrong — skip gracefully.
if [[ "${BUILD_STRATEGY}" == "pull_only" ]]; then
  _log "Service ${SERVICE} is pull-only but no pull signal detected — skipping"
  exit 0
fi

# ── Builder selection (optional remote BuildKit over the tailnet) ──
# select-builder.sh is the ONE implementation of the probe; remote_build.yml
# (`bay deploy`) calls the same script. It prints a builder name on stdout,
# its reason on stderr, and exits 0 in every handled case.
SELECT_BUILDER="${STACK_DIR}/bin/select-builder.sh"
LOCAL_BUILDER={{ bay_buildx_builder | quote }}
REMOTE_BUILDER={{ git_deploy_remote_builder_name | default('bay-remote') | quote }}

_select_builder() {
  local chosen=""
  if [[ -x "${SELECT_BUILDER}" ]]; then
    chosen=$("${SELECT_BUILDER}") || chosen=""
  else
    _log "select-builder: ${SELECT_BUILDER} missing, using ${LOCAL_BUILDER}" >&2
  fi
  printf '%s\n' "${chosen:-${LOCAL_BUILDER}}"
}

# Transient registry push failures: blob PUTs cut by a proxy timeout, resets,
# 499/502/503/504 from the registry front door. Layers are cached in the
# builder, so a retry re-does only the push. Compile errors never match.
BAY_PUSH_RETRY_PATTERN='blob upload invalid|unexpected EOF|status code 499|status code 50[234]|i/o timeout|connection reset'
# Seconds to sleep before each extra attempt (overridable for tests).
BAY_PUSH_RETRY_DELAYS="${BAY_PUSH_RETRY_DELAYS:-15 45}"

# Run one build attempt; on a transient push failure re-run it on the SAME
# builder, once per delay in BAY_PUSH_RETRY_DELAYS.
#   $1  build function   $2  builder name
# The failure text is read from ${BUILD_OUTPUT}, which each attempt overwrites.
_build_with_push_retry() {
  local build_fn="$1" builder="$2" delay attempt=1
  if "${build_fn}" "${builder}"; then
    return 0
  fi
  for delay in ${BAY_PUSH_RETRY_DELAYS}; do
    if [[ -z "${BUILD_OUTPUT:-}" ]] || ! grep -Eq "${BAY_PUSH_RETRY_PATTERN}" "${BUILD_OUTPUT}" 2>/dev/null; then
      return 1
    fi
    attempt=$(( attempt + 1 ))
    _log "Transient registry push error on builder ${builder}; retry ${attempt} in ${delay}s"
    sleep "${delay}"
    if "${build_fn}" "${builder}"; then
      return 0
    fi
  done
  return 1
}

# Run one build through the selected builder.
#   $1  name of a function that runs the build; it takes the builder name.
# Retry policy. A build that fails on the REMOTE builder re-runs the probe:
#   - remote now unreachable: send build.remote_fallback and retry ONCE on the
#     local builder;
#   - remote still answers: the failure is the build's own, so no retry.
# A failure on the local builder is never retried. Only the last attempt's
# status reaches the caller, and only the caller calls _record_failure, so a
# fallback is never counted against the circuit breaker. A probe that picks
# the local builder before the build is silent: just the builder= line.
_build_with_fallback() {
  local build_fn="$1"
  local builder reprobe
  builder=$(_select_builder)
  _log "builder=${builder}"
  if _build_with_push_retry "${build_fn}" "${builder}"; then
    return 0
  fi
  if [[ "${builder}" != "${REMOTE_BUILDER}" ]]; then
    return 1
  fi
  reprobe=$(_select_builder)
  if [[ "${reprobe}" == "${REMOTE_BUILDER}" ]]; then
    _log "Remote builder ${REMOTE_BUILDER} still answers; build failure is real, no retry"
    return 1
  fi
  _log "Remote builder ${REMOTE_BUILDER} lost mid-build; retrying once on ${LOCAL_BUILDER}"
  notify_build build.remote_fallback "${SERVICE}: remote builder lost mid-build, retrying on ${LOCAL_BUILDER}"
  _log "builder=${LOCAL_BUILDER}"
  _build_with_push_retry "${build_fn}" "${LOCAL_BUILDER}"
}

# ── Strategy routing ──
if [[ "${BUILD_STRATEGY}" == "remote" ]]; then
  # ── Remote strategy: fetch, build, push to registry ──
  # No container restart — deployment servers pull via S2 fan-out.

  # Ensure clone directory exists
  mkdir -p "$(dirname "${REPO_DIR}")"

  # Clone if repo doesn't exist yet
  if [[ ! -d "${REPO_DIR}/.git" ]]; then
    _log "Cloning repository for ${SERVICE}"
    _CLONE_STDERR=$(eval "${CLONE_CMD}" 2>&1)
    _CLONE_EXIT=$?
    if [[ ${_CLONE_EXIT} -ne 0 ]]; then
      if grep -q "403" <<<"${_CLONE_STDERR}"; then
        _log "clone failed (HTTP 403)"
        _log "  repo: ${CLONE_REPO}"
        _log "  token: ${CLONE_TOKEN_KEY}"
        _log "hint: verify the PAT has Contents:Read (fine-grained) or repo (classic) scope."
      else
        echo "${_CLONE_STDERR}" >&2
      fi
      exit ${_CLONE_EXIT}
    fi
  fi

  # Acquire repo lock
  exec 200>"${REPO_DIR}/.git/rebuild.lock"
  flock -x 200
  _log "Acquired repo lock for ${SERVICE}"

  # Fetch + reset (force-push safe)
  cd "${REPO_DIR}"
  _FETCH_STDERR=$(eval "${FETCH_CMD}" 2>&1)
  _FETCH_EXIT=$?
  if [[ ${_FETCH_EXIT} -ne 0 ]]; then
    if grep -q "403" <<<"${_FETCH_STDERR}"; then
      _log "clone failed (HTTP 403)"
      _log "  repo: ${CLONE_REPO}"
      _log "  token: ${CLONE_TOKEN_KEY}"
      _log "hint: verify the PAT has Contents:Read (fine-grained) or repo (classic) scope."
    else
      echo "${_FETCH_STDERR}" >&2
    fi
    exit ${_FETCH_EXIT}
  fi
  # The commit this checkout last built, before it moves to the pushed one.
  _PREV_HEAD=$(git rev-parse --short=12 HEAD 2>/dev/null || true)
  git reset --hard FETCH_HEAD

  # Get commit SHA (12-char for registry tags, matching remote_build.yml)
  SHA=$(git rev-parse --short=12 HEAD)

  # Config-only push: checked before the hold guard and the build. The previous
  # commit is the running container's (a build server that also runs it), else
  # the commit this checkout was at before the fetch. Its image must be in the
  # registry (_config_only_source): a failed build of it pushed nothing.
  PREV_COMMIT=$(_previous_commit "${SERVICE}" "${_PREV_HEAD}")
  if _config_only "${REPO_DIR}" "${PREV_COMMIT}"; then
    _config_only_push "${IMAGE_REPO}" "${PREV_COMMIT}" \
      || _log "config-only push ${SHA}: no image of ${PREV_COMMIT:0:12} in the registry, building"
  fi

  # Hold guard, on the checkout of the pushed commit. A held build pushes only
  # the commit tag: the moving tag (IMAGE_REF) stays, and no box is told to pull.
  HOLD_REASON=$(_hold_reason "${REPO_DIR}")
  PUSH_TAGS=(-t "${IMAGE_REPO}:${SHA}")
  [[ -z "${HOLD_REASON}" ]] && PUSH_TAGS+=(-t "${IMAGE_REF}")

  # Check if image already exists in registry for this SHA
  if docker manifest inspect "${IMAGE_REPO}:${SHA}" &>/dev/null; then
    _log "Image ${IMAGE_REPO}:${SHA} already in registry, skipping build"
    # Point the moving tag at it (registry side, no pull), unless held.
    if [[ -z "${HOLD_REASON}" ]] && ! docker buildx imagetools create --prefer-index=false -t "${IMAGE_REF}" "${IMAGE_REPO}:${SHA}" >/dev/null 2>&1; then
      _record_failure "${SHA}" "Registry retag" "could not point ${IMAGE_REF} at ${IMAGE_REPO}:${SHA}"
      trap - ERR
      exit 1
    fi
  else
    # Write build secrets to temp files
    SECRETS_DIR="${REMOTE_BUILD_DIR}/.secrets"
    mkdir -p "${SECRETS_DIR}"
    chmod 700 "${SECRETS_DIR}"
    SECRET_FLAGS=""
    for key in "${!BUILD_SECRETS[@]}"; do
      TMPFILE="${SECRETS_DIR}/${SERVICE}-${key}"
      printf '%s' "${BUILD_SECRETS[$key]}" > "${TMPFILE}"
      chmod 600 "${TMPFILE}"
      SECRET_FLAGS="${SECRET_FLAGS} --secret id=${key},src=${TMPFILE}"
    done

    # Build
    _log "Building ${IMAGE_REPO}:${SHA} (CONTEXT=${CONTEXT} REPO_DIR=${REPO_DIR} PWD=$(pwd))"
    ls -la "${CONTEXT}" 2>&1 | head -5 || _log "WARNING: build context '${CONTEXT}' not found"
    BUILD_OUTPUT=$(mktemp)
    # $1 = builder. Each attempt overwrites BUILD_OUTPUT, so the failure tail
    # below always comes from the last attempt.
    _remote_buildx() {
      docker buildx build \
        --builder "$1" \
        --provenance=false \
        --push \
{% if git_deploy_registry_cache | default(false) %}
        --cache-from "type=registry,ref=${IMAGE_REPO}:buildcache" \
        --cache-to "type=registry,ref=${IMAGE_REPO}:buildcache,mode=max" \
{% endif %}
        "${PUSH_TAGS[@]}" \
        --label "org.opencontainers.image.revision=${SHA}" \
        --label "com.bay.commit=${SHA}" \
        --build-arg "BAY_GIT_SHA=${SHA}" \
        -f "${DOCKERFILE}" \
        "${BUILD_ARGS[@]}" \
        ${SECRET_FLAGS} \
        "${CONTEXT}" 2>&1 | tee "${BUILD_OUTPUT}"
    }
    if ! _build_with_fallback _remote_buildx; then
      TAIL_OUTPUT=$(tail -c 500 "${BUILD_OUTPUT}")
      _record_failure "${SHA}" "Remote build" "${TAIL_OUTPUT}"
      rm -f "${BUILD_OUTPUT}"
      # Clean up secret temp files
      for key in "${!BUILD_SECRETS[@]}"; do
        rm -f "${SECRETS_DIR}/${SERVICE}-${key}"
      done
      trap - ERR
      exit 1
    fi
    rm -f "${BUILD_OUTPUT}"

    # buildx exported both tags straight to the registry above, so there is
    # no separate push step and no image left in the local daemon store.
    _log "Pushed ${IMAGE_REPO}:${SHA} to registry${HOLD_REASON:+ (held: ${IMAGE_REF} not moved)}"

    # Trim old local content-hash tags left behind by earlier releases
    # (which exported the image into the local daemon) so
    # the build server doesn't accumulate ~1 GB per push indefinitely. The
    # Ansible-side cleanup in remote_build.yml only fires on `bay deploy`
    # — webhook auto-builds (this path) never hit it, which is how the
    # 2026-04-17 76%-disk incident happened. Keeps `latest` + newest N
    # content-hash tags (default {{ git_deploy_build_keep_tags | default(3) }}),
    # skips anything a running container references.
    KEEP_TAGS="{{ git_deploy_build_keep_tags | default(3) }}"
    if [[ "${KEEP_TAGS}" -gt 0 ]]; then
      _log "Pruning old local content-hash tags for ${IMAGE_REPO} (keep=${KEEP_TAGS})"
      RUNNING_REFS=$(docker ps --format '{{ '{{' }}.Image{{ '}}' }}' 2>/dev/null || true)
      # Build a newline-delimited list of repo-scoped tags currently used by
      # running containers, stripped of the repo: prefix so it matches the
      # tag column emitted below.
      RUNNING_TAGS=$(printf '%s\n' "${RUNNING_REFS}" \
        | grep -E "^${IMAGE_REPO}:" 2>/dev/null \
        | sed "s|^${IMAGE_REPO}:||" \
        || true)
      # List non-latest, non-dangling tags newest-first. --format emits
      # `<tag>|<createdat>`; sort -t'|' -k2 -r orders by CreatedAt desc.
      CANDIDATES=$(docker images "${IMAGE_REPO}" \
        --format '{{ '{{' }}.Tag{{ '}}' }}|{{ '{{' }}.CreatedAt{{ '}}' }}' 2>/dev/null \
        | grep -v '^latest|' \
        | grep -v '^<none>|' \
        | sort -t'|' -k2 -r \
        | cut -d'|' -f1 || true)
      # Filter out tags used by running containers (defensive; docker rmi
      # itself also refuses such images).
      if [[ -n "${RUNNING_TAGS}" ]]; then
        CANDIDATES=$(printf '%s\n' "${CANDIDATES}" \
          | grep -vxF -f <(printf '%s\n' "${RUNNING_TAGS}") \
          || true)
      fi
      TO_REMOVE=$(printf '%s\n' "${CANDIDATES}" | tail -n +$((KEEP_TAGS + 1)))
      if [[ -n "${TO_REMOVE}" ]]; then
        while IFS= read -r tag; do
          [[ -z "${tag}" ]] && continue
          if docker rmi "${IMAGE_REPO}:${tag}" >/dev/null 2>&1; then
            _log "  pruned ${IMAGE_REPO}:${tag}"
          fi
        done <<< "${TO_REMOVE}"
      fi
    fi

    # Clean up secret temp files
    for key in "${!BUILD_SECRETS[@]}"; do
      rm -f "${SECRETS_DIR}/${SERVICE}-${key}"
    done
  fi

  # Release repo lock
  exec 200>&-

  # Held: the commit tag is in the registry, nothing else moved, no fan-out.
  if [[ -n "${HOLD_REASON}" ]]; then
    _hold_build "${HOLD_REASON}" "${IMAGE_REPO}:${SHA}"
  fi

  _reset_cb
  # Build finished (or was skipped: image already in the registry).
  BUILT_AT_EPOCH=$(date +%s)

  _log "Completed remote build for ${SERVICE} at $(date -Iseconds)"
  notify_build build.remote_complete "$(printf '\u2705 <b>Remote build complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Commit:     <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s\n\nNotifying deployment servers to pull.' \
    "${HOSTNAME}" "${SERVICE}" "${SHA}" "${IMAGE_REF}" "$(format_duration)" "$(format_timestamp)")"

  # ── Fan-out image-level pull signals to deployment servers ──
  # After a successful build+push, POST to each region's /webhook/pull-image
  # with the image ref in the body. Each region pulls the image once and
  # restarts all local containers using it.
  # Uses associative arrays for image->region mapping, computed from all
  # services sharing each built image across all regions.
{% set _image_region_map = services | bay_image_region_map(git_deploy_rebuild_services) %}
{% set _peer_urls = git_deploy_peer_webhook_urls | default({}) %}
{% if _image_region_map and _peer_urls %}
  # Image-to-region mapping (computed at deploy time)
  declare -A IMAGE_REGIONS=(
{% for image_ref, regions in _image_region_map.items() %}
    ["{{ image_ref }}"]="{{ regions | join(' ') }}"
{% endfor %}
  )

  # Peer webhook URLs
  declare -A PEER_URLS=(
{% for region_name, region_url in _peer_urls.items() %}
    ["{{ region_name }}"]="{{ region_url | regex_replace('/$', '') }}"
{% endfor %}
  )

  if [[ -n "${IMAGE_REF}" && -n "${IMAGE_REGIONS[${IMAGE_REF}]+_}" ]]; then
    for region in ${IMAGE_REGIONS[${IMAGE_REF}]}; do
      if [[ -n "${PEER_URLS[${region}]+_}" ]]; then
        PULL_URL="${PEER_URLS[${region}]}/webhook/pull-image"
        # revision is the same 12-char SHA that names the :<sha> tag and sits in
        # the image's org.opencontainers.image.revision label; the app host
        # checks the running container against it. built_at is epoch seconds.
        PULL_BODY=$(jq -cn --arg image "${IMAGE_REF}" --arg revision "${SHA}" \
          --argjson built_at "${BUILT_AT_EPOCH}" \
          '{image: $image, revision: $revision, built_at: $built_at}')
        _log "Sending image-level pull signal to ${region} for ${IMAGE_REF}"
        # The MAC key comes out of a 0600 file, hex-encoded. The raw webhook
        # secret used to be rendered into this script as an openssl argument.
        HMAC_KEY_HEX=$(cat "${WEBHOOK_HMAC_KEY_FILE}")
        HMAC_SIG=$(printf '%s' "${PULL_BODY}" | openssl dgst -sha256 -mac HMAC -macopt hexkey:"${HMAC_KEY_HEX}" -binary | xxd -p -c 256)
        if curl -sf -X POST \
          --connect-timeout 10 \
          --max-time 30 \
          -H "Content-Type: application/json" \
          -H "X-Hub-Signature-256: sha256=${HMAC_SIG}" \
          -H "X-Bay-Pull-Signal: 1" \
          -d "${PULL_BODY}" \
          "${PULL_URL}"; then
          _log "Pull signal sent to ${region} for ${IMAGE_REF} successfully"
        else
          _log "WARNING: Pull signal to ${region} for ${IMAGE_REF} failed"
          notify_build build.fanout_failed "$(printf '\u26a0\ufe0f <b>Pull fan-out failed</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Image:      <code>%s</code>\n\u25b8 Peer:       <code>%s</code>\n\u25b8 URL:        <code>%s</code>\n\u25b8 Time:       %s' \
            "${HOSTNAME}" "${SERVICE}" "${IMAGE_REF}" "${region}" "${PULL_URL}" "$(format_timestamp)")"
        fi
      fi
    done
  fi
{% endif %}

  # Exit here — no container restart for remote strategy on build server.
  exit 0
fi

# ── Local strategy: build and restart on this server ──

# ── Acquire repo lock (serializes pull + build for shared repos) ──
# Uses fd-based flock so variables set inside are available afterward.
# When two services share a repo and both webhooks fire, the second
# waits here until the first finishes building — then S2 dedup kicks
# in and retags from the primary instead of rebuilding.
exec 200>"${REPO_DIR}/.git/rebuild.lock"
flock -x 200
_log "Acquired repo lock for ${SERVICE}"

# ── Pull latest code ──
cd "${REPO_DIR}"
# The commit the checkout was at before the pull, as this service last saw it
# (the checkout is shared, _seen_head): the previous commit of the config-only
# check when the running container has no com.bay.commit label.
_PREV_HEAD=$(_seen_head "${REPO_DIR}")
eval "${PULL_CMD}"
_mark_seen "${REPO_DIR}"

# ── Get new commit SHA (12 characters: the image's commit tag) ──
SHA=$(git rev-parse --short=12 HEAD)

# ── Config-only push: before the build and the hold guard ──
# The previous commit is the one the running container was built from, else
# the one the checkout was at before this service's pull (a container from
# before 2.1.0).
PREV_COMMIT=$(_previous_commit "${SERVICE}" "${_PREV_HEAD}")
if _config_only "${REPO_DIR}" "${PREV_COMMIT}"; then
  _config_only_push "${IMAGE_NAME}" "${PREV_COMMIT}" \
    || _log "config-only push ${SHA}: no image known to hold ${PREV_COMMIT:0:12}, building"
fi

# ── Check if image already exists for this SHA ──
if docker image inspect "${IMAGE_NAME}:${SHA}" &>/dev/null; then
  _log "Image ${IMAGE_NAME}:${SHA} already exists, skipping build"
elif [[ -n "${PRIMARY_IMAGE}" ]] && docker image inspect "${PRIMARY_IMAGE}:${SHA}" &>/dev/null; then
  _log "Re-tagging from primary ${PRIMARY_IMAGE}:${SHA} (build dedup)"
  docker tag "${PRIMARY_IMAGE}:${SHA}" "${IMAGE_NAME}:${SHA}"
else
  # Write build secrets to temp files
  SECRET_FLAGS=""
  for key in "${!BUILD_SECRETS[@]}"; do
    TMPFILE="/tmp/build-secret-${SERVICE}-${key}"
    printf '%s' "${BUILD_SECRETS[$key]}" > "${TMPFILE}"
    chmod 600 "${TMPFILE}"
    SECRET_FLAGS="${SECRET_FLAGS} --secret id=${key},src=${TMPFILE}"
  done

  # Build. Only the commit tag: `:latest` moves after the hold guard below.
  _log "Building ${IMAGE_NAME}:${SHA} (CONTEXT=${CONTEXT} REPO_DIR=${REPO_DIR} PWD=$(pwd))"
  ls -la "${CONTEXT}" 2>&1 | head -5 || _log "WARNING: build context '${CONTEXT}' not found"
  BUILD_OUTPUT=$(mktemp)
  # $1 = builder. See _remote_buildx above for the BUILD_OUTPUT contract.
  _local_buildx() {
    docker buildx build \
      --builder "$1" \
      --load \
      -t "${IMAGE_NAME}:${SHA}" \
      --label "org.opencontainers.image.revision=${SHA}" \
      --label "com.bay.commit=${SHA}" \
      -f "${DOCKERFILE}" \
      "${BUILD_ARGS[@]}" \
      ${SECRET_FLAGS} \
      "${CONTEXT}" 2>&1 | tee "${BUILD_OUTPUT}"
  }
  if ! _build_with_fallback _local_buildx; then
    TAIL_OUTPUT=$(tail -c 500 "${BUILD_OUTPUT}")
    _record_failure "${SHA}" "Build" "${TAIL_OUTPUT}"
    rm -f "${BUILD_OUTPUT}"
    # Clean up secret temp files on failure
    for key in "${!BUILD_SECRETS[@]}"; do
      rm -f "/tmp/build-secret-${SERVICE}-${key}"
    done
    # Disable ERR trap to avoid duplicate notification
    trap - ERR
    exit 1
  fi
  rm -f "${BUILD_OUTPUT}"

  # Clean up secret temp files
  for key in "${!BUILD_SECRETS[@]}"; do
    rm -f "/tmp/build-secret-${SERVICE}-${key}"
  done
fi

# ── Hold guard, on the checkout of the pushed commit (still under the lock) ──
HOLD_REASON=$(_hold_reason "${REPO_DIR}")

# ── Release repo lock before restart ──
exec 200>&-

# Held: the image stays under its commit tag; nothing else moves.
if [[ -n "${HOLD_REASON}" ]]; then
  _hold_build "${HOLD_REASON}" "${IMAGE_NAME}:${SHA}"
fi

# ── Release, with the new commit's image, before :latest moves ──
_release_or_fail "${IMAGE_NAME}:${SHA}"

# ── The push may deploy: move :latest to this commit ──
_promote_latest "${IMAGE_NAME}" "${SHA}"
# The image :latest names now; _started_commit compares it with what started.
_PROMOTED_ID=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "${IMAGE_NAME}:latest" 2>/dev/null || true)

# ── Restart with new image ──
# Stop and remove old container, then recreate directly.
# Brief downtime is acceptable for developer-triggered rebuilds.
# The next Ansible deploy will manage the container via container_lifecycle.
# Carry the deploy's config-hash label over, so that deploy plans a noop.
EXTRA_LABELS=()
_CARRIED_HASH=$(_config_hash_of "${SERVICE}")
[[ -n "${_CARRIED_HASH}" ]] && EXTRA_LABELS+=(-l "com.bay.config-hash=${_CARRIED_HASH}")
docker stop "${SERVICE}" 2>/dev/null || true
docker rm "${SERVICE}"   2>/dev/null || true

{% for svc_name in git_deploy_services %}
{% set svc = services[svc_name] %}
{% set _tc = {
  'traefik_docker_network': traefik_docker_network | default('services'),
  'traefik_security_headers_enabled': traefik_security_headers_enabled | default(true),
  'traefik_compress_enabled': traefik_compress_enabled | default(true),
  'traefik_error_pages_enabled': traefik_error_pages_enabled | default(false),
  'traefik_rate_limit_average': traefik_rate_limit_average | default(100),
  'traefik_rate_limit_burst': traefik_rate_limit_burst | default(50),
  'traefik_rate_limit_period': traefik_rate_limit_period | default('1s'),
  'traefik_in_flight_req_amount': traefik_in_flight_req_amount | default(100),
  'traefik_circuit_breaker_expression': traefik_circuit_breaker_expression | default('NetworkErrorRatio() > 0.5'),
  'traefik_retry_attempts': traefik_retry_attempts | default(4),
  'stack_name': stack_name | default('bay'),
} %}
{% if not loop.first %}el{% endif %}if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
  _run_container() {
    docker run -d \
      --name "{{ svc_name }}" \
      --hostname "{{ svc_name }}" \
      --restart unless-stopped \
{% if svc.network_mode is defined %}
      --network "{{ svc.network_mode }}" \
{% else %}
      --network "{{ traefik_docker_network | default('services') }}" \
{% endif %}
{% if svc.env is defined or svc.database is defined %}
      --env-file "${STACK_DIR}/env/{{ svc_name }}.env" \
{% endif %}
{{ publish_flags(svc) -}}
{% for vol in svc.volumes | default([]) | bay_prefix_volumes(stack_name | default('bay')) %}
      -v "{{ vol }}" \
{% endfor %}
{% if svc.mem_limit is defined %}
      --memory "{{ svc.mem_limit }}" \
{% endif %}
{% if svc.memswap_limit is defined %}
      --memory-swap "{{ svc.memswap_limit }}" \
{% endif %}
{% for k, v in (svc | bay_traefik_labels(svc_name, _tc)).items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      -l 'bay.managed=true' \
      -l 'bay.stack={{ stack_name }}' \
{% set _wt_labels = (svc['update'] | default('monitor')) | bay_watchtower_labels(watchtower_enabled | default(false)) %}
{% for k, v in _wt_labels.items() %}
      -l '{{ k }}={{ v }}' \
{% endfor %}
      "${EXTRA_LABELS[@]}" \
      "${IMAGE_NAME}:latest"{{ ' ' ~ svc.command if svc.command is defined else '' }}
  }
{% endfor %}
{% if git_deploy_services | length > 0 %}
fi
{% endif %}

_run_container
_started_commit "${SERVICE}" "${_PROMOTED_ID}" "${SHA}" "${IMAGE_NAME}:${SHA}" "${IMAGE_NAME}:latest"

if ! _wait_healthy "${SERVICE}" "${HEALTH_CHECK_TIMEOUT}"; then
  _handle_rollback "${SERVICE}" "${IMAGE_NAME}:previous" "${IMAGE_NAME}:latest" "${STARTED_FAILED_TAG}"
fi

_stamp_receipt "${SERVICE}" "${STARTED_COMMIT}" "${STARTED_REF}"
_clear_failed_commit "${SERVICE}" "${STARTED_COMMIT}"
_reset_cb

# ── Fan-out: trigger alias rebuilds for dedup groups ──
# When a primary service builds, its aliases just retag from the primary
# image. Write CORR_ID into each alias trigger so log correlation survives
# the fan-out (readers set CORR_ID=[unknown] from an empty trigger file).
#
# Alias trigger format: line 1 = CORR_ID only. We intentionally OMIT
# line 2 (the pull signal) — the primary trigger drives the image build
# on this host, and aliases piggyback on the same local image via the
# dedup retag at the top of the script. Emitting "pull" here would route
# aliases through the registry-pull path, which is wrong (nothing has
# been pushed to the registry for local-strategy builds).
#
# Write atomically: temp file + mv -f so the path-unit watcher that fires
# bay-build@<alias>.service never observes a partial/empty trigger.
{% for svc_name in git_deploy_services %}
{% if _dedup[svc_name].primary and _dedup[svc_name].group_size > 1 %}
if [[ "${SERVICE}" == '{{ svc_name }}' ]]; then
{% for other_svc in git_deploy_services %}
{% if not _dedup[other_svc].primary and _dedup[other_svc].primary_svc == svc_name %}
  _log "Fan-out: triggering alias {{ other_svc }}"
  _alias_trigger="${STACK_DIR}/triggers/{{ other_svc }}.trigger"
  _alias_tmp="${_alias_trigger}.tmp.$$"
  printf '%s\n' "${CORR_ID}" > "${_alias_tmp}" && mv -f "${_alias_tmp}" "${_alias_trigger}"
{% endif %}
{% endfor %}
fi
{% endif %}
{% endfor %}

_log "Completed rebuild for ${SERVICE} at $(date -Iseconds)"
notify_build deploy.webhook_complete "$(printf '\u2705 <b>Webhook deploy complete</b>\n\n\u25b8 Host:       <code>%s</code>\n\u25b8 Service:    <code>%s</code>\n\u25b8 Commit:     <code>%s</code>\n\u25b8 Image:      <code>%s:%s</code>\n\u25b8 Duration:   %s\n\u25b8 Time:       %s' \
  "${HOSTNAME}" "${SERVICE}" "${SHA}" "${IMAGE_NAME}" "${SHA}" "$(format_duration)" "$(format_timestamp)")"
exit 0
