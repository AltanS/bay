#!/usr/bin/env bash
# {{ ansible_managed }}
# Backup script for {{ accessory_name | to_json }} ({{ method | to_json }})
set -euo pipefail

# Restic environment (baked at template time).
#
# Every value below is single-quoted by `| quote`, not wrapped in double
# quotes. Double quotes do not stop `$(...)` or backtick substitution at
# script-run time, so a vault secret containing `$(` used to execute as the
# script's user (app_user, in the docker group) on every backup run.
export RESTIC_REPOSITORY={{ repo | quote }}
export RESTIC_PASSWORD={{ backup_restic_password | quote }}
export AWS_ACCESS_KEY_ID={{ backup_s3_access_key_id | quote }}
export AWS_SECRET_ACCESS_KEY={{ backup_s3_secret_access_key | quote }}

# Consumer-supplied identifiers, resolved once here and referenced as shell
# variables everywhere below, so no config value is ever a bare word in a
# command line or inside a double-quoted string.
ACCESSORY={{ accessory_name | quote }}
METHOD={{ method | quote }}
HOST_TAG={{ inventory_hostname | quote }}

export RESTIC_CACHE_DIR={{ backup_scripts_dir | quote }}/cache/"${ACCESSORY}"

LOCK_FILE={{ backup_lock_dir | quote }}/"${ACCESSORY}".lock
MIN_SNAPSHOT_SIZE=100
RESTIC={{ backup_restic_bin | quote }}

# ── Telegram Alert ──────────────────────────────────────────────────────

BAY_ALERT_HEADER={{ docker_monitor_alert_header | quote }}
BAY_ALERT_FOOTER={{ docker_monitor_alert_footer | quote }}

{% include '_notify.sh.j2' %}

# ── Lock Management ─────────────────────────────────────────────────────

# Create lock (blocks deploys from restarting containers mid-backup)
mkdir -p "$(dirname "$LOCK_FILE")"
echo "$$" > "$LOCK_FILE"
RESTIC_ERR=$(mktemp)
RESTIC_OUT=$(mktemp)
trap 'rm -f "$LOCK_FILE" "$RESTIC_ERR" "$RESTIC_OUT"' EXIT

# ── Prepare Cache ───────────────────────────────────────────────────────

mkdir -p "$RESTIC_CACHE_DIR"

# ── Restic runs the dump ────────────────────────────────────────────────

# backup_from <snapshot file name> <dump command...>
#
# restic runs the dump command itself (backup --stdin-from-command, restic
# 0.17.0 or newer) and stores no snapshot when the command exits non-zero.
# Do not turn this back into `<dump> | restic backup --stdin`: a dump that
# dies mid-stream closes the pipe like a finished one, and restic then stores
# the cut-off dump as the newest snapshot.
#
# Never exits. On a failure it records the first one: RESTIC_EXIT (restic's
# exit code), DUMP_ERROR (what restic says about the dump command, e.g.
# `exit status 1`, empty when restic itself failed), EMPTY_DUMP (the dump
# exited 0 and wrote nothing) and FAILED_FILE. restic's stderr, with the dump
# command's own stderr in it, goes on to the journal.
#
# A dump that exits 0 with no output is not an error to the dump command, but
# restic fails with `no data read` and still stores a snapshot of the empty
# file. That snapshot would be the newest one and a restore would pick it. It
# is removed here, by the id restic printed for this run (`snapshot <id>
# saved`), so no other snapshot can be touched.
backup_from() {
  local name="$1" rc=0 why snap
  shift
  "$RESTIC" backup \
    --stdin-filename "$name" \
    --tag "${HOST_TAG}" \
    --tag "${ACCESSORY}" \
    --tag "${METHOD}" \
    ${RESTIC_TAG_EXTRA:+--tag "$RESTIC_TAG_EXTRA"} \
    --retry-lock 15m \
    --stdin-from-command -- "$@" > "$RESTIC_OUT" 2> "$RESTIC_ERR" || rc=$?
  cat "$RESTIC_OUT"
  cat "$RESTIC_ERR" >&2
  if [ "$rc" -ne 0 ] && [ "${RESTIC_EXIT:-0}" -eq 0 ]; then
    RESTIC_EXIT=$rc
    FAILED_FILE=$name
    # One sed, no pipe: under pipefail an early-closing reader fails the line.
    why=$(sed -n '/Fatal: command failed: /{s/.*Fatal: command failed: //p;q;}' "$RESTIC_ERR")
    DUMP_ERROR=$why
    if [ -z "$why" ] && grep -qF 'no data read' "$RESTIC_ERR"; then
      EMPTY_DUMP=1
    fi
  fi
  if [ "$rc" -ne 0 ] && [ -z "$why" ] && grep -qF 'no data read' "$RESTIC_ERR"; then
    snap=$(sed -n '/^snapshot [0-9a-f]* saved/{s/^snapshot \([0-9a-f]*\) saved.*/\1/p;q;}' "$RESTIC_OUT")
    if [ -n "$snap" ]; then
      "$RESTIC" forget "$snap" --retry-lock 15m >&2 \
        || echo "WARNING: could not remove the empty snapshot ${snap} (${name})" >&2
    fi
  fi
  return 0
}

# ── Backup ──────────────────────────────────────────────────────────────

{% if method == 'pg_dump' %}
{% set pg_user = accessory_config.env['clear'].POSTGRES_USER | default('app') %}
{% set _explicit_dbs = accessory_config.backup.databases | default([accessory_config.env['clear'].POSTGRES_DB | default('app')]) if accessory_config.backup is mapping else [accessory_config.env['clear'].POSTGRES_DB | default('app')] %}
{% set databases = (_explicit_dbs + (bound_databases | default([]))) | unique | list %}
{% for db in databases %}
PG_USER={{ pg_user | quote }}
PG_DB={{ db | quote }}
echo "[$(date -Iseconds)] Starting pg_dump backup for ${ACCESSORY} (database: ${PG_DB})..."
backup_from "${ACCESSORY}{% if databases | length > 1 %}-${PG_DB}{% endif %}.sql" \
  docker exec "${ACCESSORY}" \
  pg_dump -U "${PG_USER}" "${PG_DB}"
{% endfor %}
{% elif method == 'mysql' %}
MYSQL_PWD_VALUE={{ accessory_config.env['clear'].MYSQL_ROOT_PASSWORD | default(accessory_config.env['clear'].MYSQL_PASSWORD | default('')) | quote }}
MYSQL_USER_VALUE={{ accessory_config.env['clear'].MYSQL_USER | default('root') | quote }}
MYSQL_DB_VALUE={{ accessory_config.env['clear'].MYSQL_DATABASE | default('app') | quote }}
echo "[$(date -Iseconds)] Starting mysqldump backup for ${ACCESSORY}..."
backup_from "${ACCESSORY}.sql" \
  docker exec \
  -e MYSQL_PWD="${MYSQL_PWD_VALUE}" \
  "${ACCESSORY}" \
  mysqldump -u "${MYSQL_USER_VALUE}" "${MYSQL_DB_VALUE}"
{% elif method == 'redis' %}
echo "[$(date -Iseconds)] Starting redis backup for ${ACCESSORY}..."

# Trigger BGSAVE and poll for completion
BEFORE=$(docker exec "${ACCESSORY}" redis-cli LASTSAVE)
docker exec "${ACCESSORY}" redis-cli BGSAVE > /dev/null

for i in $(seq 1 60); do
  AFTER=$(docker exec "${ACCESSORY}" redis-cli LASTSAVE)
  if [ "$AFTER" != "$BEFORE" ]; then break; fi
  sleep 2
done

if [ "$AFTER" = "$BEFORE" ]; then
  ERROR_MSG="BGSAVE did not complete within 120 seconds"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.failed "<b>Backup failed</b>
Accessory: <code>${ACCESSORY}</code>
Host: <code>${BAY_HOST}</code>
Error: <code>${ERROR_MSG}</code>"
  exit 1
fi

# Copy the RDB out; restic runs the copy. `docker cp ... -` writes a tar
# archive (one entry, dump.rdb), so the `.rdb` snapshot holds that tar, not a
# bare RDB file. restore.yml unpacks it with `docker cp - <accessory>:/data`.
backup_from "${ACCESSORY}.rdb" \
  docker cp "${ACCESSORY}:/data/dump.rdb" -
{% elif method == 'file' %}
SOURCE_PATH={{ accessory_config.backup.source_path | default('/data') | quote }}
# The container to read from: the accessory itself, or for a volume backup
# (volume_backups in services.yml) the container that mounts the volume.
# docker cp reads through the daemon, so a volume needs no access to the
# Docker data root, wherever it is.
CONTAINER={{ backup_container | default(accessory_name) | quote }}
echo "[$(date -Iseconds)] Starting file backup for ${ACCESSORY}..."
backup_from "${ACCESSORY}.tar" \
  docker cp "${CONTAINER}:${SOURCE_PATH}" -
{% endif %}

# ── Error Checking ──────────────────────────────────────────────────────

# restic stores no snapshot for a failed dump. When restic names the dump
# command as the cause, the alert says so; a dump that wrote nothing has its
# own text (its empty snapshot is removed in backup_from); else the alert gives
# restic's exit code.
if [ "${RESTIC_EXIT:-0}" -ne 0 ]; then
  case "${EMPTY_DUMP:+empty}${DUMP_ERROR:-}" in
    empty*) ERROR_MSG="Dump produced no data, no snapshot stored (${FAILED_FILE})" ;;
    "exit status "*) ERROR_MSG="Dump command failed with exit code ${DUMP_ERROR#exit status }, no snapshot stored (${FAILED_FILE})" ;;
    ?*) ERROR_MSG="Dump command failed (${DUMP_ERROR}), no snapshot stored (${FAILED_FILE})" ;;
    *) ERROR_MSG="Restic backup failed with exit code ${RESTIC_EXIT} (${FAILED_FILE})" ;;
  esac
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.failed "<b>Backup failed</b>
Accessory: <code>${ACCESSORY}</code>
Host: <code>${BAY_HOST}</code>
Error: <code>$(bay_html_escape "${ERROR_MSG}")</code>"
  exit 1
fi

# ── Snapshot Verification ───────────────────────────────────────────────

# Verify snapshot size
echo "[$(date -Iseconds)] Verifying snapshot size..."
SNAP_SIZE=$("$RESTIC" stats latest --json --retry-lock 15m | jq '.total_size')
if [ "$SNAP_SIZE" -lt "$MIN_SNAPSHOT_SIZE" ]; then
  ERROR_MSG="Snapshot suspiciously small ($SNAP_SIZE bytes)"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.warning "<b>Backup warning</b>
Accessory: <code>${ACCESSORY}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>${ERROR_MSG}</code>"
  exit 1
fi

echo "[$(date -Iseconds)] Backup complete for ${ACCESSORY} ($SNAP_SIZE bytes)"

# ── Retention ─────────────────────────────────────────────────────────

echo "[$(date -Iseconds)] Running retention policy..."
{% if retain is mapping %}
"$RESTIC" forget \
{% if retain.daily is defined %}  --keep-daily {{ retain.daily | int }} \
{% endif %}
{% if retain.weekly is defined %}  --keep-weekly {{ retain.weekly | int }} \
{% endif %}
{% if retain.monthly is defined %}  --keep-monthly {{ retain.monthly | int }} \
{% endif %}
  --prune --retry-lock 15m 2>&1 || {
  echo "WARNING: retention prune failed (will retry next run)"
  bay_notify backup.prune_warning "<b>Prune warning</b>
Accessory: <code>${ACCESSORY}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>Retention prune failed</code>"
}
{% else %}
"$RESTIC" forget --keep-within {{ retain | int }}d --prune --retry-lock 15m 2>&1 || {
  echo "WARNING: retention prune failed (will retry next run)"
  bay_notify backup.prune_warning "<b>Prune warning</b>
Accessory: <code>${ACCESSORY}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>Retention prune failed</code>"
}
{% endif %}

echo "[$(date -Iseconds)] Retention complete for ${ACCESSORY}"
