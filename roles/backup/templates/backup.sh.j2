#!/usr/bin/env bash
# {{ ansible_managed }}
# Backup script for {{ accessory_name }} ({{ method }})
set -euo pipefail

# Restic environment (baked at template time)
export RESTIC_REPOSITORY="{{ repo }}"
export RESTIC_PASSWORD="{{ backup_restic_password }}"
export AWS_ACCESS_KEY_ID="{{ backup_s3_access_key_id }}"
export AWS_SECRET_ACCESS_KEY="{{ backup_s3_secret_access_key }}"
export RESTIC_CACHE_DIR="{{ backup_scripts_dir }}/cache/{{ accessory_name }}"

LOCK_FILE="{{ backup_lock_dir }}/{{ accessory_name }}.lock"
MIN_SNAPSHOT_SIZE=100
RESTIC="{{ backup_restic_bin }}"

# ── Telegram Alert ──────────────────────────────────────────────────────

BAY_ALERT_HEADER='{{ docker_monitor_alert_header }}'
BAY_ALERT_FOOTER='{{ docker_monitor_alert_footer }}'

{% include '_notify.sh.j2' %}

# ── Lock Management ─────────────────────────────────────────────────────

# Create lock (blocks deploys from restarting containers mid-backup)
mkdir -p "$(dirname "$LOCK_FILE")"
echo "$$" > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

# ── Prepare Cache ───────────────────────────────────────────────────────

mkdir -p "$RESTIC_CACHE_DIR"

# ── Backup ──────────────────────────────────────────────────────────────

{% if method == 'pg_dump' %}
{% set pg_user = accessory_config.env['clear'].POSTGRES_USER | default('app') %}
{% set _explicit_dbs = accessory_config.backup.databases | default([accessory_config.env['clear'].POSTGRES_DB | default('app')]) if accessory_config.backup is mapping else [accessory_config.env['clear'].POSTGRES_DB | default('app')] %}
{% set databases = (_explicit_dbs + (bound_databases | default([]))) | unique | list %}
{% for db in databases %}
echo "[$(date -Iseconds)] Starting pg_dump backup for {{ accessory_name }} (database: {{ db }})..."
set +e
docker exec {{ accessory_name }} \
  pg_dump -U {{ pg_user }} {{ db }} | \
  "$RESTIC" backup \
    --stdin \
    --stdin-filename "{{ accessory_name }}{% if databases | length > 1 %}-{{ db }}{% endif %}.sql" \
    --tag "{{ inventory_hostname }}" \
    --tag "{{ accessory_name }}" \
    --tag "{{ method }}" \
    ${RESTIC_TAG_EXTRA:+--tag "$RESTIC_TAG_EXTRA"} \
    --retry-lock 15m

_pipestatus=("${PIPESTATUS[@]}")
DUMP_EXIT=${_pipestatus[0]}
RESTIC_EXIT=${_pipestatus[1]}
set -e
{% endfor %}
{% elif method == 'mysql' %}
echo "[$(date -Iseconds)] Starting mysqldump backup for {{ accessory_name }}..."
set +e
docker exec \
  -e MYSQL_PWD="{{ accessory_config.env['clear'].MYSQL_ROOT_PASSWORD | default(accessory_config.env['clear'].MYSQL_PASSWORD | default('')) }}" \
  {{ accessory_name }} \
  mysqldump -u {{ accessory_config.env['clear'].MYSQL_USER | default('root') }} {{ accessory_config.env['clear'].MYSQL_DATABASE | default('app') }} | \
  "$RESTIC" backup \
    --stdin \
    --stdin-filename "{{ accessory_name }}.sql" \
    --tag "{{ inventory_hostname }}" \
    --tag "{{ accessory_name }}" \
    --tag "{{ method }}" \
    ${RESTIC_TAG_EXTRA:+--tag "$RESTIC_TAG_EXTRA"} \
    --retry-lock 15m

_pipestatus=("${PIPESTATUS[@]}")
DUMP_EXIT=${_pipestatus[0]}
RESTIC_EXIT=${_pipestatus[1]}
set -e
{% elif method == 'redis' %}
echo "[$(date -Iseconds)] Starting redis backup for {{ accessory_name }}..."

# Trigger BGSAVE and poll for completion
BEFORE=$(docker exec {{ accessory_name }} redis-cli LASTSAVE)
docker exec {{ accessory_name }} redis-cli BGSAVE > /dev/null

for i in $(seq 1 60); do
  AFTER=$(docker exec {{ accessory_name }} redis-cli LASTSAVE)
  if [ "$AFTER" != "$BEFORE" ]; then break; fi
  sleep 2
done

if [ "$AFTER" = "$BEFORE" ]; then
  ERROR_MSG="BGSAVE did not complete within 120 seconds"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.failed "<b>Backup failed</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Error: <code>${ERROR_MSG}</code>"
  exit 1
fi

# Copy RDB out and pipe to restic
set +e
docker cp {{ accessory_name }}:/data/dump.rdb - | \
  "$RESTIC" backup \
    --stdin \
    --stdin-filename "{{ accessory_name }}.rdb" \
    --tag "{{ inventory_hostname }}" \
    --tag "{{ accessory_name }}" \
    --tag "{{ method }}" \
    ${RESTIC_TAG_EXTRA:+--tag "$RESTIC_TAG_EXTRA"} \
    --retry-lock 15m

_pipestatus=("${PIPESTATUS[@]}")
DUMP_EXIT=${_pipestatus[0]}
RESTIC_EXIT=${_pipestatus[1]}
set -e
{% elif method == 'file' %}
echo "[$(date -Iseconds)] Starting file backup for {{ accessory_name }}..."
set +e
docker cp {{ accessory_name }}:{{ accessory_config.backup.source_path | default('/data') }} - | \
  "$RESTIC" backup \
    --stdin \
    --stdin-filename "{{ accessory_name }}.tar" \
    --tag "{{ inventory_hostname }}" \
    --tag "{{ accessory_name }}" \
    --tag "{{ method }}" \
    ${RESTIC_TAG_EXTRA:+--tag "$RESTIC_TAG_EXTRA"} \
    --retry-lock 15m

_pipestatus=("${PIPESTATUS[@]}")
DUMP_EXIT=${_pipestatus[0]}
RESTIC_EXIT=${_pipestatus[1]}
set -e
{% endif %}

# ── Error Checking ──────────────────────────────────────────────────────

# Check pipe status
if [ "${DUMP_EXIT:-0}" -ne 0 ]; then
  ERROR_MSG="Dump command failed with exit code $DUMP_EXIT"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.failed "<b>Backup failed</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Error: <code>${ERROR_MSG}</code>"
  exit 1
fi

if [ "${RESTIC_EXIT:-0}" -ne 0 ]; then
  ERROR_MSG="Restic backup failed with exit code $RESTIC_EXIT"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.failed "<b>Backup failed</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Error: <code>${ERROR_MSG}</code>"
  exit 1
fi

# ── Snapshot Verification ───────────────────────────────────────────────

# Verify snapshot size
echo "[$(date -Iseconds)] Verifying snapshot size..."
SNAP_SIZE=$("$RESTIC" stats latest --json --retry-lock 15m | jq '.total_size')
if [ "$SNAP_SIZE" -lt "$MIN_SNAPSHOT_SIZE" ]; then
  ERROR_MSG="Snapshot suspiciously small ($SNAP_SIZE bytes)"
  echo "ERROR: $ERROR_MSG"
  bay_notify backup.warning "<b>Backup warning</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>${ERROR_MSG}</code>"
  exit 1
fi

echo "[$(date -Iseconds)] Backup complete for {{ accessory_name }} ($SNAP_SIZE bytes)"

# ── Retention ─────────────────────────────────────────────────────────

echo "[$(date -Iseconds)] Running retention policy..."
{% if retain is mapping %}
"$RESTIC" forget \
{% if retain.daily is defined %}  --keep-daily {{ retain.daily }} \
{% endif %}
{% if retain.weekly is defined %}  --keep-weekly {{ retain.weekly }} \
{% endif %}
{% if retain.monthly is defined %}  --keep-monthly {{ retain.monthly }} \
{% endif %}
  --prune --retry-lock 15m 2>&1 || {
  echo "WARNING: retention prune failed (will retry next run)"
  bay_notify backup.prune_warning "<b>Prune warning</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>Retention prune failed</code>"
}
{% else %}
"$RESTIC" forget --keep-within {{ retain }}d --prune --retry-lock 15m 2>&1 || {
  echo "WARNING: retention prune failed (will retry next run)"
  bay_notify backup.prune_warning "<b>Prune warning</b>
Accessory: <code>{{ accessory_name }}</code>
Host: <code>${BAY_HOST}</code>
Warning: <code>Retention prune failed</code>"
}
{% endif %}

echo "[$(date -Iseconds)] Retention complete for {{ accessory_name }}"
