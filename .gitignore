# Vault password file
.vault_pass
.vault_pass.*

# Consumer group_vars symlink (created by bay:update)
/group_vars

# External Galaxy dependencies (install via requirements.yml)
vendor/roles/*/
vendor/collections/

# Retry files
*.retry

# Dep-sync marker (written by bay self update)
.deps-synced

# Rig-state cache (written by deploy auto-rig detection)
.rig-state-cache
.bay-cache/

# Network probe cache (written by validate's git/image reachability checks)
.validate-probe-cache

# Reconciler report fallback (a playbook run by hand without
# bay_reconciler_report_dir; the CLI always uses a temp dir)
.reconcile-report/

# Implementation tracker — lives in the workspace repo, never in the framework
.tracker/

# Python / uv
.venv/
__pycache__/
*.egg-info/
.coverage
.pytest_cache/

# OS files
.DS_Store

# Type/lint caches
.mypy_cache/
.ruff_cache/
.ansible/
